class AppException extends Exception {
    public int code;

    public AppException(String msg, int code) {
        super(msg);
        this.code = code;
    }
}

class Helper {
    public static void boom(boolean custom) {
        if (custom) {
            throw new AppException("custom failure", 404);
        }
        throw new Exception("generic failure");
    }

    public static int tryReturnWithFinally(int[] log) {
        try {
            log[0] = 1;
            return 77;
        } finally {
            log[0] = log[0] + 10;
        }
    }
}

class Main {
    public static int main() {
        // 1. Basic try/catch/finally
        int finCount = 0;
        try {
            Helper.boom(false);
            Console.eprintln("unreachable after throw");
            return 1;
        } catch (Exception e) {
            if (!e.getMessage().equals("generic failure")) {
                Console.eprintln("wrong message: " + e.getMessage());
                return 1;
            }
        } finally {
            finCount = finCount + 1;
        }
        if (finCount != 1) {
            Console.eprintln("finally not executed");
            return 1;
        }

        // 2. Subclass exception & multi-catch
        int caughtCode = 0;
        try {
            Helper.boom(true);
        } catch (AppException ae) {
            caughtCode = ae.code;
        } catch (Exception e) {
            Console.eprintln("should have caught AppException");
            return 1;
        }
        if (caughtCode != 404) {
            Console.eprintln("wrong AppException code");
            return 1;
        }

        // 3. Nested try/finally propagation
        int outerFin = 0;
        try {
            try {
                Helper.boom(true);
            } finally {
                outerFin = outerFin + 1;
            }
        } catch (Exception e) {
            outerFin = outerFin + 10;
        }
        if (outerFin != 11) {
            Console.eprintln("nested finally/catch failed: " + outerFin);
            return 1;
        }

        // 4. return inside try with finally
        int[] log = new int[1];
        int retVal = Helper.tryReturnWithFinally(log);
        if (retVal != 77 || log[0] != 11) {
            Console.eprintln("return with finally failed");
            return 1;
        }

        // 5. String.toInt / toLong / toDouble / toFloat (valid)
        if ("-42".toInt() != -42) {
            Console.eprintln("toInt failed");
            return 1;
        }
        if ("9000000000".toLong() != 9000000000L) {
            Console.eprintln("toLong failed");
            return 1;
        }
        double d = "3.5".toDouble();
        if (d < 3.49 || d > 3.51) {
            Console.eprintln("toDouble failed");
            return 1;
        }
        float f = "1.25".toFloat();
        if (f < 1.24f || f > 1.26f) {
            Console.eprintln("toFloat failed");
            return 1;
        }

        // 6. String.toInt invalid throws Exception
        boolean badCaught = false;
        try {
            int bad = "12abc".toInt();
            Console.println("bad=" + bad);
        } catch (Exception e) {
            badCaught = true;
        }
        if (!badCaught) {
            Console.eprintln("invalid toInt did not throw");
            return 1;
        }

        Console.println("All Stage 1 Phase C tests passed!");
        return 0;
    }
}
