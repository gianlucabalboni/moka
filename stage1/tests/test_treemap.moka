import std/Comparable;
import std/Comparator;
import std/datastructures/ArrayList;
import std/datastructures/Collections;
import std/datastructures/Iterator;
import std/datastructures/Map;
import std/datastructures/TreeMap;
import std/datastructures/TreeSet;

class ScoreKey implements Comparable<ScoreKey> {
    public int score;
    public ScoreKey(int score) { this.score = score; }
    public int compareTo(ScoreKey other) {
        if (this.score < other.score) return -1;
        if (this.score > other.score) return 1;
        return 0;
    }
    public String toString() { return "S(" + this.score + ")"; }
}

class NaiveTreeRef {
    private int[] keys;
    private int[] vals;
    private int count;

    public NaiveTreeRef(int maxCap) {
        this.keys = new int[maxCap];
        this.vals = new int[maxCap];
        this.count = 0;
    }

    public int size() { return this.count; }

    private int find(int k) {
        for (int i = 0; i < this.count; i++) {
            if (this.keys[i] == k) return i;
        }
        return -1;
    }

    public boolean containsKey(int k) { return this.find(k) >= 0; }

    public int getOrDefault(int k, int defVal) {
        int idx = this.find(k);
        if (idx < 0) return defVal;
        return this.vals[idx];
    }

    public int put(int k, int v) {
        int idx = this.find(k);
        if (idx >= 0) {
            int old = this.vals[idx];
            this.vals[idx] = v;
            return old;
        }
        this.keys[this.count] = k;
        this.vals[this.count] = v;
        this.count = this.count + 1;
        return 0;
    }

    public int remove(int k) {
        int idx = this.find(k);
        int old = this.vals[idx];
        this.keys[idx] = this.keys[this.count - 1];
        this.vals[idx] = this.vals[this.count - 1];
        this.count = this.count - 1;
        return old;
    }
}

class Main {
    public static int main() {
        // 1. TreeMap<String, int> ordering & navigable ops
        TreeMap<String, int> tm = new TreeMap<>(new NaturalOrder<String>());
        tm.put("charlie", 3);
        tm.put("alpha", 1);
        tm.put("echo", 5);
        tm.put("bravo", 2);
        tm.put("delta", 4);
        if (!tm.toString().equals("{alpha=1, bravo=2, charlie=3, delta=4, echo=5}")) {
            Console.eprintln("TreeMap<String, int> in-order failed: " + tm.toString());
            return 1;
        }
        if (!tm.firstKey().equals("alpha") || !tm.lastKey().equals("echo") ||
            !tm.floorKey("c").equals("bravo") || !tm.ceilingKey("c").equals("charlie") ||
            !tm.lowerKey("charlie").equals("bravo") || !tm.higherKey("charlie").equals("delta")) {
            Console.eprintln("TreeMap navigable ops failed");
            return 1;
        }

        // Exceptions on missing/empty
        boolean nse = false;
        try { tm.lowerKey("alpha"); } catch (NoSuchElementException e) { nse = true; }
        if (!nse) { Console.eprintln("lowerKey(first) did not throw"); return 1; }

        nse = false;
        try { tm.get("missing"); } catch (NoSuchElementException e) { nse = true; }
        if (!nse) { Console.eprintln("TreeMap.get(missing) did not throw"); return 1; }

        // 2. Iterator in-order + remove() + fail-fast
        Iterator<String> it = tm.keySet().iterator();
        while (it.hasNext()) {
            String k = it.next();
            if (k.equals("bravo") || k.equals("charlie")) {
                it.remove();
            }
        }
        if (tm.size() != 3 || tm.containsKey("bravo") || tm.containsKey("charlie")) {
            Console.eprintln("TreeMap iterator.remove failed");
            return 1;
        }

        Iterator<String> ff = tm.keySet().iterator();
        tm.put("foxtrot", 6);
        boolean cme = false;
        try { ff.next(); } catch (ConcurrentModificationException e) { cme = true; }
        if (!cme) { Console.eprintln("TreeMap fail-fast failed"); return 1; }

        // 3. User-defined Comparable key + TreeSet<int>
        TreeMap<ScoreKey, String> sm = new TreeMap<>(new NaturalOrder<ScoreKey>());
        sm.put(new ScoreKey(20), "twenty");
        sm.put(new ScoreKey(10), "ten");
        if (sm.firstKey().score != 10 || sm.lastKey().score != 20) {
            Console.eprintln("TreeMap<ScoreKey, String> failed");
            return 1;
        }

        TreeSet<int> ts = new TreeSet<>(new IntComparator());
        ts.add(30);
        ts.add(10);
        ts.add(20);
        ts.add(10);
        if (ts.size() != 3 || !ts.toString().equals("[10, 20, 30]") ||
            ts.floor(25) != 20 || ts.ceiling(15) != 20) {
            Console.eprintln("TreeSet<int> failed: " + ts.toString());
            return 1;
        }

        // 4. Collections utility algorithms
        ArrayList<int> arr = new ArrayList<>();
        arr.add(5);
        arr.add(1);
        arr.add(4);
        arr.add(2);
        arr.add(3);
        Collections.sort(arr, new IntComparator());
        if (Collections.binarySearch(arr, 4, new IntComparator()) != 3 ||
            Collections.min(arr, new IntComparator()) != 1 ||
            Collections.max(arr, new IntComparator()) != 5) {
            Console.eprintln("Collections sort/binarySearch/min/max failed");
            return 1;
        }
        Collections.reverse(arr);
        if (!arr.toString().equals("[5, 4, 3, 2, 1]")) {
            Console.eprintln("Collections.reverse failed");
            return 1;
        }

        // 5. Differential test: 10,000 random operations against NaiveTreeRef (fixed seed)
        TreeMap<int, int> fast = new TreeMap<>(new IntComparator());
        NaiveTreeRef naive = new NaiveTreeRef(512);
        long seed = 42424242L;
        for (int step = 0; step < 10000; step++) {
            seed = (seed * 6364136223846793005L + 1442695040888963407L) & 2147483647L;
            int op = (int) (seed % 10L);
            int key = (int) ((seed / 10L) % 300L);
            int val = (int) (seed % 10000L);
            if (op < 5) {
                if (fast.put(key, val) != naive.put(key, val)) {
                    Console.eprintln("TreeMap diff put mismatch at " + step);
                    return 1;
                }
            } else if (op < 8) {
                if (fast.containsKey(key) != naive.containsKey(key) ||
                    fast.getOrDefault(key, -999) != naive.getOrDefault(key, -999)) {
                    Console.eprintln("TreeMap diff get mismatch at " + step);
                    return 1;
                }
            } else {
                if (naive.containsKey(key)) {
                    if (fast.remove(key) != naive.remove(key)) {
                        Console.eprintln("TreeMap diff remove mismatch at " + step);
                        return 1;
                    }
                }
            }
            if (fast.size() != naive.size()) {
                Console.eprintln("TreeMap diff size mismatch at " + step);
                return 1;
            }
        }
        // Verify in-order traversal is strictly increasing after 10,000 random mutations
        Iterator<int> kit = fast.keySet().iterator();
        int prevKey = -1;
        int seen = 0;
        while (kit.hasNext()) {
            int k = kit.next();
            if (k <= prevKey) {
                Console.eprintln("TreeMap order violated after 10k ops");
                return 1;
            }
            prevKey = k;
            seen = seen + 1;
        }
        if (seen != fast.size()) {
            Console.eprintln("TreeMap iterator count mismatch");
            return 1;
        }

        Console.println("All Stage 1 TreeMap, TreeSet & Collections tests passed!");
        return 0;
    }
}
