interface Container<T> {
    T get();
    void set(T val);
}

class Box<T> implements Container<T> {
    private T value;

    public Box(T value) {
        this.value = value;
    }

    public T get() {
        return this.value;
    }

    public void set(T val) {
        this.value = val;
    }
}

class Pair<K, V> {
    public K first;
    public V second;

    public Pair(K first, V second) {
        this.first = first;
        this.second = second;
    }
}

class IntBox implements Container<int> {
    private int x;

    public IntBox(int x) {
        this.x = x;
    }

    public int get() {
        return this.x;
    }

    public void set(int val) {
        this.x = val;
    }
}

class Util {
    // Simplified Moka-style generic method
    public static T identity<T>(T x) {
        return x;
    }

    // Java-style generic method
    public static <T> T pickFirst(T a, T b) {
        return a;
    }
}

class Main {
    public static int main() {
        // 1. Explicit, diamond <>, and inferred generic instantiation with primitives & objects
        Box<int> bi = new Box<int>(42);
        Box<String> bs = new Box<>("Moka");
        Box<double> bd = new Box(3.5);

        if (bi.get() != 42 || !bs.get().equals("Moka") || bd.get() < 3.4 || bd.get() > 3.6) {
            Console.eprintln("Box<T> failed");
            return 1;
        }
        bi.set(100);
        if (bi.get() != 100) {
            Console.eprintln("Box.set failed");
            return 1;
        }

        // 2. Nested generics with '>>' and multiple type parameters
        Box<Pair<String, int>> nested = new Box<>(new Pair<String, int>("age", 25));
        if (!nested.get().first.equals("age") || nested.get().second != 25) {
            Console.eprintln("Nested Pair/Box failed");
            return 1;
        }

        // 3. Generic interface dispatch
        Container<int> c1 = new Box<int>(10);
        Container<int> c2 = new IntBox(20);
        c1.set(c1.get() + c2.get());
        if (c1.get() != 30) {
            Console.eprintln("Container<int> dispatch failed");
            return 1;
        }

        // 4. Generic methods (inferred & explicit, simplified & Java-style)
        int idInt = Util.identity(99);
        String idStr = Util.identity<String>("ok");
        char ch = Util.pickFirst('Z', 'A');
        if (idInt != 99 || !idStr.equals("ok") || ch != 'Z') {
            Console.eprintln("Generic methods failed");
            return 1;
        }

        Console.println("All Stage 1 Phase D (Generics) tests passed!");
        return 0;
    }
}
