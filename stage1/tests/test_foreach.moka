import std/Comparator;
import std/datastructures/ArrayList;
import std/datastructures/HashMap;
import std/datastructures/Hasher;
import std/datastructures/LinkedList;
import std/datastructures/List;
import std/datastructures/MapEntry;
import std/datastructures/Set;
import std/datastructures/TreeSet;

class Main {
    public static int main() {
        // 1. for-each over ArrayList<int>
        ArrayList<int> nums = new ArrayList<>();
        nums.add(10);
        nums.add(20);
        nums.add(30);
        nums.add(40);
        int sum = 0;
        for (int x : nums) {
            if (x == 20) continue;
            if (x == 40) break;
            sum = sum + x;
        }
        if (sum != 40) {
            Console.eprintln("for-each ArrayList<int> failed: " + sum);
            return 1;
        }

        // 2. for-each over List<String> and TreeSet<String>
        List<String> words = new LinkedList<>();
        words.add("alpha");
        words.add("beta");
        words.add("gamma");
        String joined = "";
        for (String w : words) {
            joined = joined + w;
        }
        if (!joined.equals("alphabetagamma")) {
            Console.eprintln("for-each LinkedList<String> failed: " + joined);
            return 1;
        }

        Set<int> ts = new TreeSet<>(new IntComparator());
        ts.add(3);
        ts.add(1);
        ts.add(2);
        int tsOrder = 0;
        for (int v : ts) {
            tsOrder = tsOrder * 10 + v;
        }
        if (tsOrder != 123) {
            Console.eprintln("for-each TreeSet<int> failed: " + tsOrder);
            return 1;
        }

        // 3. for-each over Map.entrySet()
        HashMap<String, int> map = new HashMap<>(new StringHasher());
        map.put("a", 1);
        map.put("b", 2);
        int mapSum = 0;
        for (MapEntry<String, int> e : map.entrySet()) {
            mapSum = mapSum + e.getValue();
        }
        if (mapSum != 3) {
            Console.eprintln("for-each entrySet failed: " + mapSum);
            return 1;
        }

        // 4. for-each over native arrays (int[] and String[])
        int[] arr = new int[4];
        arr[0] = 2; arr[1] = 4; arr[2] = 6; arr[3] = 8;
        int arrSum = 0;
        for (final int a : arr) {
            arrSum = arrSum + a;
        }
        if (arrSum != 20) {
            Console.eprintln("for-each int[] failed: " + arrSum);
            return 1;
        }

        // 5. Fail-fast ConcurrentModificationException inside for-each
        boolean cme = false;
        try {
            for (int x : nums) {
                if (x == 10) {
                    nums.add(99);
                }
            }
        } catch (ConcurrentModificationException e) {
            cme = true;
        }
        if (!cme) {
            Console.eprintln("for-each fail-fast CME did not throw");
            return 1;
        }

        Console.println("All Stage 1 for-each tests passed!");
        return 0;
    }
}
