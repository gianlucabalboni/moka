import std/Comparable;
import std/Comparator;
import std/datastructures/Iterator;
import std/datastructures/PriorityQueue;
import std/datastructures/Queue;

class Job implements Comparable<Job> {
    public int cost;
    public String id;
    public Job(int cost, String id) { this.cost = cost; this.id = id; }
    public int compareTo(Job other) {
        if (this.cost < other.cost) return -1;
        if (this.cost > other.cost) return 1;
        return 0;
    }
}

class NaiveIntPQ {
    private int[] items;
    private int count;

    public NaiveIntPQ(int maxCap) {
        this.items = new int[maxCap];
        this.count = 0;
    }

    public int size() { return this.count; }

    public void offer(int v) {
        this.items[this.count] = v;
        this.count = this.count + 1;
    }

    private int minIdx() {
        int best = 0;
        for (int i = 1; i < this.count; i++) {
            if (this.items[i] < this.items[best]) best = i;
        }
        return best;
    }

    public int peek() {
        return this.items[this.minIdx()];
    }

    public int poll() {
        int idx = this.minIdx();
        int val = this.items[idx];
        this.items[idx] = this.items[this.count - 1];
        this.count = this.count - 1;
        return val;
    }
}

class Main {
    public static int main() {
        // 1. Empty PriorityQueue exceptions vs special values
        PriorityQueue<int> pq = new PriorityQueue<>(new IntComparator());
        if (!pq.isEmpty() || pq.poll() != 0 || pq.peek() != 0) {
            Console.eprintln("Empty PriorityQueue special values failed");
            return 1;
        }
        boolean nse = false;
        try { pq.remove(); } catch (NoSuchElementException e) { nse = true; }
        if (!nse) { Console.eprintln("PriorityQueue.remove on empty did not throw"); return 1; }

        nse = false;
        try { pq.element(); } catch (NoSuchElementException e) { nse = true; }
        if (!nse) { Console.eprintln("PriorityQueue.element on empty did not throw"); return 1; }

        // 2. PriorityQueue<String> with NaturalOrder<String>
        Queue<String> spq = new PriorityQueue<>(new NaturalOrder<String>());
        spq.offer("delta");
        spq.offer("alpha");
        spq.offer("charlie");
        spq.offer("bravo");
        if (!spq.poll().equals("alpha") || !spq.poll().equals("bravo") ||
            !spq.poll().equals("charlie") || !spq.poll().equals("delta") || !spq.isEmpty()) {
            Console.eprintln("PriorityQueue<String> ordering failed");
            return 1;
        }

        // 3. User-defined Comparable<Job> + fail-fast iterator
        PriorityQueue<Job> jpq = new PriorityQueue<>(new NaturalOrder<Job>());
        jpq.offer(new Job(30, "low"));
        jpq.offer(new Job(5, "high"));
        jpq.offer(new Job(15, "mid"));
        Iterator<Job> jit = jpq.iterator();
        jpq.offer(new Job(1, "urgent"));
        boolean cme = false;
        try { jit.next(); } catch (ConcurrentModificationException e) { cme = true; }
        if (!cme) { Console.eprintln("PriorityQueue fail-fast CME did not throw"); return 1; }
        if (!jpq.poll().id.equals("urgent") || !jpq.poll().id.equals("high")) {
            Console.eprintln("PriorityQueue<Job> ordering failed");
            return 1;
        }

        // 4. Differential test: 10,000 random operations against NaiveIntPQ
        PriorityQueue<int> fast = new PriorityQueue<>(new IntComparator());
        NaiveIntPQ naive = new NaiveIntPQ(10000);
        long seed = 987654321L;
        for (int step = 0; step < 10000; step++) {
            seed = (seed * 6364136223846793005L + 1442695040888963407L) & 2147483647L;
            int op = (int) (seed % 10L);
            if (op < 6 || naive.size() == 0) {
                int val = (int) (seed % 10000L);
                fast.offer(val);
                naive.offer(val);
            } else if (op < 8) {
                if (fast.peek() != naive.peek()) {
                    Console.eprintln("PQ diff peek mismatch at step " + step);
                    return 1;
                }
            } else {
                if (fast.poll() != naive.poll()) {
                    Console.eprintln("PQ diff poll mismatch at step " + step);
                    return 1;
                }
            }
            if (fast.size() != naive.size()) {
                Console.eprintln("PQ diff size mismatch at step " + step);
                return 1;
            }
        }

        Console.println("All Stage 1 PriorityQueue tests passed!");
        return 0;
    }
}
