class Counter {
    public static int count;
    public static String label;

    public Counter() {
        Counter.count++;
    }
}

class Main {
    static native void rt_gc_collect();

    public static int main() {
        Counter.label = "shared_".concat(String.fromInt(99));

        for (int i = 0; i < 500; i++) {
            Counter c = new Counter();
            String junk = "junk_".concat(String.fromInt(i));
        }
        Main.rt_gc_collect();

        if (Counter.count != 500) {
            Console.eprintln("Static int count failed: ".concat(String.fromInt(Counter.count)));
            return 1;
        }
        if (!Counter.label.equals("shared_99")) {
            Console.eprintln("Static String root failed");
            return 1;
        }

        Console.println("Static count = ".concat(String.fromInt(Counter.count)));
        Console.println("All Stage 1 static field tests passed!");
        return 0;
    }
}
