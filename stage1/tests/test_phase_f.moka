import std/Math;
import std/datastructures/List;
import std/datastructures/ArrayList;
import std/datastructures/Stack;
import std/datastructures/Queue;
import std/datastructures/Map;
import std/datastructures/StringMap;

class Main {
    public static int main() {
        // 1. static class Math
        if (Math.abs(-15) != 15 || Math.max(10, 25) != 25 || Math.min(10, 25) != 10) {
            Console.eprintln("Math int ops failed");
            return 1;
        }
        double r = Math.sqrt(16.0) + Math.pow(2.0, 3.0);
        if (r < 11.99 || r > 12.01) {
            Console.eprintln("Math sqrt/pow failed: " + r);
            return 1;
        }
        if (Math.PI < 3.14 || Math.PI > 3.15) {
            Console.eprintln("Math.PI failed");
            return 1;
        }

        // 2. List<T> & ArrayList<T>
        List<int> nums = new ArrayList<>();
        for (int i = 0; i < 12; i++) {
            nums.add(i * 10);
        }
        if (nums.size() != 12 || nums.get(5) != 50) {
            Console.eprintln("ArrayList<int> failed");
            return 1;
        }
        nums.set(5, 55);
        int removed = nums.removeAt(0);
        if (removed != 0 || nums.size() != 11 || nums.get(4) != 55) {
            Console.eprintln("ArrayList removeAt/set failed");
            return 1;
        }

        // 3. Stack<T>
        Stack<int> st = new Stack<>();
        st.push(1);
        st.push(2);
        st.push(3);
        if (st.peek() != 3 || st.pop() != 3 || st.pop() != 2 || st.pop() != 1 || !st.isEmpty()) {
            Console.eprintln("Stack<int> failed");
            return 1;
        }
        boolean stackThrew = false;
        try {
            st.pop();
        } catch (Exception e) {
            stackThrew = true;
        }
        if (!stackThrew) {
            Console.eprintln("Stack empty pop did not throw");
            return 1;
        }

        // 4. Queue<T> (circular wraparound)
        Queue<String> q = new Queue<>();
        for (int i = 0; i < 12; i++) {
            q.enqueue("item_" + i);
            if (i % 2 == 1) {
                q.dequeue();
            }
        }
        if (q.size() != 6 || !q.peek().equals("item_6")) {
            Console.eprintln("Queue<String> failed: " + q.peek());
            return 1;
        }

        // 5. Map<K, V> and StringMap<V>
        Map<int, String> idMap = new Map<>();
        idMap.put(1, "one");
        idMap.put(2, "two");
        idMap.put(1, "ONE");
        if (idMap.size() != 2 || !idMap.get(1).equals("ONE") || !idMap.containsKey(2)) {
            Console.eprintln("Map<int, String> failed");
            return 1;
        }
        idMap.remove(2);
        if (idMap.containsKey(2) || idMap.size() != 1) {
            Console.eprintln("Map.remove failed");
            return 1;
        }

        StringMap<int> scores = new StringMap<>();
        scores.put("Alice", 95);
        scores.put("Bob", 88);
        if (scores.get("Alice") != 95 || scores.get("Bob") != 88) {
            Console.eprintln("StringMap<int> failed");
            return 1;
        }

        Console.println("All Stage 1 Phase F (Math & Data Structures) tests passed!");
        return 0;
    }
}
