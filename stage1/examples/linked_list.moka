class Node {
    public int value;
    public Node next;

    public Node(int value, Node next) {
        this.value = value;
        this.next = next;
    }
}

class Main {
    public static int main() {
        Node head = null;
        int i = 1;
        while (i <= 5) {
            head = new Node(i * 10, head);
            i = i + 1;
        }

        int sum = 0;
        Node cur = head;
        while (cur != null) {
            Console.print("Node: ");
            Console.printInt(cur.value);
            sum = sum + cur.value;
            cur = cur.next;
        }

        Console.println("Total sum = ".concat(String.fromInt(sum)));
        return 0;
    }
}
