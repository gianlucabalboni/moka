    public void add(Stmt item) {
        if (this.count >= this.items.length) {
            Stmt[] next = new Stmt[this.items.length * 2];
            int i = 0;
            while (i < this.count) {
                next[i] = this.items[i];
                i = i + 1;
            }
            this.items = next;
