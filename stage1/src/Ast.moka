public class MethodDecl {
    public String name;
    public Type returnType;
    public boolean isConstructor;
    public boolean isStatic;
    public boolean isNative;
    public ParamList params;
    public Stmt body;
    public ClassDecl owner;
    public int vtableIndex;
    public boolean hasSuperCall;
    public int line;
    public int col;

    public MethodDecl(String name, Type returnType, boolean isConstructor,
                      boolean isStatic, boolean isNative, int line, int col) {
        this.name = name;
        this.returnType = returnType;
        this.isConstructor = isConstructor;
        this.isStatic = isStatic;
        this.isNative = isNative;
        this.params = new ParamList();
        this.vtableIndex = -1;
        this.hasSuperCall = false;
        this.line = line;
        this.col = col;
    }
}

public class MethodList {
    private MethodDecl[] items;
    private int count;

    public MethodList() {
        this.items = new MethodDecl[8];
        this.count = 0;
    }

    public int size() {
        return this.count;
    }

    public MethodDecl get(int i) {
        return this.items[i];
    }

    public void set(int i, MethodDecl item) {
        this.items[i] = item;
    }

    public void add(MethodDecl item) {
        if (this.count >= this.items.length) {
            MethodDecl[] next = new MethodDecl[this.items.length * 2];
            int i = 0;
            while (i < this.count) {
                next[i] = this.items[i];
                i = i + 1;
            }
            this.items = next;
        }
        this.items[this.count] = item;
        this.count = this.count + 1;
    }
}

public class ClassDecl {
    public String name;
    public boolean isInterface;
    public String superName;
    public ClassDecl superClass;
    public String[] implNames;
    public int implCount;
    public ClassList impls;
    public FieldList fields;
    public MethodDecl constructor;
    public MethodList methods;
    public MethodList vtable;
    public int line;
    public int col;

    public ClassDecl(String name, int line, int col) {
        this.name = name;
        this.isInterface = false;
        this.implNames = new String[8];
        this.implCount = 0;
        this.impls = new ClassList();
        this.fields = new FieldList();
        this.methods = new MethodList();
        this.vtable = new MethodList();
        this.line = line;
        this.col = col;
    }

    public void addImplName(String name) {
        if (this.implCount >= this.implNames.length) {
            String[] next = new String[this.implNames.length * 2];
            int i = 0;
            while (i < this.implCount) {
                next[i] = this.implNames[i];
                i = i + 1;
            }
            this.implNames = next;
        }
        this.implNames[this.implCount] = name;
        this.implCount = this.implCount + 1;
    }
}

public class ClassList {
    private ClassDecl[] items;
    private int count;

    public ClassList() {
        this.items = new ClassDecl[8];
        this.count = 0;
    }

    public int size() {
        return this.count;
    }

    public ClassDecl get(int i) {
        return this.items[i];
    }

    public void add(ClassDecl item) {
        if (this.count >= this.items.length) {
            ClassDecl[] next = new ClassDecl[this.items.length * 2];
            int i = 0;
            while (i < this.count) {
                next[i] = this.items[i];
                i = i + 1;
            }
            this.items = next;
        }
        this.items[this.count] = item;
        this.count = this.count + 1;
    }
}

public class Program {
    public ClassList classes;

    public Program() {
        this.classes = new ClassList();
    }
}
