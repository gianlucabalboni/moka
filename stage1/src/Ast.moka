public class FieldDecl {
    public Type type;
    public String name;
    public boolean isStatic;
    public int line;
    public int col;

    public FieldDecl(Type type, String name, boolean isStatic, int line, int col) {
        this.type = type;
        this.name = name;
        this.isStatic = isStatic;
        this.line = line;
        this.col = col;
    }
}

public class FieldList {
    private FieldDecl[] items;
    private int count;

    public FieldList() {
        this.items = new FieldDecl[8];
        this.count = 0;
    }

    public int size() {
        return this.count;
    }

    public FieldDecl get(int i) {
        return this.items[i];
    }

    public void add(FieldDecl item) {
        if (this.count >= this.items.length) {
            FieldDecl[] next = new FieldDecl[this.items.length * 2];
            int i = 0;
            while (i < this.count) {
                next[i] = this.items[i];
