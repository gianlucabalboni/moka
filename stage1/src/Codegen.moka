/**
 * Codegen.moka — C11 code generator for Stage 1 Moka.
 *
 * Emits standalone C11 code targeting runtime/runtime.h:
 * 1. Interface types (emitInterfaceTypes): two-pass emission so fat-pointer
 *    structs (`{ void* obj; const Iface_VTable* vtable; }`) are complete types
 *    before any VTable struct or inline dispatch helper references them.
 * 2. Class structs, RtTypeInfo GC descriptors (ptr_offsets), VTables, and
 *    per-interface VTables (recursively covering superinterfaces).
 * 3. Method bodies with cooperative Stop-the-World GC shadow stack frames
 *    (RtShadowFrame slots + safepoints on loop iterations) and setjmp/longjmp
 *    exception/finally/synchronized unwinding.
 */
public class Codegen {
    private Program prog;
    private ByteBuffer out;
    private int indent;
    private MethodDecl currentMethod;

    /* GC Shadow Stack tracking per method */
    private int gcTotalSlots;
    private int gcNextSlot;
    private int[] blockStartSlot;
    private int blockDepth;
    private int[] loopSlotStart;
    private int loopDepth;
    private int[] breakSlotStart;
    private int breakDepth;

    /* Exception frame tracking per method */
    private int excCounter;
    private int excDepth;
    private String[] excFrameNames;
    private Stmt[] excFinallyBlocks;
    private String[] excSyncObjs;
    private boolean methodHasTry;

    public Codegen(Program prog) {
        this.prog = prog;
        this.out = new ByteBuffer(8192);
        this.indent = 0;
        this.gcTotalSlots = 0;
        this.gcNextSlot = 0;
        this.blockStartSlot = new int[64];
        this.blockDepth = 0;
        this.loopSlotStart = new int[64];
        this.loopDepth = 0;
        this.breakSlotStart = new int[64];
        this.breakDepth = 0;
        this.excCounter = 0;
        this.excDepth = 0;
        this.excFrameNames = new String[64];
        this.excFinallyBlocks = new Stmt[64];
        this.excSyncObjs = new String[64];
        this.methodHasTry = false;
    }

    private boolean hasTryStmt(Stmt st) {
        if (st == null) {
            return false;
        }
        int k = st.kind;
        if (k == StmtKind.TRY() || k == StmtKind.SYNCHRONIZED()) {
            return true;
        }
        if (k == StmtKind.BLOCK()) {
            int i = 0;
            while (i < st.stmts.size()) {
                if (this.hasTryStmt(st.stmts.get(i))) return true;
                i = i + 1;
            }
            return false;
        }
        if (k == StmtKind.IF()) {
            return this.hasTryStmt(st.thenBranch) || this.hasTryStmt(st.elseBranch);
        }
        if (k == StmtKind.WHILE() || k == StmtKind.FOR()) {
            return this.hasTryStmt(st.thenBranch);
        }
        if (k == StmtKind.SWITCH()) {
            int i = 0;
            while (i < st.stmts.size()) {
                Stmt c = st.stmts.get(i);
                int j = 0;
                while (j < c.stmts.size()) {
                    if (this.hasTryStmt(c.stmts.get(j))) return true;
                    j = j + 1;
                }
                i = i + 1;
            }
            return false;
        }
        return false;
    }

    private boolean isRefType(Type ty) {
        return ty != null && (ty.kind == TypeKind.CLASS() || ty.kind == TypeKind.ARRAY());
    }

    private int countRefVars(Stmt st) {
        if (st == null) {
            return 0;
        }
        int k = st.kind;
        if (k == StmtKind.VAR_DECL()) {
            if (this.isRefType(st.varType)) {
                return 1;
            }
            return 0;
        }
        if (k == StmtKind.BLOCK()) {
            int total = 0;
            int i = 0;
            while (i < st.stmts.size()) {
                total = total + this.countRefVars(st.stmts.get(i));
                i = i + 1;
            }
            return total;
        }
        if (k == StmtKind.IF()) {
            return this.countRefVars(st.thenBranch) + this.countRefVars(st.elseBranch);
        }
        if (k == StmtKind.WHILE()) {
            return this.countRefVars(st.thenBranch);
        }
        if (k == StmtKind.FOR()) {
            return this.countRefVars(st.initStmt) + this.countRefVars(st.thenBranch);
        }
        if (k == StmtKind.SWITCH()) {
            int total = 0;
            int i = 0;
            while (i < st.stmts.size()) {
                Stmt c = st.stmts.get(i);
                int j = 0;
                while (j < c.stmts.size()) {
                    total = total + this.countRefVars(c.stmts.get(j));
                    j = j + 1;
                }
                i = i + 1;
            }
            return total;
        }
        if (k == StmtKind.TRY()) {
            int total = this.countRefVars(st.thenBranch) + this.countRefVars(st.elseBranch);
            int i = 0;
            while (i < st.stmts.size()) {
                Stmt c = st.stmts.get(i);
                total = total + 1 + this.countRefVars(c.thenBranch);
                i = i + 1;
            }
            return total;
        }
        if (k == StmtKind.SYNCHRONIZED()) {
            return this.countRefVars(st.thenBranch);
        }
        return 0;
    }

    private void emitExcUnwind() {
        int i = this.excDepth - 1;
        while (i >= 0) {
            this.emitIndent();
            this.out.appendString("rt_exc_top = ");
            this.out.appendString(this.excFrameNames[i]);
            this.out.appendString(".prev;\n");
            if (this.excSyncObjs[i] != null) {
                this.emitIndent();
                this.out.appendString("rt_monitor_exit(");
                this.out.appendString(this.excSyncObjs[i]);
                this.out.appendString(");\n");
            }
            if (this.excFinallyBlocks[i] != null) {
                int savedDepth = this.excDepth;
                this.excDepth = i;
                this.emitStmt(this.excFinallyBlocks[i]);
                this.excDepth = savedDepth;
            }
            i = i - 1;
        }
    }

    private void emitClearSlots(int fromSlot, int toSlot) {
        int i = fromSlot;
        while (i < toSlot) {
            this.emitIndent();
            this.out.appendString("_gc_slots[");
            this.out.appendInt(i);
            this.out.appendString("] = NULL;\n");
            i = i + 1;
        }
    }

    private void emitIndent() {
        int i = 0;
        while (i < this.indent) {
            this.out.appendString("    ");
            i = i + 1;
        }
    }

    private boolean isInterfaceType(Type ty) {
        return ty != null && ty.kind == TypeKind.CLASS() &&
               ty.resolvedClass != null && ty.resolvedClass.isInterface;
    }

    private void emitCType(Type ty) {
        if (ty == null) {
            this.out.appendString("void");
            return;
        }
        int k = ty.kind;
        if (k == TypeKind.VOID())    { this.out.appendString("void"); return; }
        if (k == TypeKind.INT())     { this.out.appendString("int32_t"); return; }
        if (k == TypeKind.BYTE())    { this.out.appendString("uint8_t"); return; }
        if (k == TypeKind.CHAR())    { this.out.appendString("uint16_t"); return; }
        if (k == TypeKind.LONG())    { this.out.appendString("int64_t"); return; }
        if (k == TypeKind.FLOAT())   { this.out.appendString("float"); return; }
        if (k == TypeKind.DOUBLE())  { this.out.appendString("double"); return; }
        if (k == TypeKind.BOOLEAN()) { this.out.appendString("bool"); return; }
        if (k == TypeKind.ARRAY())   { this.out.appendString("RtArray*"); return; }
        if (k == TypeKind.NULL())    { this.out.appendString("void*"); return; }
        if (k == TypeKind.CLASS()) {
            if (ty.resolvedClass != null) {
                this.out.appendString(ty.resolvedClass.name);
                if (!ty.resolvedClass.isInterface) {
                    this.out.appendByte('*');
                }
            } else {
                this.out.appendString(ty.className);
                this.out.appendByte('*');
            }
        }
    }

    private void emitZeroValue(Type ty) {
        int k = ty.kind;
        if (k == TypeKind.INT() || k == TypeKind.BYTE() || k == TypeKind.CHAR()) {
            this.out.appendString("0");
        } else if (k == TypeKind.LONG()) {
            this.out.appendString("0LL");
        } else if (k == TypeKind.FLOAT()) {
            this.out.appendString("0.0f");
        } else if (k == TypeKind.DOUBLE()) {
            this.out.appendString("0.0");
        } else if (k == TypeKind.BOOLEAN()) {
            this.out.appendString("false");
        } else if (this.isInterfaceType(ty)) {
            this.out.appendString("((");
            this.out.appendString(ty.resolvedClass.name);
            this.out.appendString("){ NULL, NULL })");
        } else if (k == TypeKind.CLASS() || k == TypeKind.ARRAY() || k == TypeKind.NULL()) {
            this.out.appendString("NULL");
        }
    }

    private void emitCStringLiteral(byte[] bytes) {
        this.out.appendByte('"');
        int i = 0;
        while (i < bytes.length) {
            byte c = bytes[i];
            if (c == '\n') {
                this.out.appendString("\\n");
            } else if (c == '\t') {
                this.out.appendString("\\t");
            } else if (c == '\r') {
                this.out.appendString("\\r");
            } else if (c == '\\') {
                this.out.appendString("\\\\");
            } else if (c == '"') {
                this.out.appendString("\\\"");
            } else if (c < 32 || c >= 127) {
                int v = c;
                int d2 = v / 64;
                int d1 = (v / 8) % 8;
                int d0 = v % 8;
                this.out.appendByte('\\');
                this.out.appendByte('0' + d2);
                this.out.appendByte('0' + d1);
                this.out.appendByte('0' + d0);
            } else {
                this.out.appendByte(c);
            }
            i = i + 1;
        }
        this.out.appendByte('"');
    }

    private String binaryOpStr(int op) {
        if (op == BinaryOp.ADD()) return "+";
        if (op == BinaryOp.SUB()) return "-";
        if (op == BinaryOp.MUL()) return "*";
        if (op == BinaryOp.DIV()) return "/";
        if (op == BinaryOp.MOD()) return "%";
        if (op == BinaryOp.EQ())  return "==";
        if (op == BinaryOp.NEQ()) return "!=";
        if (op == BinaryOp.LT())  return "<";
        if (op == BinaryOp.LE())  return "<=";
        if (op == BinaryOp.GT())  return ">";
        if (op == BinaryOp.GE())  return ">=";
        if (op == BinaryOp.AND())     return "&&";
        if (op == BinaryOp.OR())      return "||";
        if (op == BinaryOp.BIT_AND()) return "&";
        if (op == BinaryOp.BIT_OR())  return "|";
        if (op == BinaryOp.BIT_XOR()) return "^";
        if (op == BinaryOp.SHL())     return "<<";
        if (op == BinaryOp.SHR())     return ">>";
        return "+";
    }

    private void emitExprAs(Expr e, Type targetType) {
        if (this.isInterfaceType(targetType)) {
            String iname = targetType.resolvedClass.name;
            if (e.kind == ExprKind.NULL()) {
                this.out.appendString("((");
                this.out.appendString(iname);
                this.out.appendString("){ NULL, NULL })");
                return;
            }
            if (e.inferredType != null && e.inferredType.kind == TypeKind.CLASS() &&
                e.inferredType.resolvedClass != targetType.resolvedClass) {
                if (e.kind == ExprKind.NEW_OBJ() || e.inferredType.resolvedClass.isFinal) {
                    this.out.appendString("((");
                    this.out.appendString(iname);
                    this.out.appendString("){ (void*)(");
                    this.emitExpr(e);
                    this.out.appendString("), &");
                    this.out.appendString(e.inferredType.resolvedClass.name);
                    this.out.appendByte('_');
                    this.out.appendString(iname);
                    this.out.appendString("_vtable })");
                } else if (e.inferredType.resolvedClass.isInterface) {
                    this.out.appendString(iname);
                    this.out.appendString("__cast_from((");
                    this.emitExpr(e);
                    this.out.appendString(").obj)");
                } else {
                    this.out.appendString(iname);
                    this.out.appendString("__cast_from((void*)(");
                    this.emitExpr(e);
                    this.out.appendString("))");
                }
                return;
            }
            this.emitExpr(e);
            return;
        }
        if (targetType != null && targetType.kind == TypeKind.CLASS() &&
            e.inferredType != null && e.inferredType.kind == TypeKind.CLASS() &&
            targetType.resolvedClass != e.inferredType.resolvedClass) {
            this.out.appendString("((");
            this.emitCType(targetType);
            this.out.appendString(")");
            this.emitExpr(e);
            this.out.appendByte(')');
            return;
        }
        this.emitExpr(e);
    }

    private String vtableSlotName(MethodDecl md) {
        return md.cName.substring(md.owner.name.length() + 1, md.cName.length());
    }

    private int classDepth(ClassDecl cls) {
        int d = 0;
        ClassDecl c = cls.superClass;
        while (c != null) {
            d = d + 1;
            c = c.superClass;
        }
        return d;
    }

    private boolean isStringType(Type ty) {
        return ty != null && ty.kind == TypeKind.CLASS() &&
               ty.resolvedClass != null && ty.resolvedClass.name.equals("String");
    }

    private boolean hasClass(String name) {
        int i = 0;
        while (i < this.prog.classes.size()) {
            if (this.prog.classes.get(i).name.equals(name)) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    private void emitToStringExpr(Expr e) {
        Type ty = e.inferredType;
        if (this.isStringType(ty)) {
            this.out.appendString("rt_str_not_null(");
            this.emitExpr(e);
            this.out.appendByte(')');
            return;
        }
        if (ty == null || ty.kind == TypeKind.NULL()) {
            this.out.appendString("String_new(rt_byte_array_from_literal(\"null\", 4))");
            return;
        }
        if (ty.kind == TypeKind.INT()) {
            this.out.appendString("String_fromInt((int32_t)(");
            this.emitExpr(e);
            this.out.appendString("))");
            return;
        }
        if (ty.kind == TypeKind.BYTE()) {
            this.out.appendString("String_fromByte((uint8_t)(");
            this.emitExpr(e);
            this.out.appendString("))");
            return;
        }
        if (ty.kind == TypeKind.CHAR()) {
            this.out.appendString("String_fromChar((uint16_t)(");
            this.emitExpr(e);
            this.out.appendString("))");
            return;
        }
        if (ty.kind == TypeKind.BOOLEAN()) {
            this.out.appendString("String_fromBoolean(");
            this.emitExpr(e);
            this.out.appendByte(')');
            return;
        }
        if (ty.kind == TypeKind.LONG()) {
            this.out.appendString("String_fromLong((int64_t)(");
            this.emitExpr(e);
            this.out.appendString("))");
            return;
        }
        if (ty.kind == TypeKind.DOUBLE()) {
            this.out.appendString("String_fromDouble((double)(");
            this.emitExpr(e);
            this.out.appendString("))");
            return;
        }
        if (ty.kind == TypeKind.FLOAT()) {
            this.out.appendString("String_fromFloat((float)(");
            this.emitExpr(e);
            this.out.appendString("))");
            return;
        }
        if (this.isInterfaceType(ty)) {
            this.out.appendString("rt_obj_to_str((");
            this.emitExpr(e);
            this.out.appendString(").obj)");
            return;
        }
        this.out.appendString("rt_obj_to_str((void*)(");
        this.emitExpr(e);
        this.out.appendString("))");
    }

    private void emitExpr(Expr e) {
        int k = e.kind;
        if (k == ExprKind.INT_LIT()) {
            this.out.appendInt(e.intVal);
            return;
        }
        if (k == ExprKind.LONG_LIT()) {
            this.out.appendString("((int64_t)");
            this.out.appendString(e.name);
            this.out.appendString("LL)");
            return;
        }
        if (k == ExprKind.DOUBLE_LIT()) {
            this.out.appendString("((double)");
            this.out.appendString(e.name);
            this.out.appendByte(')');
            return;
        }
        if (k == ExprKind.FLOAT_LIT()) {
            this.out.appendString("((float)");
            this.out.appendString(e.name);
            this.out.appendByte(')');
            return;
        }
        if (k == ExprKind.CHAR_LIT()) {
            this.out.appendString("((uint16_t)");
            this.out.appendInt(e.charVal);
            this.out.appendByte(')');
            return;
        }
        if (k == ExprKind.BOOL_LIT()) {
            if (e.boolVal) {
                this.out.appendString("true");
            } else {
                this.out.appendString("false");
            }
            return;
        }
        if (k == ExprKind.NULL()) {
            this.out.appendString("NULL");
            return;
        }
        if (k == ExprKind.DEFAULT_VAL()) {
            this.emitZeroValue(e.elemType);
            return;
        }
        if (k == ExprKind.THIS() || k == ExprKind.SUPER()) {
            this.out.appendString("this");
            return;
        }
        if (k == ExprKind.IDENT()) {
            this.out.appendString(e.name);
            return;
        }
        if (k == ExprKind.STRING_LIT()) {
            this.out.appendString("String_new(rt_byte_array_from_literal(");
            this.emitCStringLiteral(e.strBytes);
            this.out.appendString(", ");
            this.out.appendInt(e.strBytes.length);
            this.out.appendString("))");
            return;
        }
        if (k == ExprKind.UNARY()) {
            this.out.appendByte('(');
            if (e.op == UnaryOp.NEG()) {
                this.out.appendByte('-');
                this.emitExpr(e.left);
            } else if (e.op == UnaryOp.NOT()) {
                this.out.appendByte('!');
                this.emitExpr(e.left);
            } else if (e.op == UnaryOp.BIT_NOT()) {
                this.out.appendByte('~');
                this.emitExpr(e.left);
            } else if (e.op == UnaryOp.PRE_INC()) {
                this.out.appendString("++");
                this.emitExpr(e.left);
            } else if (e.op == UnaryOp.PRE_DEC()) {
                this.out.appendString("--");
                this.emitExpr(e.left);
            } else if (e.op == UnaryOp.POST_INC()) {
                this.emitExpr(e.left);
                this.out.appendString("++");
            } else {
                this.emitExpr(e.left);
                this.out.appendString("--");
            }
            this.out.appendByte(')');
            return;
        }
        if (k == ExprKind.CAST()) {
            if (e.elemType.kind == TypeKind.CLASS()) {
                if (this.isInterfaceType(e.elemType)) {
                    this.out.appendString(e.elemType.resolvedClass.name);
                    this.out.appendString("__cast_from(");
                    if (this.isInterfaceType(e.left.inferredType)) {
                        this.out.appendByte('(');
                        this.emitExpr(e.left);
                        this.out.appendString(").obj");
                    } else {
                        this.out.appendString("(void*)(");
                        this.emitExpr(e.left);
                        this.out.appendByte(')');
                    }
                    this.out.appendByte(')');
                } else {
                    this.out.appendString("((");
                    this.out.appendString(e.elemType.resolvedClass.name);
                    this.out.appendString("*)rt_cast_class(");
                    if (this.isInterfaceType(e.left.inferredType)) {
                        this.out.appendByte('(');
                        this.emitExpr(e.left);
                        this.out.appendString(").obj");
                    } else {
                        this.out.appendString("(void*)(");
                        this.emitExpr(e.left);
                        this.out.appendByte(')');
                    }
                    this.out.appendString(", &");
                    this.out.appendString(e.elemType.resolvedClass.name);
                    this.out.appendString("_type_info))");
                }
                return;
            }
            this.out.appendString("((");
            this.emitCType(e.elemType);
            this.out.appendString(")(");
            this.emitExpr(e.left);
            this.out.appendString("))");
            return;
        }
        if (k == ExprKind.INSTANCEOF()) {
            this.out.appendString("rt_is_instance(");
            if (this.isInterfaceType(e.left.inferredType)) {
                this.out.appendByte('(');
                this.emitExpr(e.left);
                this.out.appendString(").obj");
            } else {
                this.out.appendString("(const void*)(");
                this.emitExpr(e.left);
                this.out.appendByte(')');
            }
            this.out.appendString(", &");
            this.out.appendString(e.elemType.resolvedClass.name);
            this.out.appendString("_type_info)");
            return;
        }
        if (k == ExprKind.COMPOUND_ASSIGN()) {
            if (e.op == BinaryOp.ADD() && this.isStringType(e.left.inferredType)) {
                this.out.appendByte('(');
                this.emitExpr(e.left);
                this.out.appendString(" = String_concat(rt_str_not_null(");
                this.emitExpr(e.left);
                this.out.appendString("), ");
                this.emitToStringExpr(e.right);
                this.out.appendString("))");
                return;
            }
            this.out.appendByte('(');
            this.emitExpr(e.left);
            this.out.appendByte(' ');
            this.out.appendString(this.binaryOpStr(e.op));
            this.out.appendString("= ");
            this.emitExpr(e.right);
            this.out.appendByte(')');
            return;
        }
        if (k == ExprKind.BINARY()) {
            if (e.op == BinaryOp.ADD() &&
                (this.isStringType(e.left.inferredType) || this.isStringType(e.right.inferredType))) {
                this.out.appendString("String_concat(");
                this.emitToStringExpr(e.left);
                this.out.appendString(", ");
                this.emitToStringExpr(e.right);
                this.out.appendByte(')');
                return;
            }
            this.out.appendByte('(');
            boolean hasIface = this.isInterfaceType(e.left.inferredType) ||
                               this.isInterfaceType(e.right.inferredType);
            boolean ptrCmp = (e.op == BinaryOp.EQ() || e.op == BinaryOp.NEQ()) &&
                             (hasIface ||
                              (e.left.inferredType != null && e.right.inferredType != null &&
                               e.left.inferredType.kind == TypeKind.CLASS() &&
                               e.right.inferredType.kind == TypeKind.CLASS()));
            if (ptrCmp) {
                this.out.appendString("(void*)(");
            }
            this.emitExpr(e.left);
            if (ptrCmp) {
                if (this.isInterfaceType(e.left.inferredType)) {
                    this.out.appendString(").obj");
                } else {
                    this.out.appendByte(')');
                }
            }
            this.out.appendByte(' ');
            this.out.appendString(this.binaryOpStr(e.op));
            this.out.appendByte(' ');
            if (ptrCmp) {
                this.out.appendString("(void*)(");
            }
            this.emitExpr(e.right);
            if (ptrCmp) {
                if (this.isInterfaceType(e.right.inferredType)) {
                    this.out.appendString(").obj");
                } else {
                    this.out.appendByte(')');
                }
            }
            this.out.appendByte(')');
            return;
        }
        if (k == ExprKind.ASSIGN()) {
            this.out.appendByte('(');
            this.emitExpr(e.left);
            this.out.appendString(" = ");
            this.emitExprAs(e.right, e.left.inferredType);
            this.out.appendByte(')');
            return;
        }
        if (k == ExprKind.FIELD()) {
            Expr obj = e.left;
            if (e.isArrayLength) {
                this.out.appendString("((RtArray*)rt_null_check(");
                this.emitExpr(obj);
                this.out.appendString(", \"length\"))->length");
            } else if (e.isStaticField) {
                this.out.appendString(e.resolvedClass.name);
                this.out.appendString("__s_");
                this.out.appendString(e.name);
            } else {
                String ownerName = e.resolvedClass.name;
                if (obj.kind == ExprKind.THIS() || obj.kind == ExprKind.SUPER()) {
                    if (this.currentMethod != null && e.resolvedClass == this.currentMethod.owner) {
                        this.out.appendString("this->");
                    } else {
                        this.out.appendString("((");
                        this.out.appendString(ownerName);
                        this.out.appendString("*)this)->");
                    }
                    this.out.appendString(e.name);
                } else {
                    this.out.appendString("((");
                    this.out.appendString(ownerName);
                    this.out.appendString("*)rt_null_check(");
                    this.emitExpr(obj);
                    this.out.appendString(", \"");
                    this.out.appendString(ownerName);
                    this.out.appendByte('.');
                    this.out.appendString(e.name);
                    this.out.appendString("\"))->");
                    this.out.appendString(e.name);
                }
            }
            return;
        }
        if (k == ExprKind.INDEX()) {
            this.out.appendString("(*(");
            this.emitCType(e.inferredType);
            this.out.appendString("*)rt_array_elem_ptr(");
            this.emitExpr(e.left);
            this.out.appendString(", ");
            this.emitExpr(e.right);
            this.out.appendString("))");
            return;
        }
        if (k == ExprKind.CALL()) {
            if (e.left.kind == ExprKind.SUPER()) {
                if (e.resolvedMethod != null) {
                    this.out.appendString(e.resolvedMethod.cInitName);
                } else {
                    this.out.appendString(e.resolvedClass.name);
                    this.out.appendString("_init");
                }
                this.out.appendString("((");
                this.out.appendString(e.resolvedClass.name);
                this.out.appendString("*)this");
                int i = 0;
                while (i < e.args.size()) {
                    this.out.appendString(", ");
                    this.emitExprAs(e.args.get(i), e.resolvedMethod.params.get(i).type);
                    i = i + 1;
                }
                this.out.appendByte(')');
                return;
            }
            MethodDecl m = e.resolvedMethod;
            if (m.isNative) {
                this.out.appendString(m.name);
                this.out.appendByte('(');
                int i = 0;
                while (i < e.args.size()) {
                    if (i > 0) this.out.appendString(", ");
                    this.emitExprAs(e.args.get(i), m.params.get(i).type);
                    i = i + 1;
                }
                this.out.appendByte(')');
            } else if (m.isStatic) {
                this.out.appendString(m.cName);
                this.out.appendByte('(');
                int i = 0;
                while (i < e.args.size()) {
                    if (i > 0) this.out.appendString(", ");
                    this.emitExprAs(e.args.get(i), m.params.get(i).type);
                    i = i + 1;
                }
                this.out.appendByte(')');
            } else {
                Expr obj = e.left.left;
                if (obj.kind == ExprKind.SUPER()) {
                    /* Non-virtual super.method(...) call */
                    this.out.appendString(m.cName);
                    this.out.appendString("((");
                    this.out.appendString(m.owner.name);
                    this.out.appendString("*)this");
                } else if (!obj.inferredType.resolvedClass.isInterface &&
                           m.owner == obj.inferredType.resolvedClass &&
                           (m.isFinal || obj.inferredType.resolvedClass.isFinal)) {
                    /* Devirtualized direct call for final method/class */
                    this.out.appendString(m.cName);
                    this.out.appendByte('(');
                    if (obj.kind == ExprKind.THIS()) {
                        this.out.appendString("this");
                    } else {
                        this.out.appendString("((");
                        this.out.appendString(m.owner.name);
                        this.out.appendString("*)rt_null_check(");
                        this.emitExpr(obj);
                        this.out.appendString(", \"");
                        this.out.appendString(m.owner.name);
                        this.out.appendByte('.');
                        this.out.appendString(m.name);
                        this.out.appendString("\"))");
                    }
                } else {
                    /* Virtual dispatch via VTable helper */
                    String staticCls = obj.inferredType.resolvedClass.name;
                    this.out.appendString(staticCls);
                    this.out.appendString("__call_");
                    this.out.appendString(this.vtableSlotName(m));
                    this.out.appendByte('(');
                    this.emitExpr(obj);
                }
                int i = 0;
                while (i < e.args.size()) {
                    this.out.appendString(", ");
                    this.emitExprAs(e.args.get(i), m.params.get(i).type);
                    i = i + 1;
                }
                this.out.appendByte(')');
            }
            return;
        }
        if (k == ExprKind.NEW_OBJ()) {
            if (e.resolvedMethod != null) {
                this.out.appendString(e.resolvedMethod.cName);
            } else {
                this.out.appendString(e.resolvedClass.name);
                this.out.appendString("_new");
            }
            this.out.appendByte('(');
            int i = 0;
            while (i < e.args.size()) {
                if (i > 0) this.out.appendString(", ");
                this.emitExprAs(e.args.get(i), e.resolvedMethod.params.get(i).type);
                i = i + 1;
            }
            this.out.appendByte(')');
            return;
        }
        if (k == ExprKind.NEW_ARRAY()) {
            Type elem = e.elemType;
            if (this.isInterfaceType(elem)) {
                this.out.appendString("rt_array_new_iface(");
                this.emitExpr(e.left);
                this.out.appendString(", (int32_t)sizeof(");
                this.emitCType(elem);
                this.out.appendString("))");
                return;
            }
            boolean isRef = (elem.kind == TypeKind.CLASS() || elem.kind == TypeKind.ARRAY());
            this.out.appendString("rt_array_new(");
            this.emitExpr(e.left);
            this.out.appendString(", (int32_t)sizeof(");
            this.emitCType(elem);
            this.out.appendString("), ");
            if (isRef) {
                this.out.appendString("true)");
            } else {
                this.out.appendString("false)");
            }
            return;
        }
    }

    private void emitBlockBody(Stmt b, boolean isWhileBody) {
        this.out.appendString("{\n");
        this.indent = this.indent + 1;
        if (isWhileBody) {
            this.emitIndent();
            this.out.appendString("rt_gc_maybe_collect();\n");
        }
        this.blockStartSlot[this.blockDepth] = this.gcNextSlot;
        this.blockDepth = this.blockDepth + 1;
        int i = 0;
        while (i < b.stmts.size()) {
            this.emitStmt(b.stmts.get(i));
            i = i + 1;
        }
        this.blockDepth = this.blockDepth - 1;
        this.emitClearSlots(this.blockStartSlot[this.blockDepth], this.gcNextSlot);
        this.indent = this.indent - 1;
        this.emitIndent();
        this.out.appendByte('}');
    }

    private void emitStmt(Stmt st) {
        int k = st.kind;
        if (k == StmtKind.BLOCK()) {
            this.emitIndent();
            this.emitBlockBody(st, false);
            this.out.appendByte('\n');
            return;
        }
        if (k == StmtKind.VAR_DECL()) {
            this.emitIndent();
            if (this.methodHasTry && !this.isRefType(st.varType) && !this.isInterfaceType(st.varType)) {
                this.out.appendString("volatile ");
            }
            this.emitCType(st.varType);
            this.out.appendByte(' ');
            this.out.appendString(st.varName);
            this.out.appendString(" = ");
            if (st.expr != null) {
                this.emitExprAs(st.expr, st.varType);
            } else {
                this.emitZeroValue(st.varType);
            }
            this.out.appendString(";\n");
            if (this.isRefType(st.varType)) {
                this.emitIndent();
                this.out.appendString("_gc_slots[");
                this.out.appendInt(this.gcNextSlot);
                this.out.appendString("] = &");
                this.out.appendString(st.varName);
                if (this.isInterfaceType(st.varType)) {
                    this.out.appendString(".obj");
                }
                this.out.appendString(";\n");
                this.gcNextSlot = this.gcNextSlot + 1;
            }
            return;
        }
        if (k == StmtKind.IF()) {
            this.emitIndent();
            this.out.appendString("if (");
            this.emitExpr(st.expr);
            this.out.appendString(") ");
            if (st.thenBranch.kind == StmtKind.BLOCK()) {
                this.emitBlockBody(st.thenBranch, false);
            } else {
                this.out.appendString("{\n");
                this.indent = this.indent + 1;
                this.emitStmt(st.thenBranch);
                this.indent = this.indent - 1;
                this.emitIndent();
                this.out.appendByte('}');
            }
            if (st.elseBranch != null) {
                this.out.appendString(" else ");
                if (st.elseBranch.kind == StmtKind.BLOCK()) {
                    this.emitBlockBody(st.elseBranch, false);
                    this.out.appendByte('\n');
                } else {
                    this.out.appendString("{\n");
                    this.indent = this.indent + 1;
                    this.emitStmt(st.elseBranch);
                    this.indent = this.indent - 1;
                    this.emitIndent();
                    this.out.appendString("}\n");
                }
            } else {
                this.out.appendByte('\n');
            }
            return;
        }
        if (k == StmtKind.WHILE()) {
            this.emitIndent();
            this.out.appendString("while (");
            this.emitExpr(st.expr);
            this.out.appendString(") ");
            this.loopSlotStart[this.loopDepth] = this.gcNextSlot;
            this.loopDepth = this.loopDepth + 1;
            this.breakSlotStart[this.breakDepth] = this.gcNextSlot;
            this.breakDepth = this.breakDepth + 1;
            if (st.thenBranch.kind == StmtKind.BLOCK()) {
                this.emitBlockBody(st.thenBranch, true);
                this.out.appendByte('\n');
            } else {
                this.out.appendString("{\n");
                this.indent = this.indent + 1;
                this.emitIndent();
                this.out.appendString("rt_gc_maybe_collect();\n");
                this.emitStmt(st.thenBranch);
                this.indent = this.indent - 1;
                this.emitIndent();
                this.out.appendString("}\n");
            }
            this.breakDepth = this.breakDepth - 1;
            this.loopDepth = this.loopDepth - 1;
            return;
        }
        if (k == StmtKind.FOR()) {
            this.emitIndent();
            this.out.appendString("{\n");
            this.indent = this.indent + 1;
            int forInitSlot = this.gcNextSlot;
            if (st.initStmt != null) {
                this.emitStmt(st.initStmt);
            }
            this.emitIndent();
            this.out.appendString("for (; ");
            if (st.expr != null) {
                this.emitExprAs(st.expr, st.varType);
            } else {
                this.out.appendString("true");
            }
            this.out.appendString("; ");
            if (st.stepExpr != null) {
                this.emitExpr(st.stepExpr);
            }
            this.out.appendString(") ");
            this.loopSlotStart[this.loopDepth] = this.gcNextSlot;
            this.loopDepth = this.loopDepth + 1;
            this.breakSlotStart[this.breakDepth] = this.gcNextSlot;
            this.breakDepth = this.breakDepth + 1;
            if (st.thenBranch.kind == StmtKind.BLOCK()) {
                this.emitBlockBody(st.thenBranch, true);
                this.out.appendByte('\n');
            } else {
                this.out.appendString("{\n");
                this.indent = this.indent + 1;
                this.emitIndent();
                this.out.appendString("rt_gc_maybe_collect();\n");
                this.emitStmt(st.thenBranch);
                this.indent = this.indent - 1;
                this.emitIndent();
                this.out.appendString("}\n");
            }
            this.breakDepth = this.breakDepth - 1;
            this.loopDepth = this.loopDepth - 1;
            this.emitClearSlots(forInitSlot, this.gcNextSlot);
            this.indent = this.indent - 1;
            this.emitIndent();
            this.out.appendString("}\n");
            return;
        }
        if (k == StmtKind.SWITCH()) {
            this.emitIndent();
            this.out.appendString("switch (");
            this.emitExpr(st.expr);
            this.out.appendString(") {\n");
            this.indent = this.indent + 1;
            this.breakSlotStart[this.breakDepth] = this.gcNextSlot;
            this.breakDepth = this.breakDepth + 1;
            int i = 0;
            while (i < st.stmts.size()) {
                Stmt c = st.stmts.get(i);
                this.emitIndent();
                if (c.kind == StmtKind.CASE()) {
                    this.out.appendString("case ");
                    this.out.appendInt(c.intVal);
                    this.out.appendString(": {\n");
                } else {
                    this.out.appendString("default: {\n");
                }
                this.indent = this.indent + 1;
                int caseStartSlot = this.gcNextSlot;
                int j = 0;
                while (j < c.stmts.size()) {
                    this.emitStmt(c.stmts.get(j));
                    j = j + 1;
                }
                this.emitClearSlots(caseStartSlot, this.gcNextSlot);
                this.indent = this.indent - 1;
                this.emitIndent();
                this.out.appendString("}\n");
                i = i + 1;
            }
            this.breakDepth = this.breakDepth - 1;
            this.indent = this.indent - 1;
            this.emitIndent();
            this.out.appendString("}\n");
            return;
        }
        if (k == StmtKind.BREAK()) {
            if (this.gcTotalSlots > 0 && this.breakDepth > 0) {
                this.emitClearSlots(this.breakSlotStart[this.breakDepth - 1], this.gcNextSlot);
            }
            this.emitIndent();
            this.out.appendString("break;\n");
            return;
        }
        if (k == StmtKind.CONTINUE()) {
            if (this.gcTotalSlots > 0 && this.loopDepth > 0) {
                this.emitClearSlots(this.loopSlotStart[this.loopDepth - 1], this.gcNextSlot);
            }
            this.emitIndent();
            this.out.appendString("continue;\n");
            return;
        }
        if (k == StmtKind.RETURN()) {
            if (this.currentMethod != null && this.currentMethod.isConstructor) {
                this.emitExcUnwind();
                if (this.gcTotalSlots > 0) {
                    this.emitIndent();
                    this.out.appendString("rt_shadow_stack = _gc_frame.prev;\n");
                }
                this.emitIndent();
                this.out.appendString("return;\n");
            } else if (st.expr != null) {
                if (this.gcTotalSlots > 0 || this.excDepth > 0) {
                    this.emitIndent();
                    this.emitCType(this.currentMethod.returnType);
                    this.out.appendString(" _gc_ret = ");
                    this.emitExprAs(st.expr, this.currentMethod.returnType);
                    this.out.appendString(";\n");
                    this.emitExcUnwind();
                    if (this.gcTotalSlots > 0) {
                        this.emitIndent();
                        this.out.appendString("rt_shadow_stack = _gc_frame.prev;\n");
                    }
                    this.emitIndent();
                    this.out.appendString("return _gc_ret;\n");
                } else {
                    this.emitIndent();
                    this.out.appendString("return ");
                    this.emitExprAs(st.expr, this.currentMethod.returnType);
                    this.out.appendString(";\n");
                }
            } else {
                this.emitExcUnwind();
                if (this.gcTotalSlots > 0) {
                    this.emitIndent();
                    this.out.appendString("rt_shadow_stack = _gc_frame.prev;\n");
                }
                this.emitIndent();
                this.out.appendString("return;\n");
            }
            return;
        }
        if (k == StmtKind.THROW()) {
            this.emitIndent();
            this.out.appendString("rt_throw((void*)(");
            this.emitExpr(st.expr);
            this.out.appendString("));\n");
            return;
        }
        if (k == StmtKind.TRY()) {
            int id = this.excCounter;
            this.excCounter = this.excCounter + 1;
            boolean hasFin = st.elseBranch != null;
            boolean hasCatch = st.stmts.size() > 0;
            String finName = "_fin_ef_".concat(String.fromInt(id));
            String efName = "_ef_".concat(String.fromInt(id));

            this.emitIndent();
            this.out.appendString("{\n");
            this.indent = this.indent + 1;

            if (hasFin) {
                this.emitIndent();
                this.out.appendString("void* volatile _fin_exc_");
                this.out.appendInt(id);
                this.out.appendString(" = NULL;\n");
                this.emitIndent();
                this.out.appendString("volatile bool _fin_rethrow_");
                this.out.appendInt(id);
                this.out.appendString(" = false;\n");
                this.emitIndent();
                this.out.appendString("RtExceptionFrame ");
                this.out.appendString(finName);
                this.out.appendString(" = { .prev = rt_exc_top, .saved_shadow_stack = rt_shadow_stack, .exception = NULL };\n");
                this.emitIndent();
                this.out.appendString("rt_exc_top = &");
                this.out.appendString(finName);
                this.out.appendString(";\n");
                this.emitIndent();
                this.out.appendString("if (setjmp(");
                this.out.appendString(finName);
                this.out.appendString(".env) == 0) {\n");
                this.indent = this.indent + 1;

                this.excFrameNames[this.excDepth] = finName;
                this.excFinallyBlocks[this.excDepth] = st.elseBranch;
                this.excSyncObjs[this.excDepth] = null;
                this.excDepth = this.excDepth + 1;
            }

            if (hasCatch) {
                this.emitIndent();
                this.out.appendString("RtExceptionFrame ");
                this.out.appendString(efName);
                this.out.appendString(" = { .prev = rt_exc_top, .saved_shadow_stack = rt_shadow_stack, .exception = NULL };\n");
                this.emitIndent();
                this.out.appendString("rt_exc_top = &");
                this.out.appendString(efName);
                this.out.appendString(";\n");
                this.emitIndent();
                this.out.appendString("if (setjmp(");
                this.out.appendString(efName);
                this.out.appendString(".env) == 0) {\n");
                this.indent = this.indent + 1;

                this.excFrameNames[this.excDepth] = efName;
                this.excFinallyBlocks[this.excDepth] = null;
                this.excSyncObjs[this.excDepth] = null;
                this.excDepth = this.excDepth + 1;

                this.emitStmt(st.thenBranch);

                this.excDepth = this.excDepth - 1;
                this.emitIndent();
                this.out.appendString("rt_exc_top = ");
                this.out.appendString(efName);
                this.out.appendString(".prev;\n");
                this.indent = this.indent - 1;
                this.emitIndent();
                this.out.appendString("} else {\n");
                this.indent = this.indent + 1;
                this.emitIndent();
                this.out.appendString("rt_exc_top = ");
                this.out.appendString(efName);
                this.out.appendString(".prev;\n");
                this.emitIndent();
                this.out.appendString("void* _caught_");
                this.out.appendInt(id);
                this.out.appendString(" = ");
                this.out.appendString(efName);
                this.out.appendString(".exception;\n");

                int ci = 0;
                while (ci < st.stmts.size()) {
                    Stmt c = st.stmts.get(ci);
                    this.emitIndent();
                    if (ci > 0) {
                        this.out.appendString("else ");
                    }
                    this.out.appendString("if (rt_is_instance(_caught_");
                    this.out.appendInt(id);
                    this.out.appendString(", &");
                    this.out.appendString(c.varType.resolvedClass.name);
                    this.out.appendString("_type_info)) {\n");
                    this.indent = this.indent + 1;

                    int catchSlot = this.gcNextSlot;
                    if (this.gcTotalSlots > 0) {
                        this.gcNextSlot = this.gcNextSlot + 1;
                    }
                    this.emitIndent();
                    this.emitCType(c.varType);
                    this.out.appendByte(' ');
                    this.out.appendString(c.varName);
                    this.out.appendString(" = (");
                    this.emitCType(c.varType);
                    this.out.appendString(")_caught_");
                    this.out.appendInt(id);
                    this.out.appendString(";\n");
                    if (this.gcTotalSlots > 0) {
                        this.emitIndent();
                        this.out.appendString("_gc_slots[");
                        this.out.appendInt(catchSlot);
                        this.out.appendString("] = (void*)&");
                        this.out.appendString(c.varName);
                        this.out.appendString(";\n");
                    }
                    this.emitStmt(c.thenBranch);
                    if (this.gcTotalSlots > 0) {
                        this.emitClearSlots(catchSlot, this.gcNextSlot);
                    }
                    this.indent = this.indent - 1;
                    this.emitIndent();
                    this.out.appendString("}\n");
                    ci = ci + 1;
                }
                this.emitIndent();
                this.out.appendString("else {\n");
                this.indent = this.indent + 1;
                this.emitIndent();
                this.out.appendString("rt_throw(_caught_");
                this.out.appendInt(id);
                this.out.appendString(");\n");
                this.indent = this.indent - 1;
                this.emitIndent();
                this.out.appendString("}\n");

                this.indent = this.indent - 1;
                this.emitIndent();
                this.out.appendString("}\n");
            } else {
                this.emitStmt(st.thenBranch);
            }

            if (hasFin) {
                this.excDepth = this.excDepth - 1;
                this.emitIndent();
                this.out.appendString("rt_exc_top = ");
                this.out.appendString(finName);
                this.out.appendString(".prev;\n");
                this.indent = this.indent - 1;
                this.emitIndent();
                this.out.appendString("} else {\n");
                this.indent = this.indent + 1;
                this.emitIndent();
                this.out.appendString("rt_exc_top = ");
                this.out.appendString(finName);
                this.out.appendString(".prev;\n");
                this.emitIndent();
                this.out.appendString("_fin_exc_");
                this.out.appendInt(id);
                this.out.appendString(" = ");
                this.out.appendString(finName);
                this.out.appendString(".exception;\n");
                this.emitIndent();
                this.out.appendString("_fin_rethrow_");
                this.out.appendInt(id);
                this.out.appendString(" = true;\n");
                this.indent = this.indent - 1;
                this.emitIndent();
                this.out.appendString("}\n");

                this.emitStmt(st.elseBranch);

                this.emitIndent();
                this.out.appendString("if (_fin_rethrow_");
                this.out.appendInt(id);
                this.out.appendString(") {\n");
                this.indent = this.indent + 1;
                this.emitIndent();
                this.out.appendString("rt_throw(_fin_exc_");
                this.out.appendInt(id);
                this.out.appendString(");\n");
                this.indent = this.indent - 1;
                this.emitIndent();
                this.out.appendString("}\n");
            }

            this.indent = this.indent - 1;
            this.emitIndent();
            this.out.appendString("}\n");
            return;
        }
        if (k == StmtKind.SYNCHRONIZED()) {
            int id = this.excCounter;
            this.excCounter = this.excCounter + 1;
            String objVar = "_sync_obj_".concat(String.fromInt(id));
            String efName = "_sync_ef_".concat(String.fromInt(id));

            this.emitIndent();
            this.out.appendString("{\n");
            this.indent = this.indent + 1;

            this.emitIndent();
            this.out.appendString("void* ");
            this.out.appendString(objVar);
            this.out.appendString(" = ");
            if (this.isInterfaceType(st.expr.inferredType)) {
                this.out.appendByte('(');
                this.emitExpr(st.expr);
                this.out.appendString(").obj;\n");
            } else {
                this.out.appendString("(void*)(");
                this.emitExpr(st.expr);
                this.out.appendString(");\n");
            }
            this.emitIndent();
            this.out.appendString("rt_monitor_enter(");
            this.out.appendString(objVar);
            this.out.appendString(");\n");
            this.emitIndent();
            this.out.appendString("void* volatile _sync_exc_");
            this.out.appendInt(id);
            this.out.appendString(" = NULL;\n");
            this.emitIndent();
            this.out.appendString("volatile bool _sync_rethrow_");
            this.out.appendInt(id);
            this.out.appendString(" = false;\n");
            this.emitIndent();
            this.out.appendString("RtExceptionFrame ");
            this.out.appendString(efName);
            this.out.appendString(" = { .prev = rt_exc_top, .saved_shadow_stack = rt_shadow_stack, .exception = NULL };\n");
            this.emitIndent();
            this.out.appendString("rt_exc_top = &");
            this.out.appendString(efName);
            this.out.appendString(";\n");
            this.emitIndent();
            this.out.appendString("if (setjmp(");
            this.out.appendString(efName);
            this.out.appendString(".env) == 0) {\n");
            this.indent = this.indent + 1;

            this.excFrameNames[this.excDepth] = efName;
            this.excFinallyBlocks[this.excDepth] = null;
            this.excSyncObjs[this.excDepth] = objVar;
            this.excDepth = this.excDepth + 1;

            this.emitStmt(st.thenBranch);

            this.excDepth = this.excDepth - 1;
            this.emitIndent();
            this.out.appendString("rt_exc_top = ");
            this.out.appendString(efName);
            this.out.appendString(".prev;\n");
            this.indent = this.indent - 1;
            this.emitIndent();
            this.out.appendString("} else {\n");
            this.indent = this.indent + 1;
            this.emitIndent();
            this.out.appendString("rt_exc_top = ");
            this.out.appendString(efName);
            this.out.appendString(".prev;\n");
            this.emitIndent();
            this.out.appendString("_sync_exc_");
            this.out.appendInt(id);
            this.out.appendString(" = ");
            this.out.appendString(efName);
            this.out.appendString(".exception;\n");
            this.emitIndent();
            this.out.appendString("_sync_rethrow_");
            this.out.appendInt(id);
            this.out.appendString(" = true;\n");
            this.indent = this.indent - 1;
            this.emitIndent();
            this.out.appendString("}\n");
            this.emitIndent();
            this.out.appendString("rt_monitor_exit(");
            this.out.appendString(objVar);
            this.out.appendString(");\n");
            this.emitIndent();
            this.out.appendString("if (_sync_rethrow_");
            this.out.appendInt(id);
            this.out.appendString(") {\n");
            this.indent = this.indent + 1;
            this.emitIndent();
            this.out.appendString("rt_throw(_sync_exc_");
            this.out.appendInt(id);
            this.out.appendString(");\n");
            this.indent = this.indent - 1;
            this.emitIndent();
            this.out.appendString("}\n");

            this.indent = this.indent - 1;
            this.emitIndent();
            this.out.appendString("}\n");
            return;
        }
        if (k == StmtKind.EXPR()) {
            this.emitIndent();
            this.emitExpr(st.expr);
            this.out.appendString(";\n");
            return;
        }
    }

    private void emitMethodSig(ClassDecl cls, MethodDecl m) {
        if (m != null && m.isConstructor) {
            this.out.appendString(cls.name);
            this.out.appendString("* ");
            this.out.appendString(m.cName);
            this.out.appendByte('(');
            if (m.params.size() == 0) {
                this.out.appendString("void");
            } else {
                int i = 0;
                while (i < m.params.size()) {
                    if (i > 0) this.out.appendString(", ");
                    Param p = m.params.get(i);
                    this.emitCType(p.type);
                    this.out.appendByte(' ');
                    this.out.appendString(p.name);
                    i = i + 1;
                }
            }
            this.out.appendByte(')');
            return;
        }
        if (m == null) {
            this.out.appendString(cls.name);
            this.out.appendString("* ");
            this.out.appendString(cls.name);
            this.out.appendString("_new(void)");
            return;
        }
        this.emitCType(m.returnType);
        this.out.appendByte(' ');
        this.out.appendString(m.cName);
        this.out.appendByte('(');
        boolean first = true;
        if (!m.isStatic) {
            this.out.appendString(cls.name);
            this.out.appendString("* this");
            first = false;
        }
        int i = 0;
        while (i < m.params.size()) {
            if (!first) this.out.appendString(", ");
            first = false;
            Param p = m.params.get(i);
            this.emitCType(p.type);
            this.out.appendByte(' ');
            this.out.appendString(p.name);
            i = i + 1;
        }
        if (first) {
            this.out.appendString("void");
        }
        this.out.appendByte(')');
    }

    private MethodDecl findEntryMain() {
        int i = 0;
        while (i < this.prog.classes.size()) {
            ClassDecl cls = this.prog.classes.get(i);
            if (cls.name.equals("Main")) {
                int m = 0;
                while (m < cls.methods.size()) {
                    MethodDecl md = cls.methods.get(m);
                    if (md.isStatic && md.name.equals("main") && md.params.size() == 0) {
                        return md;
                    }
                    m = m + 1;
                }
            }
            i = i + 1;
        }
        return null;
    }

    private void emitInitSig(ClassDecl cls, MethodDecl ctor) {
        this.out.appendString("void ");
        if (ctor != null) {
            this.out.appendString(ctor.cInitName);
        } else {
            this.out.appendString(cls.name);
            this.out.appendString("_init");
        }
        this.out.appendByte('(');
        this.out.appendString(cls.name);
        this.out.appendString("* this");
        if (ctor != null) {
            int i = 0;
            while (i < ctor.params.size()) {
                this.out.appendString(", ");
                Param p = ctor.params.get(i);
                this.emitCType(p.type);
                this.out.appendByte(' ');
                this.out.appendString(p.name);
                i = i + 1;
            }
        }
        this.out.appendByte(')');
    }

    private void emitInterfaceTypes() {
        int i = 0;
        while (i < this.prog.classes.size()) {
            ClassDecl cls = this.prog.classes.get(i);
            if (cls.isInterface && !cls.isGenericTemplate) {
                this.out.appendString("typedef struct ");
                this.out.appendString(cls.name);
                this.out.appendString("_VTable ");
                this.out.appendString(cls.name);
                this.out.appendString("_VTable;\n");

                this.out.appendString("typedef struct ");
                this.out.appendString(cls.name);
                this.out.appendString(" {\n");
                this.out.appendString("    void* obj;\n");
                this.out.appendString("    const ");
                this.out.appendString(cls.name);
                this.out.appendString("_VTable* vtable;\n} ");
                this.out.appendString(cls.name);
                this.out.appendString(";\n");

                this.out.appendString("static const RtTypeInfo ");
                this.out.appendString(cls.name);
                this.out.appendString("_type_info = { \"");
                this.out.appendString(cls.name);
                this.out.appendString("\", 0, NULL, NULL, NULL, 0, NULL, NULL };\n\n");
            }
            i = i + 1;
        }

        i = 0;
        while (i < this.prog.classes.size()) {
            ClassDecl cls = this.prog.classes.get(i);
            if (cls.isInterface && !cls.isGenericTemplate) {
                this.out.appendString("struct ");
                this.out.appendString(cls.name);
                this.out.appendString("_VTable {\n");
                int m = 0;
                while (m < cls.methods.size()) {
                    MethodDecl md = cls.methods.get(m);
                    this.out.appendString("    ");
                    this.emitCType(md.returnType);
                    this.out.appendString(" (*");
                    this.out.appendString(this.vtableSlotName(md));
                    this.out.appendString(")(void*");
                    int p = 0;
                    while (p < md.params.size()) {
                        this.out.appendString(", ");
                        this.emitCType(md.params.get(p).type);
                        p = p + 1;
                    }
                    this.out.appendString(");\n");
                    m = m + 1;
                }
                this.out.appendString("};\n\n");

                this.out.appendString("static inline ");
                this.out.appendString(cls.name);
                this.out.appendByte(' ');
                this.out.appendString(cls.name);
                this.out.appendString("__cast_from(void* ptr) {\n");
                this.out.appendString("    return (");
                this.out.appendString(cls.name);
                this.out.appendString("){ ptr, (const ");
                this.out.appendString(cls.name);
                this.out.appendString("_VTable*)rt_cast_iface_vtable(ptr, &");
                this.out.appendString(cls.name);
                this.out.appendString("_type_info) };\n}\n\n");

                m = 0;
                while (m < cls.methods.size()) {
                    MethodDecl md = cls.methods.get(m);
                    String slot = this.vtableSlotName(md);
                    this.out.appendString("static inline ");
                    this.emitCType(md.returnType);
                    this.out.appendByte(' ');
                    this.out.appendString(cls.name);
                    this.out.appendString("__call_");
                    this.out.appendString(slot);
                    this.out.appendByte('(');
                    this.out.appendString(cls.name);
                    this.out.appendString(" self");
                    int p = 0;
                    while (p < md.params.size()) {
                        Param pm = md.params.get(p);
                        this.out.appendString(", ");
                        this.emitCType(pm.type);
                        this.out.appendByte(' ');
                        this.out.appendString(pm.name);
                        p = p + 1;
                    }
                    this.out.appendString(") {\n");
                    this.out.appendString("    rt_null_check(self.obj, \"");
                    this.out.appendString(cls.name);
                    this.out.appendByte('.');
                    this.out.appendString(md.name);
                    this.out.appendString("\");\n    ");
                    if (md.returnType.kind != TypeKind.VOID()) {
                        this.out.appendString("return ");
                    }
                    this.out.appendString("self.vtable->");
                    this.out.appendString(slot);
                    this.out.appendString("(self.obj");
                    p = 0;
                    while (p < md.params.size()) {
                        this.out.appendString(", ");
                        this.out.appendString(md.params.get(p).name);
                        p = p + 1;
                    }
                    this.out.appendString(");\n}\n\n");
                    m = m + 1;
                }
            }
            i = i + 1;
        }
    }

    private void emitVTableStructs() {
        int i = 0;
        while (i < this.prog.classes.size()) {
            ClassDecl cls = this.prog.classes.get(i);
            if (!cls.isInterface && !cls.isGenericTemplate && cls.vtable.size() > 0) {
                this.out.appendString("typedef struct ");
                this.out.appendString(cls.name);
                this.out.appendString("_VTable {\n");
                int v = 0;
                while (v < cls.vtable.size()) {
                    MethodDecl md = cls.vtable.get(v);
                    this.out.appendString("    ");
                    this.emitCType(md.returnType);
                    this.out.appendString(" (*");
                    this.out.appendString(this.vtableSlotName(md));
                    this.out.appendString(")(");
                    this.out.appendString(cls.name);
                    this.out.appendByte('*');
                    int p = 0;
                    while (p < md.params.size()) {
                        this.out.appendString(", ");
                        this.emitCType(md.params.get(p).type);
                        p = p + 1;
                    }
                    this.out.appendString(");\n");
                    v = v + 1;
                }
                this.out.appendString("} ");
                this.out.appendString(cls.name);
                this.out.appendString("_VTable;\n\n");
            }
            i = i + 1;
        }
    }

    private void emitVirtualDispatchers() {
        int i = 0;
        while (i < this.prog.classes.size()) {
            ClassDecl cls = this.prog.classes.get(i);
            int v = 0;
            while (!cls.isInterface && !cls.isGenericTemplate && v < cls.vtable.size()) {
                MethodDecl md = cls.vtable.get(v);
                String slot = this.vtableSlotName(md);
                this.out.appendString("static inline ");
                this.emitCType(md.returnType);
                this.out.appendByte(' ');
                this.out.appendString(cls.name);
                this.out.appendString("__call_");
                this.out.appendString(slot);
                this.out.appendByte('(');
                this.out.appendString(cls.name);
                this.out.appendString("* self");
                int p = 0;
                while (p < md.params.size()) {
                    Param pm = md.params.get(p);
                    this.out.appendString(", ");
                    this.emitCType(pm.type);
                    this.out.appendByte(' ');
                    this.out.appendString(pm.name);
                    p = p + 1;
                }
                this.out.appendString(") {\n");
                this.out.appendString("    rt_null_check(self, \"");
                this.out.appendString(cls.name);
                this.out.appendByte('.');
                this.out.appendString(md.name);
                this.out.appendString("\");\n    ");
                if (md.returnType.kind != TypeKind.VOID()) {
                    this.out.appendString("return ");
                }
                this.out.appendString("((const ");
                this.out.appendString(cls.name);
                this.out.appendString("_VTable*)((Obj*)self)->type_info->vtable)->");
                this.out.appendString(slot);
                this.out.appendString("(self");
                p = 0;
                while (p < md.params.size()) {
                    this.out.appendString(", ");
                    this.out.appendString(md.params.get(p).name);
                    p = p + 1;
                }
                this.out.appendString(");\n}\n\n");
                v = v + 1;
            }
            i = i + 1;
        }
    }

    private MethodDecl findImplMethod(ClassDecl cls, MethodDecl target) {
        String targetSlot = this.vtableSlotName(target);
        ClassDecl c = cls;
        while (c != null) {
            int i = 0;
            while (i < c.methods.size()) {
                MethodDecl md = c.methods.get(i);
                if (!md.isStatic && this.vtableSlotName(md).equals(targetSlot)) {
                    return md;
                }
                i = i + 1;
            }
            c = c.superClass;
        }
        return null;
    }

    private boolean ifaceExtends(ClassDecl iface, ClassDecl target, int depth) {
        if (iface == target) {
            return true;
        }
        if (depth > 64) {
            return false;
        }
        int i = 0;
        while (i < iface.impls.size()) {
            if (this.ifaceExtends(iface.impls.get(i), target, depth + 1)) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    private boolean classImplementsIface(ClassDecl cls, ClassDecl iface) {
        ClassDecl c = cls;
        while (c != null) {
            int i = 0;
            while (i < c.impls.size()) {
                if (this.ifaceExtends(c.impls.get(i), iface, 0)) {
                    return true;
                }
                i = i + 1;
            }
            c = c.superClass;
        }
        return false;
    }

    private void emitInterfaceVTables(ClassDecl cls) {
        int j = 0;
        while (j < this.prog.classes.size()) {
            ClassDecl iface = this.prog.classes.get(j);
            if (iface.isInterface && this.classImplementsIface(cls, iface)) {
                this.out.appendString("const ");
                this.out.appendString(iface.name);
                this.out.appendString("_VTable ");
                this.out.appendString(cls.name);
                this.out.appendByte('_');
                this.out.appendString(iface.name);
                this.out.appendString("_vtable = {\n");
                int m = 0;
                while (m < iface.methods.size()) {
                    MethodDecl im = iface.methods.get(m);
                    MethodDecl impl = this.findImplMethod(cls, im);
                    this.out.appendString("    (");
                    this.emitCType(im.returnType);
                    this.out.appendString(" (*)(void*");
                    int p = 0;
                    while (p < im.params.size()) {
                        this.out.appendString(", ");
                        this.emitCType(im.params.get(p).type);
                        p = p + 1;
                    }
                    this.out.appendString("))");
                    this.out.appendString(impl.cName);
                    if (m + 1 < iface.methods.size()) {
                        this.out.appendByte(',');
                    }
                    this.out.appendByte('\n');
                    m = m + 1;
                }
                this.out.appendString("};\n");
            }
            j = j + 1;
        }
    }

    private void emitTypeInfos() {
        int maxDepth = 0;
        int i = 0;
        while (i < this.prog.classes.size()) {
            ClassDecl c0 = this.prog.classes.get(i);
            if (!c0.isInterface && !c0.isGenericTemplate) {
                int d = this.classDepth(c0);
                if (d > maxDepth) {
                    maxDepth = d;
                }
            }
            i = i + 1;
        }
        int depth = 0;
        while (depth <= maxDepth) {
            i = 0;
            while (i < this.prog.classes.size()) {
                ClassDecl cls = this.prog.classes.get(i);
                if (cls.isInterface || cls.isGenericTemplate || cls.isStatic || this.classDepth(cls) != depth) {
                    i = i + 1;
                    continue;
                }

                this.emitInterfaceVTables(cls);

                if (cls.vtable.size() > 0) {
                    this.out.appendString("static const ");
                    this.out.appendString(cls.name);
                    this.out.appendString("_VTable ");
                    this.out.appendString(cls.name);
                    this.out.appendString("_vtable = {\n");
                    int v = 0;
                    while (v < cls.vtable.size()) {
                        MethodDecl md = cls.vtable.get(v);
                        if (md.isAbstract) {
                            this.out.appendString("    NULL");
                        } else {
                            this.out.appendString("    (");
                            this.emitCType(md.returnType);
                            this.out.appendString(" (*)(");
                            this.out.appendString(cls.name);
                            this.out.appendByte('*');
                            int p = 0;
                            while (p < md.params.size()) {
                                this.out.appendString(", ");
                                this.emitCType(md.params.get(p).type);
                                p = p + 1;
                            }
                            this.out.appendString("))");
                            this.out.appendString(md.cName);
                        }
                        if (v + 1 < cls.vtable.size()) {
                            this.out.appendByte(',');
                        }
                        this.out.appendByte('\n');
                        v = v + 1;
                    }
                    this.out.appendString("};\n");
                }

                int ifaceCount = 0;
                int j = 0;
                while (j < this.prog.classes.size()) {
                    ClassDecl cand = this.prog.classes.get(j);
                    if (cand.isInterface && this.classImplementsIface(cls, cand)) {
                        ifaceCount = ifaceCount + 1;
                    }
                    j = j + 1;
                }
                if (ifaceCount > 0) {
                    this.out.appendString("static const RtTypeInfo* const ");
                    this.out.appendString(cls.name);
                    this.out.appendString("_ifaces[] = { ");
                    int emittedIf = 0;
                    j = 0;
                    while (j < this.prog.classes.size()) {
                        ClassDecl cand = this.prog.classes.get(j);
                        if (cand.isInterface && this.classImplementsIface(cls, cand)) {
                            if (emittedIf > 0) this.out.appendString(", ");
                            this.out.appendByte('&');
                            this.out.appendString(cand.name);
                            this.out.appendString("_type_info");
                            emittedIf = emittedIf + 1;
                        }
                        j = j + 1;
                    }
                    this.out.appendString(" };\n");

                    this.out.appendString("static const void* const ");
                    this.out.appendString(cls.name);
                    this.out.appendString("_iface_vtables[] = { ");
                    emittedIf = 0;
                    j = 0;
                    while (j < this.prog.classes.size()) {
                        ClassDecl cand = this.prog.classes.get(j);
                        if (cand.isInterface && this.classImplementsIface(cls, cand)) {
                            if (emittedIf > 0) this.out.appendString(", ");
                            this.out.appendByte('&');
                            this.out.appendString(cls.name);
                            this.out.appendByte('_');
                            this.out.appendString(cand.name);
                            this.out.appendString("_vtable");
                            emittedIf = emittedIf + 1;
                        }
                        j = j + 1;
                    }
                    this.out.appendString(" };\n");
                }

                int refCount = 0;
                ClassDecl cur = cls;
                while (cur != null) {
                    int f = 0;
                    while (f < cur.fields.size()) {
                        FieldDecl fld0 = cur.fields.get(f);
                        if (!fld0.isStatic && this.isRefType(fld0.type)) {
                            refCount = refCount + 1;
                        }
                        f = f + 1;
                    }
                    cur = cur.superClass;
                }

                String vtableRef = "NULL";
                if (cls.vtable.size() > 0) {
                    vtableRef = "&".concat(cls.name).concat("_vtable");
                }
                String superRef = "NULL";
                if (cls.superClass != null) {
                    superRef = "&".concat(cls.superClass.name).concat("_type_info");
                }
                String ifacesRef = "NULL";
                String ifaceVtRef = "NULL";
                if (ifaceCount > 0) {
                    ifacesRef = cls.name.concat("_ifaces");
                    ifaceVtRef = cls.name.concat("_iface_vtables");
                }

                if (refCount > 0) {
                    this.out.appendString("static const size_t ");
                    this.out.appendString(cls.name);
                    this.out.appendString("_ptr_offsets[] = {\n");
                    int emitted = 0;
                    cur = cls;
                    while (cur != null) {
                        int f = 0;
                        while (f < cur.fields.size()) {
                            FieldDecl fld = cur.fields.get(f);
                            if (!fld.isStatic && this.isRefType(fld.type)) {
                                this.out.appendString("    offsetof(");
                                this.out.appendString(cur.name);
                                this.out.appendString(", ");
                                this.out.appendString(fld.name);
                                if (this.isInterfaceType(fld.type)) {
                                    this.out.appendString(".obj");
                                }
                                this.out.appendByte(')');
                                emitted = emitted + 1;
                                if (emitted < refCount) {
                                    this.out.appendByte(',');
                                }
                                this.out.appendByte('\n');
                            }
                            f = f + 1;
                        }
                        cur = cur.superClass;
                    }
                    this.out.appendString("};\n");
                    this.out.appendString("static const RtTypeInfo ");
                    this.out.appendString(cls.name);
                    this.out.appendString("_type_info = { \"");
                    this.out.appendString(cls.name);
                    this.out.appendString("\", ");
                    this.out.appendInt(refCount);
                    this.out.appendString(", ");
                    this.out.appendString(cls.name);
                    this.out.appendString("_ptr_offsets, ");
                    this.out.appendString(vtableRef);
                    this.out.appendString(", ");
                    this.out.appendString(superRef);
                    this.out.appendString(", ");
                    this.out.appendInt(ifaceCount);
                    this.out.appendString(", ");
                    this.out.appendString(ifacesRef);
                    this.out.appendString(", ");
                    this.out.appendString(ifaceVtRef);
                    this.out.appendString(" };\n\n");
                } else {
                    this.out.appendString("static const RtTypeInfo ");
                    this.out.appendString(cls.name);
                    this.out.appendString("_type_info = { \"");
                    this.out.appendString(cls.name);
                    this.out.appendString("\", 0, NULL, ");
                    this.out.appendString(vtableRef);
                    this.out.appendString(", ");
                    this.out.appendString(superRef);
                    this.out.appendString(", ");
                    this.out.appendInt(ifaceCount);
                    this.out.appendString(", ");
                    this.out.appendString(ifacesRef);
                    this.out.appendString(", ");
                    this.out.appendString(ifaceVtRef);
                    this.out.appendString(" };\n\n");
                }
                i = i + 1;
            }
            depth = depth + 1;
        }
    }

    private void setupShadowFrame(MethodDecl md, boolean hasThis) {
        int slots = 0;
        if (hasThis) {
            slots = slots + 1;
        }
        if (md != null) {
            int p = 0;
            while (p < md.params.size()) {
                if (this.isRefType(md.params.get(p).type)) {
                    slots = slots + 1;
                }
                p = p + 1;
            }
            slots = slots + this.countRefVars(md.body);
        }
        this.gcTotalSlots = slots;
        this.gcNextSlot = 0;
        this.blockDepth = 0;
        this.loopDepth = 0;
        this.breakDepth = 0;

        if (slots > 0) {
            this.out.appendString("    void* _gc_slots[");
            this.out.appendInt(slots);
            this.out.appendString("];\n");
            this.out.appendString("    memset(_gc_slots, 0, sizeof(_gc_slots));\n");
            if (hasThis) {
                this.out.appendString("    _gc_slots[");
                this.out.appendInt(this.gcNextSlot);
                this.out.appendString("] = &this;\n");
                this.gcNextSlot = this.gcNextSlot + 1;
            }
            if (md != null) {
                int p = 0;
                while (p < md.params.size()) {
                    Param pm = md.params.get(p);
                    if (this.isRefType(pm.type)) {
                        this.out.appendString("    _gc_slots[");
                        this.out.appendInt(this.gcNextSlot);
                        this.out.appendString("] = &");
                        this.out.appendString(pm.name);
                        if (this.isInterfaceType(pm.type)) {
                            this.out.appendString(".obj");
                        }
                        this.out.appendString(";\n");
                        this.gcNextSlot = this.gcNextSlot + 1;
                    }
                    p = p + 1;
                }
            }
            this.out.appendString("    RtShadowFrame _gc_frame = { rt_shadow_stack, ");
            this.out.appendInt(slots);
            this.out.appendString(", _gc_slots };\n");
            this.out.appendString("    rt_shadow_stack = &_gc_frame;\n");
        }
    }

    private void emitConstructorDef(ClassDecl cls, MethodDecl ctor) {
        /* Class_init(Class* this, ...) */
        this.emitInitSig(cls, ctor);
        this.out.appendString(" {\n");
        this.out.appendString("    (void)this;\n");
        if (ctor != null) {
            int p = 0;
            while (p < ctor.params.size()) {
                this.out.appendString("    (void)");
                this.out.appendString(ctor.params.get(p).name);
                this.out.appendString(";\n");
                p = p + 1;
            }
        }
        this.setupShadowFrame(ctor, true);
        if (cls.superClass != null && (ctor == null || !ctor.hasSuperCall)) {
            this.out.appendString("    ");
            if (cls.superClass.constructors.size() > 1) {
                this.out.appendString(cls.superClass.name);
                this.out.appendString("_init__void((");
            } else {
                this.out.appendString(cls.superClass.name);
                this.out.appendString("_init((");
            }
            this.out.appendString(cls.superClass.name);
            this.out.appendString("*)this);\n");
        }
        int fi = 0;
        while (fi < cls.fields.size()) {
            FieldDecl fld = cls.fields.get(fi);
            if (!fld.isStatic && fld.initExpr != null) {
                this.out.appendString("    this->");
                this.out.appendString(fld.name);
                this.out.appendString(" = ");
                this.emitExprAs(fld.initExpr, fld.type);
                this.out.appendString(";\n");
            }
            fi = fi + 1;
        }
        if (ctor != null && ctor.body != null) {
            this.currentMethod = ctor;
            this.indent = 1;
            Stmt body = ctor.body;
            int s = 0;
            while (s < body.stmts.size()) {
                this.emitStmt(body.stmts.get(s));
                s = s + 1;
            }
            this.indent = 0;
            this.currentMethod = null;
        }
        if (this.gcTotalSlots > 0) {
            this.out.appendString("    rt_shadow_stack = _gc_frame.prev;\n");
        }
        this.out.appendString("}\n\n");

        /* Class_new(...) */
        if (!cls.isAbstract) {
            this.emitMethodSig(cls, ctor);
            this.out.appendString(" {\n");
            this.out.appendString("    ");
            this.out.appendString(cls.name);
            this.out.appendString("* this = (");
            this.out.appendString(cls.name);
            this.out.appendString("*)rt_alloc_instance(sizeof(");
            this.out.appendString(cls.name);
            this.out.appendString("), &");
            this.out.appendString(cls.name);
            this.out.appendString("_type_info);\n");
            this.out.appendString("    ");
            if (ctor != null) {
                this.out.appendString(ctor.cInitName);
            } else {
                this.out.appendString(cls.name);
                this.out.appendString("_init");
            }
            this.out.appendString("(this");
            if (ctor != null) {
                int p = 0;
                while (p < ctor.params.size()) {
                    this.out.appendString(", ");
                    this.out.appendString(ctor.params.get(p).name);
                    p = p + 1;
                }
            }
            this.out.appendString(");\n");
            this.out.appendString("    return this;\n}\n\n");
        }
    }

    public byte[] emit(String runtimeInclude) {
        this.out.appendString("/* Generated by Moka Stage 1 Compiler */\n");
        this.out.appendString("#include \"");
        this.out.appendString(runtimeInclude);
        this.out.appendString("\"\n\n");

        /* 1. Forward declarations */
        int i = 0;
        while (i < this.prog.classes.size()) {
            ClassDecl cls = this.prog.classes.get(i);
            if (!cls.isInterface && !cls.isGenericTemplate) {
                this.out.appendString("typedef struct ");
                this.out.appendString(cls.name);
                this.out.appendByte(' ');
                this.out.appendString(cls.name);
                this.out.appendString(";\n");
            }
            i = i + 1;
        }
        this.out.appendByte('\n');

        /* 1b. Interface fat-pointer types & dispatchers */
        this.emitInterfaceTypes();
        if (this.hasClass("Runnable")) {
            this.out.appendString("static inline int64_t rt_thread_spawn(Runnable r) {\n");
            this.out.appendString("    return rt_thread_spawn_raw(r.obj, r.vtable->run);\n");
            this.out.appendString("}\n\n");
        }

        /* 2. Struct definitions (ordered by inheritance depth) */
        int maxDepth = 0;
        i = 0;
        while (i < this.prog.classes.size()) {
            ClassDecl c0 = this.prog.classes.get(i);
            if (!c0.isInterface && !c0.isGenericTemplate) {
                int d = this.classDepth(c0);
                if (d > maxDepth) {
                    maxDepth = d;
                }
            }
            i = i + 1;
        }
        int depth = 0;
        while (depth <= maxDepth) {
            i = 0;
            while (i < this.prog.classes.size()) {
                ClassDecl cls = this.prog.classes.get(i);
                if (!cls.isInterface && !cls.isGenericTemplate && this.classDepth(cls) == depth) {
                    this.out.appendString("struct ");
                    this.out.appendString(cls.name);
                    this.out.appendString(" {\n");
                    if (cls.superClass != null) {
                        this.out.appendString("    ");
                        this.out.appendString(cls.superClass.name);
                        this.out.appendString(" base;\n");
                    } else {
                        this.out.appendString("    Obj header;\n");
                    }
                    int f = 0;
                    while (f < cls.fields.size()) {
                        FieldDecl fld = cls.fields.get(f);
                        if (!fld.isStatic) {
                            this.out.appendString("    ");
                            this.emitCType(fld.type);
                            this.out.appendByte(' ');
                            this.out.appendString(fld.name);
                            this.out.appendString(";\n");
                        }
                        f = f + 1;
                    }
                    this.out.appendString("};\n\n");
                }
                i = i + 1;
            }
            depth = depth + 1;
        }

        /* 2b. VTable struct definitions */
        this.emitVTableStructs();

        /* 2c. Static fields */
        i = 0;
        while (i < this.prog.classes.size()) {
            ClassDecl cls = this.prog.classes.get(i);
            if (!cls.isInterface && !cls.isGenericTemplate) {
                int f = 0;
                while (f < cls.fields.size()) {
                    FieldDecl fld = cls.fields.get(f);
                    if (fld.isStatic) {
                        this.out.appendString("static ");
                        this.emitCType(fld.type);
                        this.out.appendByte(' ');
                        this.out.appendString(cls.name);
                        this.out.appendString("__s_");
                        this.out.appendString(fld.name);
                        this.out.appendString(" = ");
                        this.emitZeroValue(fld.type);
                        this.out.appendString(";\n");
                    }
                    f = f + 1;
                }
            }
            i = i + 1;
        }
        this.out.appendByte('\n');

        /* 3. Prototypes */
        i = 0;
        while (i < this.prog.classes.size()) {
            ClassDecl cls = this.prog.classes.get(i);
            if (!cls.isInterface && !cls.isGenericTemplate) {
                if (cls.constructors.size() == 0) {
                    if (!cls.isStatic) {
                        this.emitInitSig(cls, null);
                        this.out.appendString(";\n");
                        if (!cls.isAbstract) {
                            this.emitMethodSig(cls, null);
                            this.out.appendString(";\n");
                        }
                    }
                } else {
                    int c = 0;
                    while (c < cls.constructors.size()) {
                        MethodDecl ctor = cls.constructors.get(c);
                        this.emitInitSig(cls, ctor);
                        this.out.appendString(";\n");
                        if (!cls.isAbstract) {
                            this.emitMethodSig(cls, ctor);
                            this.out.appendString(";\n");
                        }
                        c = c + 1;
                    }
                }
                int m = 0;
                while (m < cls.methods.size()) {
                    MethodDecl md = cls.methods.get(m);
                    if (!md.isNative && !md.isAbstract && !md.isGenericTemplate) {
                        this.emitMethodSig(cls, md);
                        this.out.appendString(";\n");
                    }
                    m = m + 1;
                }
            }
            i = i + 1;
        }
        this.out.appendByte('\n');

        if (this.hasClass("String")) {
            this.out.appendString("static inline String* rt_str_not_null(String* s) {\n");
            this.out.appendString("    if (s) return s;\n");
            this.out.appendString("    return String_new(rt_byte_array_from_literal(\"null\", 4));\n");
            this.out.appendString("}\n");
            this.out.appendString("static inline String* rt_obj_to_str(void* p) {\n");
            this.out.appendString("    if (p) return String_new(rt_byte_array_from_literal(\"<object>\", 8));\n");
            this.out.appendString("    return String_new(rt_byte_array_from_literal(\"null\", 4));\n");
            this.out.appendString("}\n\n");
        }

        /* 3b. VTable instances, GC Type Descriptors & Virtual Dispatchers */
        this.emitTypeInfos();
        this.emitVirtualDispatchers();

        /* 4. Definitions */
        i = 0;
        while (i < this.prog.classes.size()) {
            ClassDecl cls = this.prog.classes.get(i);
            if (cls.isInterface || cls.isGenericTemplate) {
                i = i + 1;
                continue;
            }

            if (cls.constructors.size() == 0) {
                if (!cls.isStatic) {
                    this.emitConstructorDef(cls, null);
                }
            } else {
                int c = 0;
                while (c < cls.constructors.size()) {
                    this.emitConstructorDef(cls, cls.constructors.get(c));
                    c = c + 1;
                }
            }

            int m = 0;
            while (m < cls.methods.size()) {
                MethodDecl md = cls.methods.get(m);
                if (!md.isNative && !md.isAbstract && !md.isGenericTemplate) {
                    this.emitMethodSig(cls, md);
                    this.out.appendString(" {\n");
                    this.currentMethod = md;
                    this.excDepth = 0;
                    this.methodHasTry = this.hasTryStmt(md.body);
                    this.indent = 1;
                    if (!md.isStatic) {
                        this.out.appendString("    (void)this;\n");
                    }
                    int p = 0;
                    while (p < md.params.size()) {
                        this.out.appendString("    (void)");
                        this.out.appendString(md.params.get(p).name);
                        this.out.appendString(";\n");
                        p = p + 1;
                    }
                    this.setupShadowFrame(md, !md.isStatic);
                    if (md.body != null) {
                        if (md.isSynchronized) {
                            Stmt syncWrap = new Stmt(StmtKind.SYNCHRONIZED(), md.line, md.col);
                            syncWrap.expr = new Expr(ExprKind.THIS(), md.line, md.col);
                            syncWrap.expr.inferredType = Type.makeResolvedClass(cls);
                            syncWrap.thenBranch = md.body;
                            this.emitStmt(syncWrap);
                        } else {
                            int s = 0;
                            while (s < md.body.stmts.size()) {
                                this.emitStmt(md.body.stmts.get(s));
                                s = s + 1;
                            }
                        }
                    }
                    if (this.gcTotalSlots > 0) {
                        this.out.appendString("    rt_shadow_stack = _gc_frame.prev;\n");
                    }
                    if (md.returnType.kind != TypeKind.VOID()) {
                        this.out.appendString("    return ");
                        this.emitZeroValue(md.returnType);
                        this.out.appendString(";\n");
                    }
                    this.indent = 0;
                    this.currentMethod = null;
                    this.methodHasTry = false;
                    this.out.appendString("}\n\n");
                }
                m = m + 1;
            }
            i = i + 1;
        }

        /* 5. Entry point */
        MethodDecl entry = this.findEntryMain();
        if (entry != null) {
            this.out.appendString("int main(int argc, char** argv) {\n");
            this.out.appendString("    rt_init(argc, argv);\n");
            i = 0;
            while (i < this.prog.classes.size()) {
                ClassDecl cls = this.prog.classes.get(i);
                if (!cls.isInterface && !cls.isGenericTemplate) {
                    int f = 0;
                    while (f < cls.fields.size()) {
                        FieldDecl fld = cls.fields.get(f);
                        if (fld.isStatic && this.isRefType(fld.type)) {
                            this.out.appendString("    rt_gc_add_static_root(&");
                            this.out.appendString(cls.name);
                            this.out.appendString("__s_");
                            this.out.appendString(fld.name);
                            if (this.isInterfaceType(fld.type)) {
                                this.out.appendString(".obj");
                            }
                            this.out.appendString(");\n");
                        }
                        if (fld.isStatic && fld.initExpr != null) {
                            this.out.appendString("    ");
                            this.out.appendString(cls.name);
                            this.out.appendString("__s_");
                            this.out.appendString(fld.name);
                            this.out.appendString(" = ");
                            this.emitExprAs(fld.initExpr, fld.type);
                            this.out.appendString(";\n");
                        }
                        f = f + 1;
                    }
                }
                i = i + 1;
            }
            if (entry.returnType.kind == TypeKind.INT()) {
                this.out.appendString("    int32_t exit_code = Main_main();\n");
                this.out.appendString("    rt_shutdown();\n");
                this.out.appendString("    return (int)exit_code;\n");
            } else {
                this.out.appendString("    Main_main();\n");
                this.out.appendString("    rt_shutdown();\n");
                this.out.appendString("    return 0;\n");
            }
            this.out.appendString("}\n");
        }

        return this.out.toBytes();
    }
}
