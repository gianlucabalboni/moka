public class Main {
    private static void printUsage() {
        Console.eprintln("Usage: mokac <file1.moka> [file2.moka ...] [-o <output>] [-r|--run] [--emit-c] [--keep-c] [--no-stdlib] [--std-dir <dir>] [--runtime <header>] [--runtime-dir <dir>]");
    }

    private static boolean endsWith(String s, String suffix) {
        if (s.length() < suffix.length()) {
            return false;
        }
        String tail = s.substring(s.length() - suffix.length(), s.length());
        return tail.equals(suffix);
    }

    private static boolean fileExists(String path) {
        return Io.readFileBytes(path) != null;
    }

    private static String detectStdDir() {
        if (Main.fileExists("std/String.moka")) {
            return "std/";
        }
        if (Main.fileExists("stage1/std/String.moka")) {
            return "stage1/std/";
        }
        return "";
    }

    private static String detectRuntimeDir() {
        if (Main.fileExists("runtime/runtime.h")) {
            return "runtime";
        }
        if (Main.fileExists("stage1/runtime/runtime.h")) {
            return "stage1/runtime";
        }
        return "runtime";
    }

    private static String dirName(String path) {
        int lastSlash = -1;
        int i = 0;
        while (i < path.length()) {
            if (path.byteAt(i) == '/') {
                lastSlash = i;
            }
            i = i + 1;
        }
        if (lastSlash < 0) {
            return "";
        }
        return path.substring(0, lastSlash + 1);
    }

    private static String normalizePath(String path) {
        String[] segs = new String[64];
        int segCount = 0;
        boolean abs = (path.length() > 0 && path.byteAt(0) == '/');
        int start = 0;
        int i = 0;
        while (i <= path.length()) {
            if (i == path.length() || path.byteAt(i) == '/') {
                if (i > start) {
                    String part = path.substring(start, i);
                    if (part.equals(".")) {
                        /* skip */
                    } else if (part.equals("..")) {
                        if (segCount > 0 && !segs[segCount - 1].equals("..")) {
                            segCount = segCount - 1;
                        } else if (!abs) {
                            segs[segCount] = part;
                            segCount = segCount + 1;
                        }
                    } else {
                        segs[segCount] = part;
                        segCount = segCount + 1;
                    }
                }
                start = i + 1;
            }
            i = i + 1;
        }
        ByteBuffer buf = new ByteBuffer(path.length() + 1);
        if (abs) {
            buf.appendByte('/');
        }
        int k = 0;
        while (k < segCount) {
            if (k > 0) {
                buf.appendByte('/');
            }
            buf.appendString(segs[k]);
            k = k + 1;
        }
        if (buf.length() == 0) {
            return ".";
        }
        return buf.toString();
    }

    public static int main() {
        int argc = Io.argc();
        String[] userInputs = new String[argc];
        int userCount = 0;

        String outPath = "";
        String runtimeHeader = "runtime.h";
        String runtimeDir = "";
        String stdDir = "";
        boolean emitC = false;
        boolean keepC = false;
        boolean noStdlib = false;
        boolean runAfter = false;
        boolean explicitOut = false;
        boolean hasStringMoka = false;

        int i = 1;
        while (i < argc) {
            String arg = Io.argv(i);
            if (arg.equals("-h") || arg.equals("--help")) {
                Main.printUsage();
                return 0;
            } else if (arg.equals("-o")) {
                if (i + 1 >= argc) {
                    Console.eprintln("mokac error: missing filename after '-o'");
                    return 1;
                }
                i = i + 1;
                outPath = Io.argv(i);
                explicitOut = true;
            } else if (arg.equals("-r") || arg.equals("--run")) {
                runAfter = true;
            } else if (arg.equals("--emit-c")) {
                emitC = true;
            } else if (arg.equals("--keep-c")) {
                keepC = true;
            } else if (arg.equals("--no-stdlib")) {
                noStdlib = true;
            } else if (arg.equals("--std-dir")) {
                if (i + 1 >= argc) {
                    Console.eprintln("mokac error: missing directory after '--std-dir'");
                    return 1;
                }
                i = i + 1;
                stdDir = Io.argv(i);
                if (stdDir.length() > 0 && stdDir.byteAt(stdDir.length() - 1) != '/') {
                    stdDir = stdDir.concat("/");
                }
            } else if (arg.equals("--runtime")) {
                if (i + 1 >= argc) {
                    Console.eprintln("mokac error: missing header path after '--runtime'");
                    return 1;
                }
                i = i + 1;
                runtimeHeader = Io.argv(i);
            } else if (arg.equals("--runtime-dir")) {
                if (i + 1 >= argc) {
                    Console.eprintln("mokac error: missing directory after '--runtime-dir'");
                    return 1;
                }
                i = i + 1;
                runtimeDir = Io.argv(i);
            } else if (arg.length() > 0 && arg.byteAt(0) == '-') {
                Console.eprintln("mokac error: unknown option '".concat(arg).concat("'"));
                return 1;
            } else {
                if (Main.endsWith(arg, "String.moka")) {
                    hasStringMoka = true;
                }
                userInputs[userCount] = arg;
                userCount = userCount + 1;
            }
            i = i + 1;
        }

        if (userCount == 0) {
            Main.printUsage();
            return 1;
        }

        if (runtimeDir.equals("")) {
            runtimeDir = Main.detectRuntimeDir();
        }

        if (outPath.equals("")) {
            if (emitC) {
                outPath = "out.c";
            } else if (runAfter) {
                outPath = "/tmp/moka_run_tmp";
            } else {
                outPath = "a.out";
            }
        }
        if (Main.endsWith(outPath, ".c")) {
            emitC = true;
        }

        if (stdDir.equals("")) {
            stdDir = Main.detectStdDir();
        }
        String[] queue = new String[64];
        int queueCount = 0;

        if (!noStdlib && !hasStringMoka && !stdDir.equals("")) {
            queue[queueCount] = stdDir.concat("String.moka");
            queueCount = queueCount + 1;
            queue[queueCount] = stdDir.concat("Console.moka");
            queueCount = queueCount + 1;
            queue[queueCount] = stdDir.concat("ByteBuffer.moka");
            queueCount = queueCount + 1;
            queue[queueCount] = stdDir.concat("Io.moka");
            queueCount = queueCount + 1;
            queue[queueCount] = stdDir.concat("Exception.moka");
            queueCount = queueCount + 1;
            queue[queueCount] = stdDir.concat("Runnable.moka");
            queueCount = queueCount + 1;
            queue[queueCount] = stdDir.concat("Thread.moka");
            queueCount = queueCount + 1;
            queue[queueCount] = stdDir.concat("Mutex.moka");
            queueCount = queueCount + 1;
        }

        int u = 0;
        while (u < userCount) {
            if (queueCount >= queue.length) {
                String[] nq = new String[queue.length * 2];
                int k = 0;
                while (k < queueCount) {
                    nq[k] = queue[k];
                    k = k + 1;
                }
                queue = nq;
            }
            queue[queueCount] = userInputs[u];
            queueCount = queueCount + 1;
            u = u + 1;
        }

        String[] loaded = new String[64];
        int loadedCount = 0;

        Program prog = new Program();
        int f = 0;
        while (f < queueCount) {
            String path = Main.normalizePath(queue[f]);
            f = f + 1;

            boolean seen = false;
            int s = 0;
            while (s < loadedCount) {
                if (loaded[s].equals(path)) {
                    seen = true;
                    break;
                }
                s = s + 1;
            }
            if (seen) {
                continue;
            }

            if (loadedCount >= loaded.length) {
                String[] nl = new String[loaded.length * 2];
                int k = 0;
                while (k < loadedCount) {
                    nl[k] = loaded[k];
                    k = k + 1;
                }
                loaded = nl;
            }
            loaded[loadedCount] = path;
            loadedCount = loadedCount + 1;

            byte[] src = Io.readFileBytes(path);
            if (src == null) {
                Console.eprintln("mokac error: cannot read input file '".concat(path).concat("'"));
                return 1;
            }
            Lexer lex = new Lexer(path, src);
            Parser parser = new Parser(lex);
            if (!parser.parseClasses(prog.classes)) {
                return 1;
            }

            String baseDir = Main.dirName(path);
            int imp = 0;
            while (imp < parser.importCount) {
                String resolved = "";
                if (parser.importIsStd[imp]) {
                    resolved = stdDir.concat(parser.importPaths[imp]);
                } else {
                    resolved = baseDir.concat(parser.importPaths[imp]);
                }
                if (queueCount >= queue.length) {
                    String[] nq = new String[queue.length * 2];
                    int k = 0;
                    while (k < queueCount) {
                        nq[k] = queue[k];
                        k = k + 1;
                    }
                    queue = nq;
                }
                queue[queueCount] = resolved;
                queueCount = queueCount + 1;
                imp = imp + 1;
            }
        }

        Sema sema = new Sema(prog);
        if (!sema.analyze()) {
            return 1;
        }

        Codegen cg = new Codegen(prog);
        byte[] cCode = cg.emit(runtimeHeader);

        if (emitC) {
            if (!Io.writeFileBytes(outPath, cCode)) {
                Console.eprintln("mokac error: cannot write output file '".concat(outPath).concat("'"));
                return 1;
            }
            return 0;
        }

        String cPath = outPath.concat(".c");
        if (!Io.writeFileBytes(cPath, cCode)) {
            Console.eprintln("mokac error: cannot write temporary C file '".concat(cPath).concat("'"));
            return 1;
        }

        String cmd = "cc -std=c11 -O2 -Wall -Wextra -Werror -pthread -I"
            .concat(runtimeDir)
            .concat(" ")
            .concat(cPath)
            .concat(" -o ")
            .concat(outPath)
            .concat(" -lm");

        int rc = Io.exec(cmd);
        if (!keepC) {
            Io.removeFile(cPath);
        }
        if (rc != 0) {
            Console.eprintln("mokac error: C compilation failed");
            return 1;
        }
        if (runAfter) {
            String runCmd = outPath;
            boolean hasSlash = false;
            int si = 0;
            while (si < outPath.length()) {
                if (outPath.byteAt(si) == '/') {
                    hasSlash = true;
                    break;
                }
                si = si + 1;
            }
            if (!hasSlash) {
                runCmd = "./".concat(outPath);
            }
            int runRc = Io.exec(runCmd);
            if (!explicitOut) {
                Io.removeFile(outPath);
            }
            if (runRc != 0) {
                return 1;
            }
        }
        return 0;
    }
}
