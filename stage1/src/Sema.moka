/**
 * Sema.moka — Semantic analyzer, monomorphizer, and AST desugaring pass.
 *
 * Analysis pipeline:
 * 1. Class & interface hierarchy resolution (checkClassHierarchy):
 *    resolves superclasses, superinterfaces, flattens inherited interface methods
 *    (flattenInterfaceMethods), and checks for inheritance cycles.
 * 2. VTable & interface verification: builds class VTables and verifies all
 *    abstract and interface methods are implemented with compatible signatures.
 * 3. Generic monomorphization (instantiateClass / instantiateMethod):
 *    generic templates (isGenericTemplate) are skipped during template passes and
 *    instantiated + typechecked on demand for each concrete type argument tuple
 *    (supporting both reference and unboxed primitive types).
 * 4. Statement/expression typechecking & desugaring:
 *    - StmtKind.FOREACH is desugared into a standard FOR loop over T[] or Iterator<T>.
 *    - Checks numeric promotions, RTTI casts/instanceof, exceptions, and `final`.
 */
public class VarBinding {
    public String name;
    public Type type;
    public boolean isFinal;

    public VarBinding(String name, Type type) {
        this.name = name;
        this.type = type;
        this.isFinal = false;
    }
}

public class Scope {
    public Scope parent;
    private VarBinding[] vars;
    private int count;

    public Scope(Scope parent) {
        this.parent = parent;
        this.vars = new VarBinding[8];
        this.count = 0;
    }

    public boolean hasLocal(String name) {
        int i = 0;
        while (i < this.count) {
            if (this.vars[i].name.equals(name)) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    public void add(String name, Type type) {
        this.addFinal(name, type, false);
    }

    public void addFinal(String name, Type type, boolean isFinal) {
        if (this.count >= this.vars.length) {
            VarBinding[] next = new VarBinding[this.vars.length * 2];
            int i = 0;
            while (i < this.count) {
                next[i] = this.vars[i];
                i = i + 1;
            }
            this.vars = next;
        }
        VarBinding vb = new VarBinding(name, type);
        vb.isFinal = isFinal;
        this.vars[this.count] = vb;
        this.count = this.count + 1;
    }

    public boolean lookupFinal(String name) {
        Scope sc = this;
        while (sc != null) {
            int i = 0;
            while (i < sc.count) {
                if (sc.vars[i].name.equals(name)) {
                    return sc.vars[i].isFinal;
                }
                i = i + 1;
            }
            sc = sc.parent;
        }
        return false;
    }

    public Type lookup(String name) {
        Scope sc = this;
        while (sc != null) {
            int i = 0;
            while (i < sc.count) {
                if (sc.vars[i].name.equals(name)) {
                    return sc.vars[i].type;
                }
                i = i + 1;
            }
            sc = sc.parent;
        }
        return null;
    }
}

public class Sema {
    private Program prog;
    private ClassDecl currentClass;
    private MethodDecl currentMethod;
    private Scope scope;
    private int loopDepth;
    private int breakDepth;
    private int foreachCounter;
    public boolean hadError;

    private Type tyVoid;
    private Type tyInt;
    private Type tyByte;
    private Type tyBoolean;
    private Type tyNull;
    private Type tyLong;
    private Type tyDouble;
    private Type tyFloat;
    private Type tyChar;
    private Type expectedExprType;
    private ClassList pendingClasses;
    private MethodList pendingMethods;

    public Sema(Program prog) {
        this.prog = prog;
        this.loopDepth = 0;
        this.breakDepth = 0;
        this.foreachCounter = 0;
        this.hadError = false;
        this.tyVoid = new Type(TypeKind.VOID());
        this.tyInt = new Type(TypeKind.INT());
        this.tyByte = new Type(TypeKind.BYTE());
        this.tyBoolean = new Type(TypeKind.BOOLEAN());
        this.tyNull = new Type(TypeKind.NULL());
        this.tyLong = new Type(TypeKind.LONG());
        this.tyDouble = new Type(TypeKind.DOUBLE());
        this.tyFloat = new Type(TypeKind.FLOAT());
        this.tyChar = new Type(TypeKind.CHAR());
        this.expectedExprType = null;
        this.pendingClasses = new ClassList();
        this.pendingMethods = new MethodList();
    }

    private void errorAt(int line, int col, String msg) {
        if (this.hadError) {
            return;
        }
        this.hadError = true;
        Console.eprintln("line ".concat(String.fromInt(line))
            .concat(":").concat(String.fromInt(col))
            .concat(": semantic error: ").concat(msg));
    }

    private void pushScope() {
        this.scope = new Scope(this.scope);
    }

    private void popScope() {
        if (this.scope != null) {
            this.scope = this.scope.parent;
        }
    }

    private void scopeDeclare(String name, Type type, int line, int col) {
        this.scopeDeclareFinal(name, type, false, line, col);
    }

    private void scopeDeclareFinal(String name, Type type, boolean isFinal, int line, int col) {
        if (this.scope.hasLocal(name)) {
            this.errorAt(line, col, "duplicate variable '".concat(name).concat("' in scope"));
            return;
        }
        this.scope.addFinal(name, type, isFinal);
    }

    private ClassDecl findClass(String name) {
        int i = 0;
        while (i < this.prog.classes.size()) {
            ClassDecl c = this.prog.classes.get(i);
            if (c.name.equals(name)) {
                return c;
            }
            i = i + 1;
        }
        return null;
    }

    private FieldDecl findField(ClassDecl cls, String name) {
        int i = 0;
        while (i < cls.fields.size()) {
            FieldDecl f = cls.fields.get(i);
            if (f.name.equals(name)) {
                return f;
            }
            i = i + 1;
        }
        return null;
    }

    private MethodDecl findMethod(ClassDecl cls, String name) {
        int i = 0;
        while (i < cls.methods.size()) {
            MethodDecl m = cls.methods.get(i);
            if (m.name.equals(name)) {
                return m;
            }
            i = i + 1;
        }
        return null;
    }

    private MethodDecl findMethodInHierarchy(ClassDecl cls, String name) {
        ClassDecl c = cls;
        while (c != null) {
            MethodDecl m = this.findMethod(c, name);
            if (m != null) {
                return m;
            }
            c = c.superClass;
        }
        return null;
    }

    private ClassDecl findFieldOwner(ClassDecl cls, String name) {
        ClassDecl c = cls;
        while (c != null) {
            if (this.findField(c, name) != null) {
                return c;
            }
            c = c.superClass;
        }
        return null;
    }

    private boolean ifaceExtends(ClassDecl iface, ClassDecl target, int depth) {
        if (iface == target) {
            return true;
        }
        if (depth > 64) {
            return false;
        }
        int i = 0;
        while (i < iface.impls.size()) {
            if (this.ifaceExtends(iface.impls.get(i), target, depth + 1)) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    private boolean isSubtype(ClassDecl sub, ClassDecl sup) {
        if (sup.isInterface) {
            if (sub.isInterface) {
                return this.ifaceExtends(sub, sup, 0);
            }
            ClassDecl c = sub;
            while (c != null) {
                int i = 0;
                while (i < c.impls.size()) {
                    if (this.ifaceExtends(c.impls.get(i), sup, 0)) {
                        return true;
                    }
                    i = i + 1;
                }
                c = c.superClass;
            }
            return false;
        }
        ClassDecl c = sub;
        while (c != null) {
            if (c == sup) {
                return true;
            }
            c = c.superClass;
        }
        return false;
    }

    private Type substType(Type t, String[] params, Type[] args, int paramCount) {
        if (t == null) {
            return null;
        }
        if (t.kind == TypeKind.ARRAY()) {
            return Type.makeArray(this.substType(t.elem, params, args, paramCount));
        }
        if (t.kind == TypeKind.CLASS()) {
            if (t.typeArgCount == 0 && t.resolvedClass == null) {
                int i = 0;
                while (i < paramCount) {
                    if (params[i].equals(t.className)) {
                        return args[i];
                    }
                    i = i + 1;
                }
            }
            Type nt = Type.makeClass(t.className);
            if (t.typeArgCount == 0) {
                nt.resolvedClass = t.resolvedClass;
            }
            int i = 0;
            while (i < t.typeArgCount) {
                nt.addTypeArg(this.substType(t.typeArgs[i], params, args, paramCount));
                i = i + 1;
            }
            return nt;
        }
        return new Type(t.kind);
    }

    private Expr cloneExpr(Expr e, String[] params, Type[] args, int paramCount) {
        if (e == null) {
            return null;
        }
        Expr c = new Expr(e.kind, e.line, e.col);
        c.intVal = e.intVal;
        c.charVal = e.charVal;
        c.boolVal = e.boolVal;
        c.strBytes = e.strBytes;
        c.name = e.name;
        c.op = e.op;
        c.left = this.cloneExpr(e.left, params, args, paramCount);
        c.right = this.cloneExpr(e.right, params, args, paramCount);
        c.elemType = this.substType(e.elemType, params, args, paramCount);
        c.isDiamond = e.isDiamond;
        int i = 0;
        while (i < e.typeArgCount) {
            c.addTypeArg(this.substType(e.typeArgs[i], params, args, paramCount));
            i = i + 1;
        }
        if (e.args != null) {
            c.args = new ExprList();
            int a = 0;
            while (a < e.args.size()) {
                c.args.add(this.cloneExpr(e.args.get(a), params, args, paramCount));
                a = a + 1;
            }
        }
        return c;
    }

    private Stmt cloneStmt(Stmt s, String[] params, Type[] args, int paramCount) {
        if (s == null) {
            return null;
        }
        Stmt c = new Stmt(s.kind, s.line, s.col);
        c.varType = this.substType(s.varType, params, args, paramCount);
        c.varName = s.varName;
        c.expr = this.cloneExpr(s.expr, params, args, paramCount);
        c.thenBranch = this.cloneStmt(s.thenBranch, params, args, paramCount);
        c.elseBranch = this.cloneStmt(s.elseBranch, params, args, paramCount);
        c.initStmt = this.cloneStmt(s.initStmt, params, args, paramCount);
        c.stepExpr = this.cloneExpr(s.stepExpr, params, args, paramCount);
        c.intVal = s.intVal;
        c.isFinal = s.isFinal;
        if (s.stmts != null) {
            c.stmts = new StmtList();
            int i = 0;
            while (i < s.stmts.size()) {
                c.stmts.add(this.cloneStmt(s.stmts.get(i), params, args, paramCount));
                i = i + 1;
            }
        }
        return c;
    }

    private ClassDecl instantiateClass(ClassDecl tmpl, Type[] args, int argCount, int line, int col) {
        ByteBuffer nb = new ByteBuffer(32);
        nb.appendString(tmpl.name);
        int i = 0;
        while (i < argCount) {
            nb.appendString("__");
            nb.appendString(this.mangleType(args[i]));
            i = i + 1;
        }
        String mangledName = nb.toString();
        ClassDecl existing = this.findClass(mangledName);
        if (existing != null) {
            return existing;
        }

        ClassDecl inst = new ClassDecl(mangledName, tmpl.line, tmpl.col);
        inst.isInterface = tmpl.isInterface;
        inst.isAbstract = tmpl.isAbstract;
        inst.isFinal = tmpl.isFinal;
        inst.isGenericTemplate = false;
        inst.genericArgs = new Type[argCount];
        inst.genericArgCount = argCount;
        i = 0;
        while (i < argCount) {
            inst.genericArgs[i] = args[i];
            i = i + 1;
        }
        this.prog.classes.add(inst);

        if (tmpl.superType != null) {
            Type st = this.substType(tmpl.superType, tmpl.typeParams, args, tmpl.typeParamCount);
            if (!this.resolveType(st, line, col)) {
                return inst;
            }
            if (st.resolvedClass.isInterface) {
                this.errorAt(tmpl.line, tmpl.col, "cannot extend interface '".concat(st.resolvedClass.name).concat("'"));
                return inst;
            }
            if (st.resolvedClass.isFinal) {
                this.errorAt(tmpl.line, tmpl.col, "cannot inherit from final class '".concat(st.resolvedClass.name).concat("'"));
                return inst;
            }
            inst.superType = st;
            inst.superClass = st.resolvedClass;
            inst.superName = inst.superClass.name;
        }

        i = 0;
        while (i < tmpl.implCount) {
            Type it = tmpl.implTypes[i];
            if (it == null) {
                it = Type.makeClass(tmpl.implNames[i]);
            } else {
                it = this.substType(it, tmpl.typeParams, args, tmpl.typeParamCount);
            }
            if (!this.resolveType(it, line, col)) {
                return inst;
            }
            if (!it.resolvedClass.isInterface) {
                this.errorAt(tmpl.line, tmpl.col, "cannot implement non-interface class '".concat(it.resolvedClass.name).concat("'"));
                return inst;
            }
            inst.impls.add(it.resolvedClass);
            i = i + 1;
        }

        int f = 0;
        while (f < tmpl.fields.size()) {
            FieldDecl fld = tmpl.fields.get(f);
            FieldDecl nf = new FieldDecl(
                this.substType(fld.type, tmpl.typeParams, args, tmpl.typeParamCount),
                fld.name, fld.isStatic, fld.line, fld.col);
            nf.isFinal = fld.isFinal;
            nf.initExpr = this.cloneExpr(fld.initExpr, tmpl.typeParams, args, tmpl.typeParamCount);
            if (!this.resolveType(nf.type, nf.line, nf.col)) {
                return inst;
            }
            inst.fields.add(nf);
            f = f + 1;
        }

        int c = 0;
        while (c < tmpl.constructors.size()) {
            MethodDecl ctor = tmpl.constructors.get(c);
            MethodDecl nc = new MethodDecl(inst.name, this.tyVoid, true, false, false, ctor.line, ctor.col);
            nc.owner = inst;
            int p = 0;
            while (p < ctor.params.size()) {
                Param pm = ctor.params.get(p);
                Type pt = this.substType(pm.type, tmpl.typeParams, args, tmpl.typeParamCount);
                if (!this.resolveType(pt, pm.line, pm.col)) {
                    return inst;
                }
                nc.params.add(new Param(pt, pm.name, pm.line, pm.col));
                p = p + 1;
            }
            nc.body = this.cloneStmt(ctor.body, tmpl.typeParams, args, tmpl.typeParamCount);
            inst.constructors.add(nc);
            c = c + 1;
        }

        int m = 0;
        while (m < tmpl.methods.size()) {
            MethodDecl md = tmpl.methods.get(m);
            Type retTy = md.returnType;
            if (!md.isGenericTemplate) {
                retTy = this.substType(md.returnType, tmpl.typeParams, args, tmpl.typeParamCount);
            }
            MethodDecl nm = new MethodDecl(
                md.name, retTy,
                false, md.isStatic, md.isNative, md.line, md.col);
            nm.isAbstract = md.isAbstract;
            nm.isFinal = md.isFinal;
            nm.owner = inst;
            nm.typeParams = md.typeParams;
            nm.typeParamCount = md.typeParamCount;
            nm.isGenericTemplate = md.isGenericTemplate;
            if (!nm.isGenericTemplate && !this.resolveType(nm.returnType, nm.line, nm.col)) {
                return inst;
            }
            int p = 0;
            while (p < md.params.size()) {
                Param pm = md.params.get(p);
                Type pt = this.substType(pm.type, tmpl.typeParams, args, tmpl.typeParamCount);
                if (!nm.isGenericTemplate && !this.resolveType(pt, pm.line, pm.col)) {
                    return inst;
                }
                nm.params.add(new Param(pt, pm.name, pm.line, pm.col));
                p = p + 1;
            }
            nm.body = this.cloneStmt(md.body, tmpl.typeParams, args, tmpl.typeParamCount);
            inst.methods.add(nm);
            m = m + 1;
        }

        this.assignMangledNamesForClass(inst);
        if (!inst.isInterface) {
            if (!this.buildVTableForClass(inst)) {
                return inst;
            }
            if (!this.verifyInterfacesForClass(inst)) {
                return inst;
            }
        } else {
            this.flattenInterfaceMethods(inst, 0);
        }
        this.pendingClasses.add(inst);
        return inst;
    }

    private boolean flattenInterfaceMethods(ClassDecl iface, int depth) {
        if (depth > 64) {
            this.errorAt(iface.line, iface.col,
                "cyclic interface inheritance involving '".concat(iface.name).concat("'"));
            return false;
        }
        int k = 0;
        while (k < iface.impls.size()) {
            ClassDecl parent = iface.impls.get(k);
            if (!this.flattenInterfaceMethods(parent, depth + 1)) {
                return false;
            }
            int m = 0;
            while (m < parent.methods.size()) {
                MethodDecl pm = parent.methods.get(m);
                boolean found = false;
                int j = 0;
                while (j < iface.methods.size()) {
                    MethodDecl im = iface.methods.get(j);
                    if (im.name.equals(pm.name) && this.sameParamTypes(im, pm)) {
                        if (!this.typesEqual(im.returnType, pm.returnType)) {
                            this.errorAt(im.line, im.col,
                                "method '".concat(iface.name).concat(".").concat(im.name)
                                .concat("' has incompatible return type with superinterface '")
                                .concat(parent.name).concat("'"));
                            return false;
                        }
                        found = true;
                        break;
                    }
                    j = j + 1;
                }
                if (!found) {
                    iface.methods.add(pm);
                }
                m = m + 1;
            }
            k = k + 1;
        }
        return true;
    }

    private boolean resolveType(Type ty, int line, int col) {
        if (ty == null) {
            return true;
        }
        if (ty.kind == TypeKind.CLASS()) {
            int i = 0;
            while (i < ty.typeArgCount) {
                if (!this.resolveType(ty.typeArgs[i], line, col)) {
                    return false;
                }
                i = i + 1;
            }
            if (ty.resolvedClass == null) {
                ClassDecl cls = this.findClass(ty.className);
                if (cls == null) {
                    this.errorAt(line, col, "unknown type '".concat(ty.className).concat("'"));
                    return false;
                }
                if (cls.isGenericTemplate) {
                    if (ty.typeArgCount != cls.typeParamCount) {
                        this.errorAt(line, col, "generic type '".concat(cls.name)
                            .concat("' expects ").concat(String.fromInt(cls.typeParamCount))
                            .concat(" type argument(s), got ").concat(String.fromInt(ty.typeArgCount)));
                        return false;
                    }
                    ClassDecl inst = this.instantiateClass(cls, ty.typeArgs, ty.typeArgCount, line, col);
                    if (this.hadError) return false;
                    ty.resolvedClass = inst;
                    ty.className = inst.name;
                } else {
                    if (ty.typeArgCount > 0) {
                        this.errorAt(line, col, "type '".concat(cls.name).concat("' is not generic"));
                        return false;
                    }
                    ty.resolvedClass = cls;
                }
            }
        } else if (ty.kind == TypeKind.ARRAY()) {
            return this.resolveType(ty.elem, line, col);
        }
        return true;
    }

    private boolean isIntegral(Type ty) {
        return ty != null && (ty.kind == TypeKind.INT() ||
                              ty.kind == TypeKind.BYTE() ||
                              ty.kind == TypeKind.CHAR() ||
                              ty.kind == TypeKind.LONG());
    }

    private boolean isNumeric(Type ty) {
        return ty != null && (ty.kind == TypeKind.INT() ||
                              ty.kind == TypeKind.BYTE() ||
                              ty.kind == TypeKind.CHAR() ||
                              ty.kind == TypeKind.LONG() ||
                              ty.kind == TypeKind.FLOAT() ||
                              ty.kind == TypeKind.DOUBLE());
    }

    private int numericRank(Type ty) {
        if (ty.kind == TypeKind.BYTE())   return 1;
        if (ty.kind == TypeKind.CHAR())   return 1;
        if (ty.kind == TypeKind.INT())    return 2;
        if (ty.kind == TypeKind.LONG())   return 3;
        if (ty.kind == TypeKind.FLOAT())  return 4;
        if (ty.kind == TypeKind.DOUBLE()) return 5;
        return 0;
    }

    private Type promoteNumeric(Type a, Type b) {
        int ra = this.numericRank(a);
        int rb = this.numericRank(b);
        if (ra == 5 || rb == 5) return this.tyDouble;
        if (ra == 4 || rb == 4) return this.tyFloat;
        if (ra == 3 || rb == 3) return this.tyLong;
        return this.tyInt;
    }

    private boolean isStringType(Type ty) {
        return ty != null && ty.kind == TypeKind.CLASS() &&
               ty.resolvedClass != null && ty.resolvedClass.name.equals("String");
    }

    private boolean isRefType(Type ty) {
        return ty != null && (ty.kind == TypeKind.CLASS() ||
                              ty.kind == TypeKind.ARRAY() ||
                              ty.kind == TypeKind.NULL());
    }

    private boolean typesEqual(Type a, Type b) {
        if (a == null || b == null || a.kind != b.kind) {
            return false;
        }
        if (a.kind == TypeKind.CLASS()) {
            return a.resolvedClass == b.resolvedClass;
        }
        if (a.kind == TypeKind.ARRAY()) {
            return this.typesEqual(a.elem, b.elem);
        }
        return true;
    }

    private boolean exprAssignable(Type target, Expr valExpr) {
        Type val = valExpr.inferredType;
        if (target == null || val == null) {
            return false;
        }
        if (this.typesEqual(target, val)) {
            return true;
        }
        if (target.kind == TypeKind.CLASS() && val.kind == TypeKind.CLASS()) {
            return this.isSubtype(val.resolvedClass, target.resolvedClass);
        }
        if ((target.kind == TypeKind.INT() || target.kind == TypeKind.BYTE() || target.kind == TypeKind.CHAR()) &&
            (val.kind == TypeKind.INT() || val.kind == TypeKind.BYTE() || val.kind == TypeKind.CHAR())) {
            return true;
        }
        if (this.isNumeric(target) && this.isNumeric(val)) {
            int rt = this.numericRank(target);
            int rv = this.numericRank(val);
            if (rv <= rt) {
                return true;
            }
        }
        if (val.kind == TypeKind.NULL() &&
            (target.kind == TypeKind.CLASS() || target.kind == TypeKind.ARRAY())) {
            return true;
        }
        return false;
    }

    private String typeName(Type ty) {
        if (ty == null) return "<unknown>";
        if (ty.kind == TypeKind.VOID())    return "void";
        if (ty.kind == TypeKind.INT())     return "int";
        if (ty.kind == TypeKind.BYTE())    return "byte";
        if (ty.kind == TypeKind.CHAR())    return "char";
        if (ty.kind == TypeKind.LONG())    return "long";
        if (ty.kind == TypeKind.FLOAT())   return "float";
        if (ty.kind == TypeKind.DOUBLE())  return "double";
        if (ty.kind == TypeKind.BOOLEAN()) return "boolean";
        if (ty.kind == TypeKind.NULL())    return "null";
        if (ty.kind == TypeKind.CLASS())   return ty.className;
        if (ty.kind == TypeKind.ARRAY())   return "<array>";
        return "<unknown>";
    }

    /* =====================================================================
     * Pass 1: Register Classes & Signatures
     * ===================================================================== */

    private boolean pass1Register() {
        int i = 0;
        while (i < this.prog.classes.size()) {
            ClassDecl cls = this.prog.classes.get(i);
            int j = 0;
            while (j < i) {
                if (this.prog.classes.get(j).name.equals(cls.name)) {
                    this.errorAt(cls.line, cls.col, "duplicate class '".concat(cls.name).concat("'"));
                    return false;
                }
                j = j + 1;
            }
            i = i + 1;
        }

        /* Resolve superclasses, interfaces & check cycles */
        i = 0;
        while (i < this.prog.classes.size()) {
            ClassDecl cls = this.prog.classes.get(i);
            if (cls.isGenericTemplate) {
                i = i + 1;
                continue;
            }
            if (cls.superType != null) {
                if (!this.resolveType(cls.superType, cls.line, cls.col)) {
                    return false;
                }
                ClassDecl sup = cls.superType.resolvedClass;
                if (sup.isInterface) {
                    this.errorAt(cls.line, cls.col,
                        "cannot extend interface '".concat(sup.name).concat("'"));
                    return false;
                }
                if (sup.isFinal) {
                    this.errorAt(cls.line, cls.col,
                        "cannot inherit from final class '".concat(sup.name).concat("'"));
                    return false;
                }
                cls.superClass = sup;
                cls.superName = sup.name;
            } else if (cls.superName != null) {
                ClassDecl sup = this.findClass(cls.superName);
                if (sup == null) {
                    this.errorAt(cls.line, cls.col,
                        "unknown superclass '".concat(cls.superName).concat("'"));
                    return false;
                }
                if (sup.isGenericTemplate) {
                    this.errorAt(cls.line, cls.col,
                        "generic class '".concat(cls.superName).concat("' requires type arguments"));
                    return false;
                }
                if (sup.isInterface) {
                    this.errorAt(cls.line, cls.col,
                        "cannot extend interface '".concat(cls.superName).concat("'"));
                    return false;
                }
                if (sup.isFinal) {
                    this.errorAt(cls.line, cls.col,
                        "cannot inherit from final class '".concat(cls.superName).concat("'"));
                    return false;
                }
                cls.superClass = sup;
            }
            int k = 0;
            while (k < cls.implCount) {
                Type it = cls.implTypes[k];
                if (it != null) {
                    if (!this.resolveType(it, cls.line, cls.col)) {
                        return false;
                    }
                    if (!it.resolvedClass.isInterface) {
                        this.errorAt(cls.line, cls.col,
                            "cannot implement non-interface class '".concat(it.resolvedClass.name).concat("'"));
                        return false;
                    }
                    cls.impls.add(it.resolvedClass);
                } else {
                    String iname = cls.implNames[k];
                    ClassDecl iface = this.findClass(iname);
                    if (iface == null) {
                        this.errorAt(cls.line, cls.col,
                            "unknown interface '".concat(iname).concat("'"));
                        return false;
                    }
                    if (!iface.isInterface) {
                        this.errorAt(cls.line, cls.col,
                            "cannot implement non-interface class '".concat(iname).concat("'"));
                        return false;
                    }
                    cls.impls.add(iface);
                }
                k = k + 1;
            }
            i = i + 1;
        }
        i = 0;
        while (i < this.prog.classes.size()) {
            ClassDecl cls = this.prog.classes.get(i);
            if (!cls.isGenericTemplate) {
                ClassDecl cur = cls.superClass;
                while (cur != null) {
                    if (cur == cls) {
                        this.errorAt(cls.line, cls.col,
                            "cyclic inheritance involving '".concat(cls.name).concat("'"));
                        return false;
                    }
                    cur = cur.superClass;
                }
                if (cls.isInterface) {
                    if (!this.flattenInterfaceMethods(cls, 0)) {
                        return false;
                    }
                }
            }
            i = i + 1;
        }

        i = 0;
        while (i < this.prog.classes.size()) {
            ClassDecl cls = this.prog.classes.get(i);
            if (cls.isGenericTemplate) {
                i = i + 1;
                continue;
            }
            if (cls.isStatic) {
                if (cls.superClass != null || cls.impls.size() > 0) {
                    this.errorAt(cls.line, cls.col,
                        "static class '".concat(cls.name).concat("' cannot extend or implement types"));
                    return false;
                }
                if (cls.constructors.size() > 0) {
                    this.errorAt(cls.line, cls.col,
                        "static class '".concat(cls.name).concat("' cannot declare constructors"));
                    return false;
                }
            }

            int f = 0;
            while (f < cls.fields.size()) {
                FieldDecl fld = cls.fields.get(f);
                if (cls.isStatic && !fld.isStatic) {
                    this.errorAt(fld.line, fld.col,
                        "static class '".concat(cls.name).concat("' cannot have non-static field '").concat(fld.name).concat("'"));
                    return false;
                }
                int prev = 0;
                while (prev < f) {
                    if (cls.fields.get(prev).name.equals(fld.name)) {
                        this.errorAt(fld.line, fld.col,
                            "duplicate field '".concat(fld.name).concat("' in class '").concat(cls.name).concat("'"));
                        return false;
                    }
                    prev = prev + 1;
                }
                if (!this.resolveType(fld.type, fld.line, fld.col)) {
                    return false;
                }
                f = f + 1;
            }

            int c = 0;
            while (c < cls.constructors.size()) {
                MethodDecl ctor = cls.constructors.get(c);
                int p = 0;
                while (p < ctor.params.size()) {
                    Param pm = ctor.params.get(p);
                    if (!this.resolveType(pm.type, pm.line, pm.col)) {
                        return false;
                    }
                    p = p + 1;
                }
                int prev = 0;
                while (prev < c) {
                    if (this.sameParamTypes(cls.constructors.get(prev), ctor)) {
                        this.errorAt(ctor.line, ctor.col,
                            "duplicate constructor signature in class '".concat(cls.name).concat("'"));
                        return false;
                    }
                    prev = prev + 1;
                }
                c = c + 1;
            }

            int m = 0;
            while (m < cls.methods.size()) {
                MethodDecl meth = cls.methods.get(m);
                if (cls.isStatic && !meth.isStatic) {
                    this.errorAt(meth.line, meth.col,
                        "static class '".concat(cls.name).concat("' cannot have non-static method '").concat(meth.name).concat("'"));
                    return false;
                }
                if (meth.isGenericTemplate) {
                    m = m + 1;
                    continue;
                }
                if (!this.resolveType(meth.returnType, meth.line, meth.col)) {
                    return false;
                }
                int p = 0;
                while (p < meth.params.size()) {
                    Param pm = meth.params.get(p);
                    if (!this.resolveType(pm.type, pm.line, pm.col)) {
                        return false;
                    }
                    p = p + 1;
                }
                int prev = 0;
                while (prev < m) {
                    MethodDecl pm = cls.methods.get(prev);
                    if (pm.name.equals(meth.name) && this.sameParamTypes(pm, meth)) {
                        this.errorAt(meth.line, meth.col,
                            "duplicate method '".concat(meth.name).concat("' with same signature in class '").concat(cls.name).concat("'"));
                        return false;
                    }
                    prev = prev + 1;
                }
                m = m + 1;
            }

            i = i + 1;
        }
        this.assignMangledNames();
        return this.buildVTables();
    }

    private boolean sameParamTypes(MethodDecl a, MethodDecl b) {
        if (a.params.size() != b.params.size()) {
            return false;
        }
        int i = 0;
        while (i < a.params.size()) {
            if (!this.typesEqual(a.params.get(i).type, b.params.get(i).type)) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    private String mangleType(Type ty) {
        if (ty.kind == TypeKind.INT())     return "int";
        if (ty.kind == TypeKind.BYTE())    return "byte";
        if (ty.kind == TypeKind.CHAR())    return "char";
        if (ty.kind == TypeKind.LONG())    return "long";
        if (ty.kind == TypeKind.FLOAT())   return "float";
        if (ty.kind == TypeKind.DOUBLE())  return "double";
        if (ty.kind == TypeKind.BOOLEAN()) return "bool";
        if (ty.kind == TypeKind.VOID())    return "void";
        if (ty.kind == TypeKind.CLASS())   return ty.resolvedClass.name;
        if (ty.kind == TypeKind.ARRAY())   return "arr_".concat(this.mangleType(ty.elem));
        return "unk";
    }

    private String mangleSuffix(MethodDecl m) {
        if (m.params.size() == 0) {
            return "__void";
        }
        ByteBuffer buf = new ByteBuffer(32);
        buf.appendByte('_');
        int i = 0;
        while (i < m.params.size()) {
            buf.appendByte('_');
            buf.appendString(this.mangleType(m.params.get(i).type));
            i = i + 1;
        }
        return buf.toString();
    }

    private boolean isNameOverloadedInProgram(String name) {
        /* Check if any class has >1 method with this name */
        int i = 0;
        while (i < this.prog.classes.size()) {
            ClassDecl cls = this.prog.classes.get(i);
            int count = 0;
            int m = 0;
            while (m < cls.methods.size()) {
                if (cls.methods.get(m).name.equals(name)) {
                    count = count + 1;
                    if (count > 1) {
                        return true;
                    }
                }
                m = m + 1;
            }
            i = i + 1;
        }
        /* Also check if a subclass overloads a superclass method with different params */
        i = 0;
        while (i < this.prog.classes.size()) {
            ClassDecl cls = this.prog.classes.get(i);
            int m = 0;
            while (m < cls.methods.size()) {
                MethodDecl md = cls.methods.get(m);
                if (md.name.equals(name)) {
                    ClassDecl sup = cls.superClass;
                    while (sup != null) {
                        int sm = 0;
                        while (sm < sup.methods.size()) {
                            MethodDecl smd = sup.methods.get(sm);
                            if (smd.name.equals(name) && !this.sameParamTypes(md, smd)) {
                                return true;
                            }
                            sm = sm + 1;
                        }
                        sup = sup.superClass;
                    }
                }
                m = m + 1;
            }
            i = i + 1;
        }
        return false;
    }

    private void assignMangledNamesForClass(ClassDecl cls) {
        if (cls.isGenericTemplate) {
            return;
        }
        boolean multiCtor = cls.constructors.size() > 1;
        int c = 0;
        while (c < cls.constructors.size()) {
            MethodDecl ctor = cls.constructors.get(c);
            if (multiCtor) {
                String suf = this.mangleSuffix(ctor);
                ctor.cName = cls.name.concat("_new").concat(suf);
                ctor.cInitName = cls.name.concat("_init").concat(suf);
            } else {
                ctor.cName = cls.name.concat("_new");
                ctor.cInitName = cls.name.concat("_init");
            }
            c = c + 1;
        }
        int m = 0;
        while (m < cls.methods.size()) {
            MethodDecl md = cls.methods.get(m);
            if (!md.isGenericTemplate && md.cName == null) {
                if (md.isNative) {
                    md.cName = md.name;
                } else if (this.isNameOverloadedInProgram(md.name)) {
                    md.cName = cls.name.concat("_").concat(md.name).concat(this.mangleSuffix(md));
                } else {
                    md.cName = cls.name.concat("_").concat(md.name);
                }
            }
            m = m + 1;
        }
    }

    private void assignMangledNames() {
        int i = 0;
        while (i < this.prog.classes.size()) {
            this.assignMangledNamesForClass(this.prog.classes.get(i));
            i = i + 1;
        }
    }

    private int classDepth(ClassDecl cls) {
        int d = 0;
        ClassDecl c = cls.superClass;
        while (c != null) {
            d = d + 1;
            c = c.superClass;
        }
        return d;
    }

    private boolean methodsCompatible(MethodDecl sub, MethodDecl base) {
        if (sub.params.size() != base.params.size()) {
            return false;
        }
        if (!this.typesEqual(sub.returnType, base.returnType)) {
            return false;
        }
        int i = 0;
        while (i < sub.params.size()) {
            if (!this.typesEqual(sub.params.get(i).type, base.params.get(i).type)) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    private boolean buildVTableForClass(ClassDecl cls) {
        if (cls.isInterface || cls.isGenericTemplate) {
            return true;
        }
        if (cls.vtable.size() > 0) {
            return true;
        }
        if (cls.superClass != null) {
            if (!this.buildVTableForClass(cls.superClass)) {
                return false;
            }
            int k = 0;
            while (k < cls.superClass.vtable.size()) {
                cls.vtable.add(cls.superClass.vtable.get(k));
                k = k + 1;
            }
        }
        int m = 0;
        while (m < cls.methods.size()) {
            MethodDecl md = cls.methods.get(m);
            if (!md.isStatic && !md.isNative && !md.isGenericTemplate) {
                int foundIdx = -1;
                int v = 0;
                while (v < cls.vtable.size()) {
                    MethodDecl vm = cls.vtable.get(v);
                    if (vm.name.equals(md.name) && this.sameParamTypes(vm, md)) {
                        foundIdx = v;
                        break;
                    }
                    v = v + 1;
                }
                if (foundIdx >= 0) {
                    MethodDecl base = cls.vtable.get(foundIdx);
                    if (base.isFinal) {
                        this.errorAt(md.line, md.col,
                            "cannot override final method '".concat(md.name).concat("'"));
                        return false;
                    }
                    if (!this.typesEqual(md.returnType, base.returnType)) {
                        this.errorAt(md.line, md.col,
                            "override of '".concat(md.name)
                            .concat("' has incompatible return type"));
                        return false;
                    }
                    md.vtableIndex = foundIdx;
                    cls.vtable.set(foundIdx, md);
                } else {
                    md.vtableIndex = cls.vtable.size();
                    cls.vtable.add(md);
                }
            }
            m = m + 1;
        }
        return true;
    }

    private boolean buildVTables() {
        int maxDepth = 0;
        int i = 0;
        while (i < this.prog.classes.size()) {
            ClassDecl c0 = this.prog.classes.get(i);
            if (!c0.isGenericTemplate) {
                int d = this.classDepth(c0);
                if (d > maxDepth) {
                    maxDepth = d;
                }
            }
            i = i + 1;
        }

        int depth = 0;
        while (depth <= maxDepth) {
            i = 0;
            while (i < this.prog.classes.size()) {
                ClassDecl cls = this.prog.classes.get(i);
                if (!cls.isInterface && !cls.isGenericTemplate && this.classDepth(cls) == depth) {
                    if (!this.buildVTableForClass(cls)) {
                        return false;
                    }
                }
                i = i + 1;
            }
            depth = depth + 1;
        }
        return this.verifyInterfaces();
    }

    private MethodDecl findConcreteImpl(ClassDecl cls, MethodDecl target) {
        ClassDecl c = cls;
        while (c != null) {
            int i = 0;
            while (i < c.methods.size()) {
                MethodDecl md = c.methods.get(i);
                if (!md.isStatic && md.name.equals(target.name) && this.sameParamTypes(md, target)) {
                    return md;
                }
                i = i + 1;
            }
            c = c.superClass;
        }
        return null;
    }

    private boolean verifyInterfacesForClass(ClassDecl cls) {
        if (cls.isInterface || cls.isGenericTemplate) {
            return true;
        }
        if (!cls.isAbstract) {
            int v = 0;
            while (v < cls.vtable.size()) {
                MethodDecl vm = cls.vtable.get(v);
                if (vm.isAbstract) {
                    this.errorAt(cls.line, cls.col,
                        "class '".concat(cls.name)
                        .concat("' must implement abstract method '").concat(vm.name).concat("'"));
                    return false;
                }
                v = v + 1;
            }
        }
        int k = 0;
        while (k < cls.impls.size()) {
            ClassDecl iface = cls.impls.get(k);
            int m = 0;
            while (m < iface.methods.size()) {
                MethodDecl im = iface.methods.get(m);
                MethodDecl impl = this.findConcreteImpl(cls, im);
                if (impl == null || impl.isStatic || (impl.isAbstract && !cls.isAbstract)) {
                    this.errorAt(cls.line, cls.col,
                        "class '".concat(cls.name)
                        .concat("' does not implement interface method '")
                        .concat(iface.name).concat(".").concat(im.name).concat("'"));
                    return false;
                }
                if (!this.typesEqual(impl.returnType, im.returnType)) {
                    this.errorAt(impl.line, impl.col,
                        "method '".concat(cls.name).concat(".").concat(impl.name)
                        .concat("' has incompatible return type for interface '")
                        .concat(iface.name).concat("'"));
                    return false;
                }
                m = m + 1;
            }
            k = k + 1;
        }
        return true;
    }

    private boolean verifyInterfaces() {
        int i = 0;
        while (i < this.prog.classes.size()) {
            ClassDecl cls = this.prog.classes.get(i);
            if (!this.verifyInterfacesForClass(cls)) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    /* =====================================================================
     * Pass 2: Type-Check Expressions & Statements
     * ===================================================================== */

    private void checkArgs(String calleeName, MethodDecl target, ExprList args, int line, int col) {
        int expected = 0;
        if (target != null) {
            expected = target.params.size();
        }
        if (args.size() != expected) {
            this.errorAt(line, col, "'".concat(calleeName).concat("' expects ")
                .concat(String.fromInt(expected)).concat(" argument(s), got ")
                .concat(String.fromInt(args.size())));
            return;
        }
        int i = 0;
        while (i < args.size()) {
            Expr a = args.get(i);
            this.checkExpr(a);
            if (this.hadError) return;
            Type expectedTy = target.params.get(i).type;
            if (!this.exprAssignable(expectedTy, a)) {
                this.errorAt(a.line, a.col, "argument ".concat(String.fromInt(i + 1))
                    .concat(" of '").concat(calleeName).concat("' has incompatible type '")
                    .concat(this.typeName(a.inferredType)).concat("' (expected '")
                    .concat(this.typeName(expectedTy)).concat("')"));
                return;
            }
            i = i + 1;
        }
    }

    private boolean argsMatch(MethodDecl m, ExprList args, boolean exact) {
        if (m.params.size() != args.size()) {
            return false;
        }
        int i = 0;
        while (i < args.size()) {
            Type expected = m.params.get(i).type;
            Expr a = args.get(i);
            if (exact) {
                if (!this.typesEqual(expected, a.inferredType)) {
                    return false;
                }
            } else {
                if (!this.exprAssignable(expected, a)) {
                    return false;
                }
            }
            i = i + 1;
        }
        return true;
    }

    private void inferTypeFromPattern(Type pat, Type actual, String[] tparams, Type[] inferred, int paramCount) {
        if (pat == null || actual == null) {
            return;
        }
        if (pat.kind == TypeKind.ARRAY() && actual.kind == TypeKind.ARRAY()) {
            this.inferTypeFromPattern(pat.elem, actual.elem, tparams, inferred, paramCount);
            return;
        }
        if (pat.kind == TypeKind.CLASS()) {
            if (pat.typeArgCount == 0 && pat.resolvedClass == null) {
                int i = 0;
                while (i < paramCount) {
                    if (tparams[i].equals(pat.className)) {
                        if (inferred[i] == null && actual.kind != TypeKind.NULL()) {
                            inferred[i] = actual;
                        }
                        return;
                    }
                    i = i + 1;
                }
            }
            if (pat.typeArgCount > 0 && actual.kind == TypeKind.CLASS() &&
                actual.resolvedClass != null &&
                actual.resolvedClass.genericArgCount == pat.typeArgCount) {
                int i = 0;
                while (i < pat.typeArgCount) {
                    this.inferTypeFromPattern(pat.typeArgs[i], actual.resolvedClass.genericArgs[i],
                                              tparams, inferred, paramCount);
                    i = i + 1;
                }
            }
        }
    }

    private MethodDecl instantiateMethod(ClassDecl cls, MethodDecl tmpl, Type[] args, int argCount, int line, int col) {
        ByteBuffer nb = new ByteBuffer(32);
        nb.appendString(cls.name);
        nb.appendByte('_');
        nb.appendString(tmpl.name);
        int i = 0;
        while (i < argCount) {
            nb.appendString("__");
            nb.appendString(this.mangleType(args[i]));
            i = i + 1;
        }
        String mangledCName = nb.toString();
        int m = 0;
        while (m < cls.methods.size()) {
            MethodDecl ex = cls.methods.get(m);
            if (!ex.isGenericTemplate && ex.cName != null && ex.cName.equals(mangledCName)) {
                return ex;
            }
            m = m + 1;
        }

        Type retTy = this.substType(tmpl.returnType, tmpl.typeParams, args, tmpl.typeParamCount);
        if (!this.resolveType(retTy, line, col)) {
            return null;
        }
        MethodDecl nm = new MethodDecl(tmpl.name, retTy, false, tmpl.isStatic, tmpl.isNative, tmpl.line, tmpl.col);
        nm.cName = mangledCName;
        nm.owner = cls;
        nm.isFinal = tmpl.isFinal;
        nm.isGenericTemplate = false;
        int p = 0;
        while (p < tmpl.params.size()) {
            Param pm = tmpl.params.get(p);
            Type pt = this.substType(pm.type, tmpl.typeParams, args, tmpl.typeParamCount);
            if (!this.resolveType(pt, line, col)) {
                return null;
            }
            nm.params.add(new Param(pt, pm.name, pm.line, pm.col));
            p = p + 1;
        }
        nm.body = this.cloneStmt(tmpl.body, tmpl.typeParams, args, tmpl.typeParamCount);
        cls.methods.add(nm);
        this.pendingMethods.add(nm);
        return nm;
    }

    private MethodDecl resolveMethodOverload(ClassDecl cls, String name, ExprList args,
                                             Expr callExpr,
                                             boolean wantStatic, boolean mustMatchStatic,
                                             int line, int col) {
        int i = 0;
        while (i < args.size()) {
            this.checkExpr(args.get(i));
            if (this.hadError) return null;
            i = i + 1;
        }
        int explicitCount = 0;
        if (callExpr != null) {
            explicitCount = callExpr.typeArgCount;
        }
        if (explicitCount > 0) {
            int ti = 0;
            while (ti < explicitCount) {
                if (!this.resolveType(callExpr.typeArgs[ti], line, col)) {
                    return null;
                }
                ti = ti + 1;
            }
        }
        int pass = 0;
        while (pass < 2) {
            boolean exact = (pass == 0);
            ClassDecl c = cls;
            while (c != null) {
                int m = 0;
                while (m < c.methods.size()) {
                    MethodDecl md = c.methods.get(m);
                    if (md.name.equals(name) && (!mustMatchStatic || md.isStatic == wantStatic)) {
                        if (md.isGenericTemplate) {
                            if (md.params.size() == args.size() &&
                                (explicitCount == 0 || explicitCount == md.typeParamCount)) {
                                Type[] gargs = new Type[md.typeParamCount];
                                boolean ok = true;
                                if (explicitCount > 0) {
                                    int g = 0;
                                    while (g < md.typeParamCount) {
                                        gargs[g] = callExpr.typeArgs[g];
                                        g = g + 1;
                                    }
                                } else {
                                    int a = 0;
                                    while (a < args.size()) {
                                        this.inferTypeFromPattern(md.params.get(a).type, args.get(a).inferredType,
                                                                  md.typeParams, gargs, md.typeParamCount);
                                        a = a + 1;
                                    }
                                    int g = 0;
                                    while (g < md.typeParamCount) {
                                        if (gargs[g] == null) {
                                            ok = false;
                                        }
                                        g = g + 1;
                                    }
                                }
                                if (ok) {
                                    MethodDecl instM = this.instantiateMethod(c, md, gargs, md.typeParamCount, line, col);
                                    if (this.hadError) return null;
                                    if (instM != null && this.argsMatch(instM, args, exact)) {
                                        return instM;
                                    }
                                }
                            }
                        } else if (explicitCount == 0 && this.argsMatch(md, args, exact)) {
                            return md;
                        }
                    }
                    m = m + 1;
                }
                c = c.superClass;
            }
            pass = pass + 1;
        }
        this.errorAt(line, col, "no matching method '".concat(cls.name).concat(".").concat(name)
            .concat("' for ").concat(String.fromInt(args.size())).concat(" argument(s)"));
        return null;
    }

    private MethodDecl resolveCtorOverload(ClassDecl cls, ExprList args, int line, int col) {
        int i = 0;
        while (i < args.size()) {
            this.checkExpr(args.get(i));
            if (this.hadError) return null;
            i = i + 1;
        }
        if (cls.constructors.size() == 0) {
            if (args.size() != 0) {
                this.errorAt(line, col, "'".concat(cls.name).concat("' expects 0 argument(s), got ")
                    .concat(String.fromInt(args.size())));
            }
            return null;
        }
        int pass = 0;
        while (pass < 2) {
            boolean exact = (pass == 0);
            int c = 0;
            while (c < cls.constructors.size()) {
                MethodDecl ctor = cls.constructors.get(c);
                if (this.argsMatch(ctor, args, exact)) {
                    return ctor;
                }
                c = c + 1;
            }
            pass = pass + 1;
        }
        this.errorAt(line, col, "no matching constructor for '".concat(cls.name)
            .concat("' with ").concat(String.fromInt(args.size())).concat(" argument(s)"));
        return null;
    }

    private boolean checkTargetWritable(Expr target) {
        if (target.kind == ExprKind.IDENT()) {
            if (target.isClassRef) {
                this.errorAt(target.line, target.col, "cannot assign to class name");
                return false;
            }
            if (this.scope.lookupFinal(target.name)) {
                this.errorAt(target.line, target.col,
                    "cannot assign to final variable '".concat(target.name).concat("'"));
                return false;
            }
            return true;
        }
        if (target.kind == ExprKind.FIELD()) {
            if (target.isArrayLength) {
                this.errorAt(target.line, target.col, "array '.length' is read-only");
                return false;
            }
            if (target.left != null && target.left.inferredType != null &&
                target.left.inferredType.kind == TypeKind.CLASS()) {
                ClassDecl cls = target.left.inferredType.resolvedClass;
                FieldDecl fld = this.findField(cls, target.name);
                if (fld != null && fld.isFinal) {
                    if (fld.isStatic) {
                        this.errorAt(target.line, target.col,
                            "cannot assign to final static field '".concat(fld.name).concat("'"));
                        return false;
                    }
                    boolean inCtor = this.currentMethod != null &&
                                     this.currentMethod.isConstructor &&
                                     target.left.kind == ExprKind.THIS() &&
                                     cls == this.currentClass;
                    if (!inCtor) {
                        this.errorAt(target.line, target.col,
                            "cannot assign to final field '".concat(fld.name).concat("'"));
                        return false;
                    }
                }
            }
            return true;
        }
        return true;
    }

    private void checkExpr(Expr e) {
        if (e == null || this.hadError) {
            return;
        }
        int k = e.kind;
        if (k == ExprKind.INT_LIT()) {
            e.inferredType = this.tyInt;
            return;
        }
        if (k == ExprKind.LONG_LIT()) {
            e.inferredType = this.tyLong;
            return;
        }
        if (k == ExprKind.DOUBLE_LIT()) {
            e.inferredType = this.tyDouble;
            return;
        }
        if (k == ExprKind.FLOAT_LIT()) {
            e.inferredType = this.tyFloat;
            return;
        }
        if (k == ExprKind.CHAR_LIT()) {
            e.inferredType = this.tyChar;
            return;
        }
        if (k == ExprKind.BOOL_LIT()) {
            e.inferredType = this.tyBoolean;
            return;
        }
        if (k == ExprKind.NULL()) {
            e.inferredType = this.tyNull;
            return;
        }
        if (k == ExprKind.DEFAULT_VAL()) {
            if (!this.resolveType(e.elemType, e.line, e.col)) {
                return;
            }
            e.inferredType = e.elemType;
            return;
        }
        if (k == ExprKind.STRING_LIT()) {
            ClassDecl strCls = this.findClass("String");
            if (strCls == null) {
                this.errorAt(e.line, e.col, "'String' class is required to use string literals");
                return;
            }
            e.inferredType = Type.makeResolvedClass(strCls);
            return;
        }
        if (k == ExprKind.THIS()) {
            if (this.currentMethod != null && this.currentMethod.isStatic) {
                this.errorAt(e.line, e.col, "'this' cannot be used in a static method");
                return;
            }
            e.inferredType = Type.makeResolvedClass(this.currentClass);
            return;
        }
        if (k == ExprKind.SUPER()) {
            if (this.currentMethod != null && this.currentMethod.isStatic) {
                this.errorAt(e.line, e.col, "'super' cannot be used in a static method");
                return;
            }
            if (this.currentClass.superClass == null) {
                this.errorAt(e.line, e.col, "'super' used in class with no superclass");
                return;
            }
            e.inferredType = Type.makeResolvedClass(this.currentClass.superClass);
            return;
        }
        if (k == ExprKind.IDENT()) {
            Type local = this.scope.lookup(e.name);
            if (local != null) {
                e.inferredType = local;
                return;
            }
            if (this.currentClass != null) {
                ClassDecl owner = this.findFieldOwner(this.currentClass, e.name);
                if (owner != null) {
                    FieldDecl fld = this.findField(owner, e.name);
                    if (fld.isStatic) {
                        Expr clsRef = new Expr(ExprKind.IDENT(), e.line, e.col);
                        clsRef.name = owner.name;
                        clsRef.isClassRef = true;
                        clsRef.inferredType = Type.makeResolvedClass(owner);
                        e.kind = ExprKind.FIELD();
                        e.left = clsRef;
                        e.isStaticField = true;
                        e.resolvedClass = owner;
                        e.inferredType = fld.type;
                        return;
                    }
                    if (this.currentMethod != null && this.currentMethod.isStatic) {
                        this.errorAt(e.line, e.col,
                            "cannot access non-static field '".concat(e.name).concat("' from a static context"));
                        return;
                    }
                    Expr thisRef = new Expr(ExprKind.THIS(), e.line, e.col);
                    thisRef.inferredType = Type.makeResolvedClass(this.currentClass);
                    e.kind = ExprKind.FIELD();
                    e.left = thisRef;
                    e.isStaticField = false;
                    e.resolvedClass = owner;
                    e.inferredType = fld.type;
                    return;
                }
            }
            ClassDecl cls = this.findClass(e.name);
            if (cls != null) {
                e.isClassRef = true;
                e.inferredType = Type.makeResolvedClass(cls);
                return;
            }
            this.errorAt(e.line, e.col, "undeclared identifier '".concat(e.name).concat("'"));
            return;
        }
        if (k == ExprKind.UNARY()) {
            this.checkExpr(e.left);
            if (this.hadError) return;
            Type opTy = e.left.inferredType;
            if (e.op == UnaryOp.NEG()) {
                if (!this.isNumeric(opTy)) {
                    this.errorAt(e.line, e.col, "unary '-' requires numeric operand");
                    return;
                }
                if (opTy.kind == TypeKind.BYTE() || opTy.kind == TypeKind.CHAR()) {
                    e.inferredType = this.tyInt;
                } else {
                    e.inferredType = opTy;
                }
            } else if (e.op == UnaryOp.BIT_NOT()) {
                if (!this.isIntegral(opTy)) {
                    this.errorAt(e.line, e.col, "unary '~' requires integral operand");
                    return;
                }
                if (opTy.kind == TypeKind.BYTE() || opTy.kind == TypeKind.CHAR()) {
                    e.inferredType = this.tyInt;
                } else {
                    e.inferredType = opTy;
                }
            } else if (e.op == UnaryOp.NOT()) {
                if (opTy == null || opTy.kind != TypeKind.BOOLEAN()) {
                    this.errorAt(e.line, e.col, "unary '!' requires boolean operand");
                    return;
                }
                e.inferredType = this.tyBoolean;
            } else {
                /* ++ / -- */
                Expr target = e.left;
                if (target.kind != ExprKind.IDENT() &&
                    target.kind != ExprKind.FIELD() &&
                    target.kind != ExprKind.INDEX()) {
                    this.errorAt(e.line, e.col, "increment/decrement requires assignable target");
                    return;
                }
                if (!this.checkTargetWritable(target)) {
                    return;
                }
                if (!this.isNumeric(opTy)) {
                    this.errorAt(e.line, e.col, "increment/decrement requires numeric operand");
                    return;
                }
                e.inferredType = opTy;
            }
            return;
        }
        if (k == ExprKind.CAST()) {
            this.checkExpr(e.left);
            if (this.hadError) return;
            if (!this.resolveType(e.elemType, e.line, e.col)) {
                return;
            }
            Type src = e.left.inferredType;
            if (e.elemType.kind == TypeKind.INT() || e.elemType.kind == TypeKind.BYTE() ||
                e.elemType.kind == TypeKind.CHAR() ||
                e.elemType.kind == TypeKind.LONG() || e.elemType.kind == TypeKind.FLOAT() ||
                e.elemType.kind == TypeKind.DOUBLE()) {
                if (!this.isNumeric(src)) {
                    this.errorAt(e.line, e.col, "numeric cast requires numeric operand");
                    return;
                }
                e.inferredType = e.elemType;
                return;
            }
            if (e.elemType.kind == TypeKind.CLASS()) {
                if (src == null || (src.kind != TypeKind.CLASS() && src.kind != TypeKind.NULL())) {
                    this.errorAt(e.line, e.col, "reference cast requires class, interface, or null operand");
                    return;
                }
                if (src.kind == TypeKind.CLASS()) {
                    ClassDecl sc = src.resolvedClass;
                    ClassDecl dc = e.elemType.resolvedClass;
                    if (!sc.isInterface && !dc.isInterface &&
                        !this.isSubtype(sc, dc) && !this.isSubtype(dc, sc)) {
                        this.errorAt(e.line, e.col,
                            "inconvertible types: cannot cast '".concat(sc.name)
                            .concat("' to '").concat(dc.name).concat("'"));
                        return;
                    }
                }
                e.inferredType = e.elemType;
                return;
            }
            this.errorAt(e.line, e.col, "unsupported cast target type");
            return;
        }
        if (k == ExprKind.INSTANCEOF()) {
            this.checkExpr(e.left);
            if (this.hadError) return;
            if (!this.resolveType(e.elemType, e.line, e.col)) {
                return;
            }
            if (e.elemType.kind != TypeKind.CLASS()) {
                this.errorAt(e.line, e.col, "'instanceof' requires a class or interface type");
                return;
            }
            Type src = e.left.inferredType;
            if (src == null || (src.kind != TypeKind.CLASS() && src.kind != TypeKind.NULL())) {
                this.errorAt(e.line, e.col, "'instanceof' operand must be a class, interface, or null");
                return;
            }
            e.inferredType = this.tyBoolean;
            return;
        }
        if (k == ExprKind.COMPOUND_ASSIGN()) {
            Expr target = e.left;
            this.checkExpr(target);
            this.checkExpr(e.right);
            if (this.hadError) return;
            if (!this.checkTargetWritable(target)) {
                return;
            }
            if (e.op == BinaryOp.ADD() && this.isStringType(target.inferredType)) {
                if (e.right.inferredType == null || e.right.inferredType.kind == TypeKind.VOID()) {
                    this.errorAt(e.line, e.col, "cannot concatenate void to String");
                    return;
                }
                e.inferredType = target.inferredType;
                return;
            }
            if (e.op == BinaryOp.MOD()) {
                if (!this.isIntegral(target.inferredType) || !this.isIntegral(e.right.inferredType)) {
                    this.errorAt(e.line, e.col, "'%=' requires integral operands");
                    return;
                }
            } else if (!this.isNumeric(target.inferredType) || !this.isNumeric(e.right.inferredType)) {
                this.errorAt(e.line, e.col, "compound assignment requires numeric operands");
                return;
            }
            e.inferredType = target.inferredType;
            return;
        }
        if (k == ExprKind.BINARY()) {
            this.checkExpr(e.left);
            this.checkExpr(e.right);
            if (this.hadError) return;
            Type lt = e.left.inferredType;
            Type rt = e.right.inferredType;
            int op = e.op;

            if (op == BinaryOp.ADD() && (this.isStringType(lt) || this.isStringType(rt))) {
                if (lt == null || rt == null || lt.kind == TypeKind.VOID() || rt.kind == TypeKind.VOID()) {
                    this.errorAt(e.line, e.col, "cannot concatenate void with String");
                    return;
                }
                ClassDecl strCls = this.findClass("String");
                e.inferredType = Type.makeResolvedClass(strCls);
            } else if (op == BinaryOp.ADD() || op == BinaryOp.SUB() || op == BinaryOp.MUL() ||
                       op == BinaryOp.DIV()) {
                if (!this.isNumeric(lt) || !this.isNumeric(rt)) {
                    this.errorAt(e.line, e.col, "arithmetic operator requires numeric operands");
                    return;
                }
                e.inferredType = this.promoteNumeric(lt, rt);
            } else if (op == BinaryOp.MOD() ||
                       op == BinaryOp.BIT_AND() || op == BinaryOp.BIT_OR() ||
                       op == BinaryOp.BIT_XOR() || op == BinaryOp.SHL() || op == BinaryOp.SHR()) {
                if (!this.isIntegral(lt) || !this.isIntegral(rt)) {
                    this.errorAt(e.line, e.col, "integral/bitwise operator requires integral operands");
                    return;
                }
                e.inferredType = this.promoteNumeric(lt, rt);
            } else if (op == BinaryOp.LT() || op == BinaryOp.LE() ||
                       op == BinaryOp.GT() || op == BinaryOp.GE()) {
                if (!this.isNumeric(lt) || !this.isNumeric(rt)) {
                    this.errorAt(e.line, e.col, "comparison operator requires numeric operands");
                    return;
                }
                e.inferredType = this.tyBoolean;
            } else if (op == BinaryOp.EQ() || op == BinaryOp.NEQ()) {
                boolean ok = (this.isNumeric(lt) && this.isNumeric(rt)) ||
                             (lt.kind == TypeKind.BOOLEAN() && rt.kind == TypeKind.BOOLEAN()) ||
                             (this.isRefType(lt) && this.isRefType(rt) &&
                              (this.typesEqual(lt, rt) || lt.kind == TypeKind.NULL() || rt.kind == TypeKind.NULL() ||
                               (lt.kind == TypeKind.CLASS() && rt.kind == TypeKind.CLASS() &&
                                (this.isSubtype(lt.resolvedClass, rt.resolvedClass) ||
                                 this.isSubtype(rt.resolvedClass, lt.resolvedClass)))));
                if (!ok) {
                    this.errorAt(e.line, e.col, "incompatible types for equality comparison");
                    return;
                }
                e.inferredType = this.tyBoolean;
            } else {
                if (lt == null || rt == null ||
                    lt.kind != TypeKind.BOOLEAN() || rt.kind != TypeKind.BOOLEAN()) {
                    this.errorAt(e.line, e.col, "logical operator requires boolean operands");
                    return;
                }
                e.inferredType = this.tyBoolean;
            }
            return;
        }
        if (k == ExprKind.ASSIGN()) {
            Expr target = e.left;
            this.checkExpr(target);
            Type prevExp = this.expectedExprType;
            this.expectedExprType = target.inferredType;
            this.checkExpr(e.right);
            this.expectedExprType = prevExp;
            if (this.hadError) return;
            if (!this.checkTargetWritable(target)) {
                return;
            }
            if (!this.exprAssignable(target.inferredType, e.right)) {
                this.errorAt(e.line, e.col, "cannot assign '".concat(this.typeName(e.right.inferredType))
                    .concat("' to '").concat(this.typeName(target.inferredType)).concat("'"));
                return;
            }
            e.inferredType = target.inferredType;
            return;
        }
        if (k == ExprKind.FIELD()) {
            Expr obj = e.left;
            this.checkExpr(obj);
            if (this.hadError) return;
            if (obj.kind == ExprKind.IDENT() && obj.isClassRef) {
                ClassDecl owner = this.findFieldOwner(obj.inferredType.resolvedClass, e.name);
                if (owner == null) {
                    this.errorAt(e.line, e.col, "class '".concat(obj.name)
                        .concat("' has no static field '").concat(e.name).concat("'"));
                    return;
                }
                FieldDecl fld = this.findField(owner, e.name);
                if (!fld.isStatic) {
                    this.errorAt(e.line, e.col, "cannot access instance field '".concat(e.name)
                        .concat("' on class '").concat(obj.name).concat("' without an instance"));
                    return;
                }
                e.isStaticField = true;
                e.resolvedClass = owner;
                e.inferredType = fld.type;
                return;
            }
            Type objTy = obj.inferredType;
            if (objTy.kind == TypeKind.ARRAY()) {
                if (e.name.equals("length")) {
                    e.isArrayLength = true;
                    e.inferredType = this.tyInt;
                    return;
                }
                this.errorAt(e.line, e.col, "arrays only have '.length' property");
                return;
            }
            if (objTy.kind == TypeKind.CLASS()) {
                ClassDecl owner = this.findFieldOwner(objTy.resolvedClass, e.name);
                if (owner == null) {
                    this.errorAt(e.line, e.col, "class '".concat(objTy.resolvedClass.name)
                        .concat("' has no field '").concat(e.name).concat("'"));
                    return;
                }
                FieldDecl fld = this.findField(owner, e.name);
                if (fld.isStatic) {
                    this.errorAt(e.line, e.col, "static field '".concat(e.name)
                        .concat("' must be accessed via class name"));
                    return;
                }
                e.resolvedClass = owner;
                e.inferredType = fld.type;
                return;
            }
            this.errorAt(e.line, e.col, "cannot access field on non-object type");
            return;
        }
        if (k == ExprKind.INDEX()) {
            this.checkExpr(e.left);
            this.checkExpr(e.right);
            if (this.hadError) return;
            Type arrTy = e.left.inferredType;
            if (arrTy == null || arrTy.kind != TypeKind.ARRAY()) {
                this.errorAt(e.line, e.col, "indexing requires an array");
                return;
            }
            if (!this.isIntegral(e.right.inferredType)) {
                this.errorAt(e.right.line, e.right.col, "array index must be an integer");
                return;
            }
            e.inferredType = arrTy.elem;
            return;
        }
        if (k == ExprKind.CALL()) {
            Expr callee = e.left;
            if (callee.kind == ExprKind.SUPER()) {
                if (this.currentMethod == null || !this.currentMethod.isConstructor) {
                    this.errorAt(e.line, e.col, "'super(...)' can only be called in a constructor");
                    return;
                }
                if (this.currentClass.superClass == null) {
                    this.errorAt(e.line, e.col, "'super(...)' used in class with no superclass");
                    return;
                }
                this.currentMethod.hasSuperCall = true;
                ClassDecl sup = this.currentClass.superClass;
                MethodDecl ctor = this.resolveCtorOverload(sup, e.args, e.line, e.col);
                e.resolvedClass = sup;
                e.resolvedMethod = ctor;
                e.inferredType = this.tyVoid;
                return;
            }
            if (callee.kind == ExprKind.FIELD()) {
                Expr obj = callee.left;
                String mname = callee.name;
                this.checkExpr(obj);
                if (this.hadError) return;
                if (obj.inferredType == null || obj.inferredType.kind != TypeKind.CLASS()) {
                    this.errorAt(e.line, e.col, "method call target must be a class or instance");
                    return;
                }
                ClassDecl cls = obj.inferredType.resolvedClass;
                boolean isClassCall = (obj.kind == ExprKind.IDENT() && obj.isClassRef);
                MethodDecl m = this.resolveMethodOverload(cls, mname, e.args, e, isClassCall, true, e.line, e.col);
                if (m == null) {
                    return;
                }
                e.resolvedClass = cls;
                e.resolvedMethod = m;
                e.inferredType = m.returnType;
                return;
            }
            if (callee.kind == ExprKind.IDENT()) {
                String mname = callee.name;
                boolean inStatic = (this.currentMethod == null || this.currentMethod.isStatic);
                MethodDecl m = this.resolveMethodOverload(this.currentClass, mname, e.args, e, true, inStatic, e.line, e.col);
                if (m == null) {
                    return;
                }
                if (!m.isStatic) {
                    Expr thisRef = new Expr(ExprKind.THIS(), callee.line, callee.col);
                    thisRef.inferredType = Type.makeResolvedClass(this.currentClass);
                    Expr fcal = new Expr(ExprKind.FIELD(), callee.line, callee.col);
                    fcal.left = thisRef;
                    fcal.name = mname;
                    e.left = fcal;
                    e.resolvedClass = this.currentClass;
                }
                e.resolvedMethod = m;
                e.inferredType = m.returnType;
                return;
            }
            this.errorAt(e.line, e.col, "invalid call target");
            return;
        }
        if (k == ExprKind.NEW_OBJ()) {
            ClassDecl cls = this.findClass(e.name);
            if (cls == null) {
                this.errorAt(e.line, e.col, "unknown class '".concat(e.name).concat("'"));
                return;
            }
            if (cls.isInterface) {
                this.errorAt(e.line, e.col, "cannot instantiate interface '".concat(e.name).concat("'"));
                return;
            }
            if (cls.isAbstract) {
                this.errorAt(e.line, e.col, "cannot instantiate abstract class '".concat(e.name).concat("'"));
                return;
            }
            if (cls.isStatic) {
                this.errorAt(e.line, e.col, "cannot instantiate static class '".concat(e.name).concat("'"));
                return;
            }
            if (cls.isGenericTemplate) {
                Type[] gargs = new Type[cls.typeParamCount];
                if (e.typeArgCount > 0) {
                    if (e.typeArgCount != cls.typeParamCount) {
                        this.errorAt(e.line, e.col, "generic class '".concat(cls.name)
                            .concat("' expects ").concat(String.fromInt(cls.typeParamCount))
                            .concat(" type argument(s), got ").concat(String.fromInt(e.typeArgCount)));
                        return;
                    }
                    int ti = 0;
                    while (ti < e.typeArgCount) {
                        if (!this.resolveType(e.typeArgs[ti], e.line, e.col)) {
                            return;
                        }
                        gargs[ti] = e.typeArgs[ti];
                        ti = ti + 1;
                    }
                } else {
                    boolean inferredFromExpected = false;
                    if (this.expectedExprType != null &&
                        this.expectedExprType.kind == TypeKind.CLASS() &&
                        this.expectedExprType.resolvedClass != null &&
                        this.expectedExprType.resolvedClass.genericArgCount == cls.typeParamCount) {
                        int g = 0;
                        while (g < cls.typeParamCount) {
                            gargs[g] = this.expectedExprType.resolvedClass.genericArgs[g];
                            g = g + 1;
                        }
                        inferredFromExpected = true;
                    }
                    if (!inferredFromExpected) {
                        int ai = 0;
                        while (ai < e.args.size()) {
                            this.checkExpr(e.args.get(ai));
                            if (this.hadError) return;
                            ai = ai + 1;
                        }
                        int ci = 0;
                        while (ci < cls.constructors.size()) {
                            MethodDecl ctor = cls.constructors.get(ci);
                            if (ctor.params.size() == e.args.size()) {
                                int a = 0;
                                while (a < e.args.size()) {
                                    this.inferTypeFromPattern(ctor.params.get(a).type,
                                                              e.args.get(a).inferredType,
                                                              cls.typeParams, gargs, cls.typeParamCount);
                                    a = a + 1;
                                }
                                break;
                            }
                            ci = ci + 1;
                        }
                    }
                    int g = 0;
                    while (g < cls.typeParamCount) {
                        if (gargs[g] == null) {
                            this.errorAt(e.line, e.col,
                                "cannot infer type arguments for generic class '".concat(cls.name).concat("'"));
                            return;
                        }
                        g = g + 1;
                    }
                }
                cls = this.instantiateClass(cls, gargs, cls.typeParamCount, e.line, e.col);
                if (this.hadError) return;
            } else if (e.typeArgCount > 0 || e.isDiamond) {
                this.errorAt(e.line, e.col, "class '".concat(cls.name).concat("' is not generic"));
                return;
            }
            e.resolvedClass = cls;
            e.resolvedMethod = this.resolveCtorOverload(cls, e.args, e.line, e.col);
            e.inferredType = Type.makeResolvedClass(cls);
            return;
        }
        if (k == ExprKind.NEW_ARRAY()) {
            if (!this.resolveType(e.elemType, e.line, e.col)) {
                return;
            }
            this.checkExpr(e.left);
            if (this.hadError) return;
            if (!this.isIntegral(e.left.inferredType)) {
                this.errorAt(e.left.line, e.left.col, "array size must be an integer");
                return;
            }
            e.inferredType = Type.makeArray(e.elemType);
            return;
        }
    }

    private void checkStmt(Stmt st) {
        if (st == null || this.hadError) {
            return;
        }
        int k = st.kind;
        if (k == StmtKind.BLOCK()) {
            this.pushScope();
            int i = 0;
            while (i < st.stmts.size() && !this.hadError) {
                this.checkStmt(st.stmts.get(i));
                i = i + 1;
            }
            this.popScope();
            return;
        }
        if (k == StmtKind.VAR_DECL()) {
            if (!this.resolveType(st.varType, st.line, st.col)) {
                return;
            }
            if (st.isFinal && st.expr == null) {
                this.errorAt(st.line, st.col, "final variable '".concat(st.varName).concat("' must be initialized"));
                return;
            }
            if (st.expr != null) {
                Type prevExp = this.expectedExprType;
                this.expectedExprType = st.varType;
                this.checkExpr(st.expr);
                this.expectedExprType = prevExp;
                if (this.hadError) return;
                if (!this.exprAssignable(st.varType, st.expr)) {
                    this.errorAt(st.line, st.col, "cannot initialize '".concat(st.varName)
                        .concat("' of type '").concat(this.typeName(st.varType))
                        .concat("' with '").concat(this.typeName(st.expr.inferredType)).concat("'"));
                    return;
                }
            }
            this.scopeDeclareFinal(st.varName, st.varType, st.isFinal, st.line, st.col);
            return;
        }
        if (k == StmtKind.IF()) {
            this.checkExpr(st.expr);
            if (this.hadError) return;
            if (st.expr.inferredType == null || st.expr.inferredType.kind != TypeKind.BOOLEAN()) {
                this.errorAt(st.expr.line, st.expr.col, "'if' condition must be boolean");
                return;
            }
            this.checkStmt(st.thenBranch);
            if (st.elseBranch != null) {
                this.checkStmt(st.elseBranch);
            }
            return;
        }
        if (k == StmtKind.WHILE()) {
            this.checkExpr(st.expr);
            if (this.hadError) return;
            if (st.expr.inferredType == null || st.expr.inferredType.kind != TypeKind.BOOLEAN()) {
                this.errorAt(st.expr.line, st.expr.col, "'while' condition must be boolean");
                return;
            }
            this.loopDepth = this.loopDepth + 1;
            this.breakDepth = this.breakDepth + 1;
            this.checkStmt(st.thenBranch);
            this.breakDepth = this.breakDepth - 1;
            this.loopDepth = this.loopDepth - 1;
            return;
        }
        if (k == StmtKind.FOREACH()) {
            this.checkExpr(st.expr);
            if (this.hadError) return;
            if (!this.resolveType(st.varType, st.line, st.col)) {
                return;
            }
            Type colTy = st.expr.inferredType;
            int id = this.foreachCounter;
            this.foreachCounter = this.foreachCounter + 1;
            Stmt origBody = st.thenBranch;

            if (colTy != null && colTy.kind == TypeKind.ARRAY()) {
                String arrName = "__fe_arr_".concat(String.fromInt(id));
                String idxName = "__fe_idx_".concat(String.fromInt(id));

                Stmt arrDecl = new Stmt(StmtKind.VAR_DECL(), st.line, st.col);
                arrDecl.varType = colTy;
                arrDecl.varName = arrName;
                arrDecl.expr = st.expr;

                Stmt idxDecl = new Stmt(StmtKind.VAR_DECL(), st.line, st.col);
                idxDecl.varType = this.tyInt;
                idxDecl.varName = idxName;
                Expr zeroLit = new Expr(ExprKind.INT_LIT(), st.line, st.col);
                zeroLit.intVal = 0;
                idxDecl.expr = zeroLit;

                Expr arrRef1 = new Expr(ExprKind.IDENT(), st.line, st.col);
                arrRef1.name = arrName;
                Expr lenExpr = new Expr(ExprKind.FIELD(), st.line, st.col);
                lenExpr.left = arrRef1;
                lenExpr.name = "length";

                Expr idxRef1 = new Expr(ExprKind.IDENT(), st.line, st.col);
                idxRef1.name = idxName;
                Expr condExpr = new Expr(ExprKind.BINARY(), st.line, st.col);
                condExpr.op = BinaryOp.LT();
                condExpr.left = idxRef1;
                condExpr.right = lenExpr;

                Expr idxRef2 = new Expr(ExprKind.IDENT(), st.line, st.col);
                idxRef2.name = idxName;
                Expr stepExpr = new Expr(ExprKind.UNARY(), st.line, st.col);
                stepExpr.op = UnaryOp.POST_INC();
                stepExpr.left = idxRef2;

                Expr arrRef2 = new Expr(ExprKind.IDENT(), st.line, st.col);
                arrRef2.name = arrName;
                Expr idxRef3 = new Expr(ExprKind.IDENT(), st.line, st.col);
                idxRef3.name = idxName;
                Expr elemIdx = new Expr(ExprKind.INDEX(), st.line, st.col);
                elemIdx.left = arrRef2;
                elemIdx.right = idxRef3;

                Stmt elemDecl = new Stmt(StmtKind.VAR_DECL(), st.line, st.col);
                elemDecl.varType = st.varType;
                elemDecl.varName = st.varName;
                elemDecl.expr = elemIdx;
                elemDecl.isFinal = st.isFinal;

                Stmt loopBody = new Stmt(StmtKind.BLOCK(), st.line, st.col);
                loopBody.stmts = new StmtList();
                loopBody.stmts.add(elemDecl);
                loopBody.stmts.add(origBody);

                Stmt forStmt = new Stmt(StmtKind.FOR(), st.line, st.col);
                forStmt.initStmt = idxDecl;
                forStmt.expr = condExpr;
                forStmt.stepExpr = stepExpr;
                forStmt.thenBranch = loopBody;

                st.kind = StmtKind.BLOCK();
                st.stmts = new StmtList();
                st.stmts.add(arrDecl);
                st.stmts.add(forStmt);
                st.expr = null;
                st.thenBranch = null;
                this.checkStmt(st);
                return;
            }

            if (colTy != null && colTy.kind == TypeKind.CLASS()) {
                Expr iterField = new Expr(ExprKind.FIELD(), st.line, st.col);
                iterField.left = st.expr;
                iterField.name = "iterator";
                Expr iterCall = new Expr(ExprKind.CALL(), st.line, st.col);
                iterCall.left = iterField;
                iterCall.args = new ExprList();
                this.checkExpr(iterCall);
                if (this.hadError) return;

                Type iterTy = iterCall.inferredType;
                String itName = "__fe_it_".concat(String.fromInt(id));

                Stmt itDecl = new Stmt(StmtKind.VAR_DECL(), st.line, st.col);
                itDecl.varType = iterTy;
                itDecl.varName = itName;
                itDecl.expr = iterCall;

                Expr itRef1 = new Expr(ExprKind.IDENT(), st.line, st.col);
                itRef1.name = itName;
                Expr hasNextField = new Expr(ExprKind.FIELD(), st.line, st.col);
                hasNextField.left = itRef1;
                hasNextField.name = "hasNext";
                Expr hasNextCall = new Expr(ExprKind.CALL(), st.line, st.col);
                hasNextCall.left = hasNextField;
                hasNextCall.args = new ExprList();

                Expr itRef2 = new Expr(ExprKind.IDENT(), st.line, st.col);
                itRef2.name = itName;
                Expr nextField = new Expr(ExprKind.FIELD(), st.line, st.col);
                nextField.left = itRef2;
                nextField.name = "next";
                Expr nextCall = new Expr(ExprKind.CALL(), st.line, st.col);
                nextCall.left = nextField;
                nextCall.args = new ExprList();

                Stmt elemDecl = new Stmt(StmtKind.VAR_DECL(), st.line, st.col);
                elemDecl.varType = st.varType;
                elemDecl.varName = st.varName;
                elemDecl.expr = nextCall;
                elemDecl.isFinal = st.isFinal;

                Stmt loopBody = new Stmt(StmtKind.BLOCK(), st.line, st.col);
                loopBody.stmts = new StmtList();
                loopBody.stmts.add(elemDecl);
                loopBody.stmts.add(origBody);

                st.kind = StmtKind.FOR();
                st.initStmt = itDecl;
                st.expr = hasNextCall;
                st.stepExpr = null;
                st.thenBranch = loopBody;
                this.checkStmt(st);
                return;
            }

            this.errorAt(st.line, st.col, "for-each requires an array or Iterable object");
            return;
        }
        if (k == StmtKind.FOR()) {
            this.pushScope();
            if (st.initStmt != null) {
                this.checkStmt(st.initStmt);
                if (this.hadError) {
                    this.popScope();
                    return;
                }
            }
            if (st.expr != null) {
                this.checkExpr(st.expr);
                if (this.hadError) {
                    this.popScope();
                    return;
                }
                if (st.expr.inferredType == null || st.expr.inferredType.kind != TypeKind.BOOLEAN()) {
                    this.errorAt(st.expr.line, st.expr.col, "'for' condition must be boolean");
                    this.popScope();
                    return;
                }
            }
            if (st.stepExpr != null) {
                this.checkExpr(st.stepExpr);
                if (this.hadError) {
                    this.popScope();
                    return;
                }
            }
            this.loopDepth = this.loopDepth + 1;
            this.breakDepth = this.breakDepth + 1;
            this.checkStmt(st.thenBranch);
            this.breakDepth = this.breakDepth - 1;
            this.loopDepth = this.loopDepth - 1;
            this.popScope();
            return;
        }
        if (k == StmtKind.SWITCH()) {
            this.checkExpr(st.expr);
            if (this.hadError) return;
            if (!this.isIntegral(st.expr.inferredType)) {
                this.errorAt(st.expr.line, st.expr.col, "'switch' expression must be integral");
                return;
            }
            this.breakDepth = this.breakDepth + 1;
            int i = 0;
            while (i < st.stmts.size() && !this.hadError) {
                Stmt c = st.stmts.get(i);
                if (c.kind == StmtKind.CASE()) {
                    Expr val = c.expr;
                    if (val.kind == ExprKind.INT_LIT()) {
                        c.intVal = val.intVal;
                    } else if (val.kind == ExprKind.CHAR_LIT()) {
                        c.intVal = val.charVal;
                    } else if (val.kind == ExprKind.UNARY() &&
                               val.op == UnaryOp.NEG() &&
                               val.left.kind == ExprKind.INT_LIT()) {
                        c.intVal = -val.left.intVal;
                    } else {
                        this.errorAt(val.line, val.col, "'case' label must be a constant integer or char");
                        break;
                    }
                }
                this.pushScope();
                int j = 0;
                while (j < c.stmts.size() && !this.hadError) {
                    this.checkStmt(c.stmts.get(j));
                    j = j + 1;
                }
                this.popScope();
                i = i + 1;
            }
            this.breakDepth = this.breakDepth - 1;
            return;
        }
        if (k == StmtKind.BREAK()) {
            if (this.breakDepth <= 0) {
                this.errorAt(st.line, st.col, "'break' outside of loop or switch");
            }
            return;
        }
        if (k == StmtKind.CONTINUE()) {
            if (this.loopDepth <= 0) {
                this.errorAt(st.line, st.col, "'continue' outside of loop");
            }
            return;
        }
        if (k == StmtKind.RETURN()) {
            Type ret = this.currentMethod.returnType;
            if (ret.kind == TypeKind.VOID()) {
                if (st.expr != null) {
                    this.errorAt(st.line, st.col, "void method/constructor cannot return a value");
                }
            } else {
                if (st.expr == null) {
                    this.errorAt(st.line, st.col, "non-void method must return a value");
                    return;
                }
                Type prevExp = this.expectedExprType;
                this.expectedExprType = ret;
                this.checkExpr(st.expr);
                this.expectedExprType = prevExp;
                if (this.hadError) return;
                if (!this.exprAssignable(ret, st.expr)) {
                    this.errorAt(st.line, st.col, "return value type '"
                        .concat(this.typeName(st.expr.inferredType))
                        .concat("' incompatible with '").concat(this.typeName(ret)).concat("'"));
                }
            }
            return;
        }
        if (k == StmtKind.THROW()) {
            this.checkExpr(st.expr);
            if (this.hadError) return;
            ClassDecl excCls = this.findClass("Exception");
            if (excCls == null) {
                this.errorAt(st.line, st.col, "'Exception' class is required for 'throw'");
                return;
            }
            Type et = st.expr.inferredType;
            if (et == null || et.kind != TypeKind.CLASS() || et.resolvedClass.isInterface ||
                !this.isSubtype(et.resolvedClass, excCls)) {
                this.errorAt(st.line, st.col, "'throw' expression must be an instance of Exception");
                return;
            }
            return;
        }
        if (k == StmtKind.SYNCHRONIZED()) {
            this.checkExpr(st.expr);
            if (this.hadError) return;
            Type mt = st.expr.inferredType;
            if (mt == null || (mt.kind != TypeKind.CLASS() && mt.kind != TypeKind.ARRAY())) {
                this.errorAt(st.expr.line, st.expr.col, "'synchronized' expression must be an object or array reference");
                return;
            }
            this.checkStmt(st.thenBranch);
            return;
        }
        if (k == StmtKind.TRY()) {
            ClassDecl excCls = this.findClass("Exception");
            if (excCls == null) {
                this.errorAt(st.line, st.col, "'Exception' class is required for 'try'");
                return;
            }
            this.checkStmt(st.thenBranch);
            if (this.hadError) return;
            int i = 0;
            while (i < st.stmts.size() && !this.hadError) {
                Stmt c = st.stmts.get(i);
                if (!this.resolveType(c.varType, c.line, c.col)) {
                    return;
                }
                if (c.varType.kind != TypeKind.CLASS() || c.varType.resolvedClass.isInterface ||
                    !this.isSubtype(c.varType.resolvedClass, excCls)) {
                    this.errorAt(c.line, c.col, "catch parameter must be Exception or a subclass of Exception");
                    return;
                }
                this.pushScope();
                this.scope.add(c.varName, c.varType);
                this.checkStmt(c.thenBranch);
                this.popScope();
                i = i + 1;
            }
            if (!this.hadError && st.elseBranch != null) {
                this.checkStmt(st.elseBranch);
            }
            return;
        }
        if (k == StmtKind.EXPR()) {
            this.checkExpr(st.expr);
            return;
        }
    }

    private void checkMethod(ClassDecl cls, MethodDecl m) {
        if (m.isNative || m.body == null) {
            return;
        }
        if (m.isSynchronized && m.isStatic) {
            this.errorAt(m.line, m.col, "'static synchronized' methods are not supported; use 'synchronized(obj)'");
            return;
        }
        this.currentClass = cls;
        this.currentMethod = m;
        this.pushScope();
        int i = 0;
        while (i < m.params.size() && !this.hadError) {
            Param p = m.params.get(i);
            this.scopeDeclare(p.name, p.type, p.line, p.col);
            i = i + 1;
        }
        i = 0;
        while (i < m.body.stmts.size() && !this.hadError) {
            this.checkStmt(m.body.stmts.get(i));
            i = i + 1;
        }
        this.popScope();
    }

    private boolean hasZeroArgCtor(ClassDecl cls) {
        if (cls.constructors.size() == 0) {
            return true;
        }
        int c = 0;
        while (c < cls.constructors.size()) {
            if (cls.constructors.get(c).params.size() == 0) {
                return true;
            }
            c = c + 1;
        }
        return false;
    }

    private void checkClassMembers(ClassDecl cls) {
        if (cls.isInterface || cls.isGenericTemplate) {
            return;
        }
        int fi = 0;
        while (fi < cls.fields.size() && !this.hadError) {
            FieldDecl fld = cls.fields.get(fi);
            if (fld.initExpr != null) {
                this.currentClass = cls;
                this.currentMethod = null;
                this.pushScope();
                Type prevExp = this.expectedExprType;
                this.expectedExprType = fld.type;
                this.checkExpr(fld.initExpr);
                this.expectedExprType = prevExp;
                this.popScope();
                if (!this.hadError && !this.exprAssignable(fld.type, fld.initExpr)) {
                    this.errorAt(fld.line, fld.col, "cannot initialize field '".concat(fld.name)
                        .concat("' with '").concat(this.typeName(fld.initExpr.inferredType)).concat("'"));
                }
            }
            fi = fi + 1;
        }
        if (cls.constructors.size() == 0) {
            if (cls.superClass != null && !this.hasZeroArgCtor(cls.superClass)) {
                this.errorAt(cls.line, cls.col,
                    "class '".concat(cls.name)
                    .concat("' must define a constructor calling 'super(...)'"));
            }
        } else {
            int c = 0;
            while (c < cls.constructors.size() && !this.hadError) {
                MethodDecl ctor = cls.constructors.get(c);
                this.checkMethod(cls, ctor);
                if (!this.hadError && cls.superClass != null && !ctor.hasSuperCall) {
                    if (!this.hasZeroArgCtor(cls.superClass)) {
                        this.errorAt(ctor.line, ctor.col,
                            "constructor must call 'super(...)' for superclass '"
                            .concat(cls.superClass.name).concat("'"));
                    }
                }
                c = c + 1;
            }
        }
        int m = 0;
        while (m < cls.methods.size() && !this.hadError) {
            MethodDecl md = cls.methods.get(m);
            if (!md.isGenericTemplate) {
                this.checkMethod(cls, md);
            }
            m = m + 1;
        }
    }

    public boolean analyze() {
        if (!this.pass1Register()) {
            return false;
        }
        int i = 0;
        while (i < this.prog.classes.size() && !this.hadError) {
            this.checkClassMembers(this.prog.classes.get(i));
            i = i + 1;
        }
        int pc = 0;
        int pm = 0;
        while ((pc < this.pendingClasses.size() || pm < this.pendingMethods.size()) && !this.hadError) {
            while (pc < this.pendingClasses.size() && !this.hadError) {
                this.checkClassMembers(this.pendingClasses.get(pc));
                pc = pc + 1;
            }
            while (pm < this.pendingMethods.size() && !this.hadError) {
                MethodDecl md = this.pendingMethods.get(pm);
                this.checkMethod(md.owner, md);
                pm = pm + 1;
            }
        }
        return !this.hadError;
    }
}
