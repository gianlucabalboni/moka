import std/datastructures/Iterable;
import std/datastructures/Iterator;

/**
 * Root interface in the collection hierarchy.
 */
public interface Collection<E> extends Iterable<E> {
    /** Returns the number of elements in this collection. */
    int size();

    /** Returns true if this collection contains no elements. */
    boolean isEmpty();

    /** Returns true if this collection contains the specified element. */
    boolean contains(E elem);

    /**
     * Ensures that this collection contains the specified element.
     * Returns true if this collection changed as a result of the call.
     */
    boolean add(E elem);

    /**
     * Removes a single instance of the specified element from this collection, if present.
     * Returns true if an element was removed as a result of the call.
     */
    boolean remove(E elem);

    /** Removes all of the elements from this collection. */
    void clear();

    /** Returns an array containing all of the elements in this collection. */
    E[] toArray();

    /** Returns a string representation of this collection. */
    String toString();
}
