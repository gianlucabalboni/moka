import std/datastructures/Collection;
import std/datastructures/Hasher;
import std/datastructures/Iterable;
import std/datastructures/Iterator;
import std/datastructures/Map;
import std/datastructures/MapEntry;
import std/datastructures/Set;

/**
 * Hash table based implementation of the Map<K, V> interface.
 * Uses open addressing with linear probing, power-of-2 capacity, load factor 0.75,
 * and backward-shift deletion (zero tombstones).
 *
 * - Null policy: depends on the provided Hasher<K> (StringHasher rejects null with
 *   NullPointerException; primitive hashers are unboxed with zero allocation).
 * - Thread safety: NOT thread-safe.
 * - GC: removed/cleared slots are overwritten with default(K) and default(V).
 * - Fail-fast: keySet/values/entrySet iterators throw ConcurrentModificationException.
 */
public class HashMap<K, V> implements Map<K, V> {
    private K[] keys;
    private V[] values;
    private int[] hashes;
    private boolean[] occupied;
    private int count;
    private int threshold;
    private int modCount;
    private Hasher<K> hasher;

    /**
     * Constructs an empty HashMap with initial capacity 16 and the given Hasher<K>.
     * Throws NullPointerException if hasher is null.
     * Complexity: O(1).
     */
    public HashMap(Hasher<K> hasher) {
        if (hasher == null) {
            throw new NullPointerException("HashMap: hasher is null");
        }
        this.hasher = hasher;
        this.initTable(16);
        this.modCount = 0;
    }

    /**
     * Constructs an empty HashMap with capacity rounded up to a power of 2 (min 8).
     * Throws IllegalArgumentException if initialCapacity < 0.
     * Throws NullPointerException if hasher is null.
     * Complexity: O(cap).
     */
    public HashMap(int initialCapacity, Hasher<K> hasher) {
        if (hasher == null) {
            throw new NullPointerException("HashMap: hasher is null");
        }
        if (initialCapacity < 0) {
            throw new IllegalArgumentException(
                "HashMap negative initial capacity: " + initialCapacity);
        }
        int cap = 8;
        while (cap < initialCapacity) {
            cap = cap * 2;
        }
        this.hasher = hasher;
        this.initTable(cap);
        this.modCount = 0;
    }

    private void initTable(int cap) {
        this.keys = new K[cap];
        this.values = new V[cap];
        this.hashes = new int[cap];
        this.occupied = new boolean[cap];
        this.count = 0;
        this.threshold = (cap * 3) / 4;
    }

    private int spreadHash(K key) {
        int h = this.hasher.hash(key);
        long lh = (long) h & 4294967295L;
        return (int) (lh ^ (lh >> 16));
    }

    private int findSlot(K key, int h) {
        int mask = this.keys.length - 1;
        int idx = h & mask;
        while (this.occupied[idx]) {
            if (this.hashes[idx] == h && this.hasher.equals(this.keys[idx], key)) {
                return idx;
            }
            idx = (idx + 1) & mask;
        }
        return -1;
    }

    private void rehash(int newCap) {
        K[] oldKeys = this.keys;
        V[] oldVals = this.values;
        int[] oldHashes = this.hashes;
        boolean[] oldOcc = this.occupied;
        int oldCap = oldKeys.length;

        this.initTable(newCap);
        int mask = newCap - 1;
        for (int i = 0; i < oldCap; i++) {
            if (oldOcc[i]) {
                int h = oldHashes[i];
                int idx = h & mask;
                while (this.occupied[idx]) {
                    idx = (idx + 1) & mask;
                }
                this.keys[idx] = oldKeys[i];
                this.values[idx] = oldVals[i];
                this.hashes[idx] = h;
                this.occupied[idx] = true;
                this.count = this.count + 1;
            }
        }
    }

    /** Internal helpers for iterators and views. */
    public int getCapacity() { return this.keys.length; }
    public int getModCount() { return this.modCount; }
    public boolean isSlotOccupied(int i) { return this.occupied[i]; }
    public K getSlotKey(int i) { return this.keys[i]; }
    public V getSlotValue(int i) { return this.values[i]; }
    public void setSlotValue(int i, V v) { this.values[i] = v; }

    /**
     * Removes the entry at table slot i using backward-shift deletion.
     * Returns true if another entry was shifted into slot i.
     * Complexity: O(1) expected.
     */
    public boolean removeSlot(int i) {
        int mask = this.keys.length - 1;
        this.keys[i] = default(K);
        this.values[i] = default(V);
        this.hashes[i] = 0;
        this.occupied[i] = false;
        this.count = this.count - 1;
        this.modCount = this.modCount + 1;

        boolean shiftedIntoI = false;
        int hole = i;
        int j = (i + 1) & mask;
        while (this.occupied[j]) {
            int natural = this.hashes[j] & mask;
            if (((hole - natural) & mask) < ((j - natural) & mask)) {
                this.keys[hole] = this.keys[j];
                this.values[hole] = this.values[j];
                this.hashes[hole] = this.hashes[j];
                this.occupied[hole] = true;

                this.keys[j] = default(K);
                this.values[j] = default(V);
                this.hashes[j] = 0;
                this.occupied[j] = false;

                if (hole == i) {
                    shiftedIntoI = true;
                }
                hole = j;
            }
            j = (j + 1) & mask;
        }
        return shiftedIntoI;
    }

    /** Complexity: O(1). */
    public int size() {
        return this.count;
    }

    /** Complexity: O(1). */
    public boolean isEmpty() {
        return this.count == 0;
    }

    /** Complexity: O(1) expected. */
    public boolean containsKey(K key) {
        long lh = (long) this.hasher.hash(key) & 4294967295L;
        int h = (int) (lh ^ (lh >> 16));
        int mask = this.keys.length - 1;
        int idx = h & mask;
        while (this.occupied[idx]) {
            if (this.hashes[idx] == h && this.hasher.equals(this.keys[idx], key)) {
                return true;
            }
            idx = (idx + 1) & mask;
        }
        return false;
    }

    /** Complexity: O(n). */
    public boolean containsValue(V value) {
        for (int i = 0; i < this.keys.length; i++) {
            if (this.occupied[i] && this.values[i] == value) {
                return true;
            }
        }
        return false;
    }

    /**
     * Returns the value mapped to key.
     * Throws NoSuchElementException if key is not present.
     * Complexity: O(1) expected.
     */
    public V get(K key) {
        long lh = (long) this.hasher.hash(key) & 4294967295L;
        int h = (int) (lh ^ (lh >> 16));
        int mask = this.keys.length - 1;
        int idx = h & mask;
        while (this.occupied[idx]) {
            if (this.hashes[idx] == h && this.hasher.equals(this.keys[idx], key)) {
                return this.values[idx];
            }
            idx = (idx + 1) & mask;
        }
        throw new NoSuchElementException("Key not found in HashMap: " + key);
    }

    /**
     * Returns the value mapped to key, or defaultValue if absent.
     * Complexity: O(1) expected.
     */
    public V getOrDefault(K key, V defaultValue) {
        long lh = (long) this.hasher.hash(key) & 4294967295L;
        int h = (int) (lh ^ (lh >> 16));
        int mask = this.keys.length - 1;
        int idx = h & mask;
        while (this.occupied[idx]) {
            if (this.hashes[idx] == h && this.hasher.equals(this.keys[idx], key)) {
                return this.values[idx];
            }
            idx = (idx + 1) & mask;
        }
        return defaultValue;
    }

    /**
     * Associates value with key. Returns previous value or default(V) if absent.
     * Complexity: O(1) amortized expected.
     */
    public V put(K key, V value) {
        long lh = (long) this.hasher.hash(key) & 4294967295L;
        int h = (int) (lh ^ (lh >> 16));
        int mask = this.keys.length - 1;
        int idx = h & mask;
        while (this.occupied[idx]) {
            if (this.hashes[idx] == h && this.hasher.equals(this.keys[idx], key)) {
                V old = this.values[idx];
                this.values[idx] = value;
                return old;
            }
            idx = (idx + 1) & mask;
        }
        if (this.count >= this.threshold) {
            this.rehash(this.keys.length * 2);
            mask = this.keys.length - 1;
            idx = h & mask;
            while (this.occupied[idx]) {
                idx = (idx + 1) & mask;
            }
        }
        this.keys[idx] = key;
        this.values[idx] = value;
        this.hashes[idx] = h;
        this.occupied[idx] = true;
        this.count = this.count + 1;
        this.modCount = this.modCount + 1;
        return default(V);
    }

    /**
     * Removes key from this map and returns its previous value.
     * Throws NoSuchElementException if key is not present.
     * Complexity: O(1) expected.
     */
    public V remove(K key) {
        long lh = (long) this.hasher.hash(key) & 4294967295L;
        int h = (int) (lh ^ (lh >> 16));
        int mask = this.keys.length - 1;
        int idx = h & mask;
        while (this.occupied[idx]) {
            if (this.hashes[idx] == h && this.hasher.equals(this.keys[idx], key)) {
                V old = this.values[idx];
                this.removeSlot(idx);
                return old;
            }
            idx = (idx + 1) & mask;
        }
        throw new NoSuchElementException("Key not found in HashMap: " + key);
    }

    /** Clears all mappings and releases references for GC. Complexity: O(capacity). */
    public void clear() {
        for (int i = 0; i < this.keys.length; i++) {
            this.keys[i] = default(K);
            this.values[i] = default(V);
            this.hashes[i] = 0;
            this.occupied[i] = false;
        }
        this.count = 0;
        this.modCount = this.modCount + 1;
    }

    /** Complexity: O(1). */
    public Set<K> keySet() {
        return new HashMapKeySet<K, V>(this);
    }

    /** Complexity: O(1). */
    public Collection<V> values() {
        return new HashMapValues<K, V>(this);
    }

    /** Complexity: O(1). */
    public Set<MapEntry<K, V>> entrySet() {
        return new HashMapEntrySet<K, V>(this);
    }

    /** Complexity: O(capacity). */
    public String toString() {
        ByteBuffer buf = new ByteBuffer(this.count * 8 + 2);
        buf.appendByte('{');
        boolean first = true;
        for (int i = 0; i < this.keys.length; i++) {
            if (this.occupied[i]) {
                if (!first) {
                    buf.appendString(", ");
                }
                first = false;
                buf.appendString("" + this.keys[i] + "=" + this.values[i]);
            }
        }
        buf.appendByte('}');
        return buf.toString();
    }
}

public class HashMapKeyIterator<K, V> implements Iterator<K> {
    private HashMap<K, V> map;
    private int cursor;
    private int lastRet;
    private int expectedModCount;

    public HashMapKeyIterator(HashMap<K, V> map) {
        this.map = map;
        this.cursor = 0;
        this.lastRet = -1;
        this.expectedModCount = map.getModCount();
        this.advance();
    }

    private void advance() {
        int cap = this.map.getCapacity();
        while (this.cursor < cap && !this.map.isSlotOccupied(this.cursor)) {
            this.cursor = this.cursor + 1;
        }
    }

    private void checkComod() {
        if (this.map.getModCount() != this.expectedModCount) {
            throw new ConcurrentModificationException("HashMap modified during iteration");
        }
    }

    public boolean hasNext() {
        this.checkComod();
        return this.cursor < this.map.getCapacity();
    }

    public K next() {
        this.checkComod();
        if (this.cursor >= this.map.getCapacity()) {
            throw new NoSuchElementException("HashMapKeyIterator: no more elements");
        }
        this.lastRet = this.cursor;
        K k = this.map.getSlotKey(this.cursor);
        this.cursor = this.cursor + 1;
        this.advance();
        return k;
    }

    public void remove() {
        if (this.lastRet < 0) {
            throw new IllegalStateException("HashMapKeyIterator.remove: invalid state");
        }
        this.checkComod();
        boolean shifted = this.map.removeSlot(this.lastRet);
        if (shifted) {
            this.cursor = this.lastRet;
        }
        this.advance();
        this.lastRet = -1;
        this.expectedModCount = this.map.getModCount();
    }
}

public class HashMapValueIterator<K, V> implements Iterator<V> {
    private HashMap<K, V> map;
    private int cursor;
    private int lastRet;
    private int expectedModCount;

    public HashMapValueIterator(HashMap<K, V> map) {
        this.map = map;
        this.cursor = 0;
        this.lastRet = -1;
        this.expectedModCount = map.getModCount();
        this.advance();
    }

    private void advance() {
        int cap = this.map.getCapacity();
        while (this.cursor < cap && !this.map.isSlotOccupied(this.cursor)) {
            this.cursor = this.cursor + 1;
        }
    }

    private void checkComod() {
        if (this.map.getModCount() != this.expectedModCount) {
            throw new ConcurrentModificationException("HashMap modified during iteration");
        }
    }

    public boolean hasNext() {
        this.checkComod();
        return this.cursor < this.map.getCapacity();
    }

    public V next() {
        this.checkComod();
        if (this.cursor >= this.map.getCapacity()) {
            throw new NoSuchElementException("HashMapValueIterator: no more elements");
        }
        this.lastRet = this.cursor;
        V v = this.map.getSlotValue(this.cursor);
        this.cursor = this.cursor + 1;
        this.advance();
        return v;
    }

    public void remove() {
        if (this.lastRet < 0) {
            throw new IllegalStateException("HashMapValueIterator.remove: invalid state");
        }
        this.checkComod();
        boolean shifted = this.map.removeSlot(this.lastRet);
        if (shifted) {
            this.cursor = this.lastRet;
        }
        this.advance();
        this.lastRet = -1;
        this.expectedModCount = this.map.getModCount();
    }
}

public class HashMapEntryIterator<K, V> implements Iterator<MapEntry<K, V>> {
    private HashMap<K, V> map;
    private int cursor;
    private int lastRet;
    private int expectedModCount;

    public HashMapEntryIterator(HashMap<K, V> map) {
        this.map = map;
        this.cursor = 0;
        this.lastRet = -1;
        this.expectedModCount = map.getModCount();
        this.advance();
    }

    private void advance() {
        int cap = this.map.getCapacity();
        while (this.cursor < cap && !this.map.isSlotOccupied(this.cursor)) {
            this.cursor = this.cursor + 1;
        }
    }

    private void checkComod() {
        if (this.map.getModCount() != this.expectedModCount) {
            throw new ConcurrentModificationException("HashMap modified during iteration");
        }
    }

    public boolean hasNext() {
        this.checkComod();
        return this.cursor < this.map.getCapacity();
    }

    public MapEntry<K, V> next() {
        this.checkComod();
        if (this.cursor >= this.map.getCapacity()) {
            throw new NoSuchElementException("HashMapEntryIterator: no more elements");
        }
        this.lastRet = this.cursor;
        MapEntry<K, V> e = new MapEntry<K, V>(
            this.map.getSlotKey(this.cursor),
            this.map.getSlotValue(this.cursor));
        this.cursor = this.cursor + 1;
        this.advance();
        return e;
    }

    public void remove() {
        if (this.lastRet < 0) {
            throw new IllegalStateException("HashMapEntryIterator.remove: invalid state");
        }
        this.checkComod();
        boolean shifted = this.map.removeSlot(this.lastRet);
        if (shifted) {
            this.cursor = this.lastRet;
        }
        this.advance();
        this.lastRet = -1;
        this.expectedModCount = this.map.getModCount();
    }
}

public class HashMapKeySet<K, V> implements Set<K> {
    private HashMap<K, V> map;

    public HashMapKeySet(HashMap<K, V> map) { this.map = map; }
    public int size() { return this.map.size(); }
    public boolean isEmpty() { return this.map.isEmpty(); }
    public boolean contains(K key) { return this.map.containsKey(key); }
    public boolean add(K key) {
        throw new IllegalStateException("HashMap.keySet does not support add");
    }
    public boolean remove(K key) {
        if (!this.map.containsKey(key)) return false;
        this.map.remove(key);
        return true;
    }
    public void clear() { this.map.clear(); }
    public Iterator<K> iterator() { return new HashMapKeyIterator<K, V>(this.map); }
    public K[] toArray() {
        K[] out = new K[this.map.size()];
        int idx = 0;
        Iterator<K> it = this.iterator();
        while (it.hasNext()) {
            out[idx] = it.next();
            idx = idx + 1;
        }
        return out;
    }
    public String toString() {
        ByteBuffer buf = new ByteBuffer(this.map.size() * 4 + 2);
        buf.appendByte('[');
        Iterator<K> it = this.iterator();
        boolean first = true;
        while (it.hasNext()) {
            if (!first) buf.appendString(", ");
            first = false;
            buf.appendString("" + it.next());
        }
        buf.appendByte(']');
        return buf.toString();
    }
}

public class HashMapValues<K, V> implements Collection<V> {
    private HashMap<K, V> map;

    public HashMapValues(HashMap<K, V> map) { this.map = map; }
    public int size() { return this.map.size(); }
    public boolean isEmpty() { return this.map.isEmpty(); }
    public boolean contains(V val) { return this.map.containsValue(val); }
    public boolean add(V val) {
        throw new IllegalStateException("HashMap.values does not support add");
    }
    public boolean remove(V val) {
        Iterator<V> it = this.iterator();
        while (it.hasNext()) {
            if (it.next() == val) {
                it.remove();
                return true;
            }
        }
        return false;
    }
    public void clear() { this.map.clear(); }
    public Iterator<V> iterator() { return new HashMapValueIterator<K, V>(this.map); }
    public V[] toArray() {
        V[] out = new V[this.map.size()];
        int idx = 0;
        Iterator<V> it = this.iterator();
        while (it.hasNext()) {
            out[idx] = it.next();
            idx = idx + 1;
        }
        return out;
    }
    public String toString() {
        ByteBuffer buf = new ByteBuffer(this.map.size() * 4 + 2);
        buf.appendByte('[');
        Iterator<V> it = this.iterator();
        boolean first = true;
        while (it.hasNext()) {
            if (!first) buf.appendString(", ");
            first = false;
            buf.appendString("" + it.next());
        }
        buf.appendByte(']');
        return buf.toString();
    }
}

public class HashMapEntrySet<K, V> implements Set<MapEntry<K, V>> {
    private HashMap<K, V> map;

    public HashMapEntrySet(HashMap<K, V> map) { this.map = map; }
    public int size() { return this.map.size(); }
    public boolean isEmpty() { return this.map.isEmpty(); }
    public boolean contains(MapEntry<K, V> entry) {
        if (entry == null) return false;
        if (!this.map.containsKey(entry.getKey())) return false;
        return this.map.get(entry.getKey()) == entry.getValue();
    }
    public boolean add(MapEntry<K, V> entry) {
        throw new IllegalStateException("HashMap.entrySet does not support add");
    }
    public boolean remove(MapEntry<K, V> entry) {
        if (!this.contains(entry)) return false;
        this.map.remove(entry.getKey());
        return true;
    }
    public void clear() { this.map.clear(); }
    public Iterator<MapEntry<K, V>> iterator() { return new HashMapEntryIterator<K, V>(this.map); }
    public MapEntry<K, V>[] toArray() {
        MapEntry<K, V>[] out = new MapEntry<K, V>[this.map.size()];
        int idx = 0;
        Iterator<MapEntry<K, V>> it = this.iterator();
        while (it.hasNext()) {
            out[idx] = it.next();
            idx = idx + 1;
        }
        return out;
    }
    public String toString() {
        ByteBuffer buf = new ByteBuffer(this.map.size() * 8 + 2);
        buf.appendByte('[');
        Iterator<MapEntry<K, V>> it = this.iterator();
        boolean first = true;
        while (it.hasNext()) {
            if (!first) buf.appendString(", ");
            first = false;
            buf.appendString(it.next().toString());
        }
        buf.appendByte(']');
        return buf.toString();
    }
}
