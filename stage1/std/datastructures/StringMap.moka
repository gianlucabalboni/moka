public class StringMap<V> {
    private String[] keys;
    private V[] values;
    private int count;

    public StringMap() {
        keys = new String[8];
        values = new V[8];
        count = 0;
    }

    public int size() {
        return count;
    }

    public boolean isEmpty() {
        return count == 0;
    }

    private int indexOf(String key) {
        for (int i = 0; i < count; i++) {
            if (keys[i] != null && keys[i].equals(key)) {
                return i;
            }
        }
        return -1;
    }

    public boolean containsKey(String key) {
        return indexOf(key) >= 0;
    }

    public void put(String key, V value) {
        int idx = indexOf(key);
        if (idx >= 0) {
            values[idx] = value;
            return;
        }
        if (count >= keys.length) {
            int newCap = keys.length * 2;
            String[] nk = new String[newCap];
            V[] nv = new V[newCap];
            for (int i = 0; i < count; i++) {
                nk[i] = keys[i];
                nv[i] = values[i];
            }
            keys = nk;
            values = nv;
        }
        keys[count] = key;
        values[count] = value;
        count++;
    }

    public V get(String key) {
        int idx = indexOf(key);
        if (idx < 0) {
            throw new Exception("Key not found in StringMap: " + key);
        }
        return values[idx];
    }

    public V remove(String key) {
        int idx = indexOf(key);
        if (idx < 0) {
            throw new Exception("Key not found in StringMap: " + key);
        }
        V val = values[idx];
        int last = count - 1;
        if (idx != last) {
            keys[idx] = keys[last];
            values[idx] = values[last];
        }
        keys[last] = null;
        values[last] = default(V);
        count--;
        return val;
    }
}
