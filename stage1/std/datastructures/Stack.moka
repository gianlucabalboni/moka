import std/datastructures/ArrayDeque;
import std/datastructures/Iterator;

/**
 * LIFO stack wrapper backed by ArrayDeque<E>.
 *
 * - Null policy: same as ArrayDeque<E> (null allowed for reference types).
 * - Thread safety: NOT thread-safe.
 */
public class Stack<E> {
    private ArrayDeque<E> deque;

    /** Complexity: O(1). */
    public Stack() {
        this.deque = new ArrayDeque<E>();
    }

    /** Complexity: O(1). */
    public int size() {
        return this.deque.size();
    }

    /** Complexity: O(1). */
    public boolean isEmpty() {
        return this.deque.isEmpty();
    }

    /** Pushes an element onto the top of this stack. Complexity: O(1) amortized. */
    public void push(E item) {
        this.deque.push(item);
    }

    /**
     * Removes and returns the top element of this stack.
     * Throws NoSuchElementException if the stack is empty.
     * Complexity: O(1).
     */
    public E pop() {
        return this.deque.pop();
    }

    /**
     * Returns the top element without removing it.
     * Throws NoSuchElementException if the stack is empty.
     * Complexity: O(1).
     */
    public E peek() {
        return this.deque.getFirst();
    }

    /** Removes all elements from this stack. Complexity: O(n). */
    public void clear() {
        this.deque.clear();
    }

    /** Returns an iterator from top to bottom. Complexity: O(1). */
    public Iterator<E> iterator() {
        return this.deque.iterator();
    }

    /** Returns a string representation from top to bottom. Complexity: O(n). */
    public String toString() {
        return this.deque.toString();
    }
}
