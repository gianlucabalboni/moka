public class Stack<T> {
    private T[] items;
    private int count;

    public Stack() {
        this.items = new T[8];
        this.count = 0;
    }

    public int size() {
        return this.count;
    }

    public boolean isEmpty() {
        return this.count == 0;
    }

    public void push(T item) {
        if (this.count >= this.items.length) {
            T[] next = new T[this.items.length * 2];
            for (int i = 0; i < this.count; i++) {
                next[i] = this.items[i];
            }
            this.items = next;
        }
        this.items[this.count] = item;
        this.count++;
    }

    public T pop() {
        if (this.count == 0) {
            throw new Exception("Stack underflow");
        }
        this.count--;
        T val = this.items[this.count];
        this.items[this.count] = default(T);
        return val;
    }

    public T peek() {
        if (this.count == 0) {
            throw new Exception("Stack is empty");
        }
        return this.items[this.count - 1];
    }
}
