import std/datastructures/List;

public class ArrayList<T> implements List<T> {
    private T[] items;
    private int count;

    public ArrayList() {
        items = new T[8];
        count = 0;
    }

    public int size() {
        return count;
    }

    public boolean isEmpty() {
        return count == 0;
    }

    public void add(T item) {
        if (count >= items.length) {
            T[] next = new T[items.length * 2];
            for (int i = 0; i < count; i++) {
                next[i] = items[i];
            }
            items = next;
        }
        items[count] = item;
        count++;
    }

    public T get(int index) {
        if (index < 0 || index >= count) {
            throw new Exception("ArrayList index out of bounds: " + index);
        }
        return items[index];
    }

    public void set(int index, T item) {
        if (index < 0 || index >= count) {
            throw new Exception("ArrayList index out of bounds: " + index);
        }
        items[index] = item;
    }

    public T removeAt(int index) {
        if (index < 0 || index >= count) {
            throw new Exception("ArrayList index out of bounds: " + index);
        }
        T val = items[index];
        for (int i = index; i < count - 1; i++) {
            items[i] = items[i + 1];
        }
        count--;
        items[count] = default(T);
        return val;
    }

    public void clear() {
        items = new T[8];
        count = 0;
    }
}
