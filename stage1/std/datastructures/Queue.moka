import std/datastructures/Collection;

/**
 * A collection designed for holding elements prior to processing (typically FIFO).
 *
 * Follows java.util.Queue semantics:
 * - Throwing methods: add(E), remove(), element()
 * - Special-value methods: offer(E), poll(), peek()
 */
public interface Queue<E> extends Collection<E> {
    /**
     * Inserts the specified element into this queue if possible.
     * Returns true on success, false if capacity-restricted.
     */
    boolean offer(E elem);

    /**
     * Retrieves and removes the head of this queue.
     * Throws NoSuchElementException if this queue is empty.
     */
    E remove();

    /**
     * Retrieves and removes the head of this queue, or returns default(E) if empty.
     */
    E poll();

    /**
     * Retrieves, but does not remove, the head of this queue.
     * Throws NoSuchElementException if this queue is empty.
     */
    E element();

    /**
     * Retrieves, but does not remove, the head of this queue, or returns default(E) if empty.
     */
    E peek();
}
