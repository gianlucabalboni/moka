public class Queue<T> {
    private T[] items;
    private int head;
    private int tail;
    private int count;

    public Queue() {
        items = new T[8];
        head = 0;
        tail = 0;
        count = 0;
    }

    public int size() {
        return count;
    }

    public boolean isEmpty() {
        return count == 0;
    }

    public void enqueue(T item) {
        if (count >= items.length) {
            int newCap = items.length * 2;
            T[] next = new T[newCap];
            for (int i = 0; i < count; i++) {
                next[i] = items[(head + i) % items.length];
            }
            items = next;
            head = 0;
            tail = count;
        }
        items[tail] = item;
        tail = (tail + 1) % items.length;
        count++;
    }

    public T dequeue() {
        if (count == 0) {
            throw new Exception("Queue underflow");
        }
        T val = items[head];
        items[head] = default(T);
        head = (head + 1) % items.length;
        count--;
        return val;
    }

    public T peek() {
        if (count == 0) {
            throw new Exception("Queue is empty");
        }
        return items[head];
    }
}
