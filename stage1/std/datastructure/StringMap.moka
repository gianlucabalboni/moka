public class StringMap<V> {
    private String[] keys;
    private V[] values;
    private int count;

    public StringMap() {
        this.keys = new String[8];
        this.values = new V[8];
        this.count = 0;
    }

    public int size() {
        return this.count;
    }

    public boolean isEmpty() {
        return this.count == 0;
    }

    private int indexOf(String key) {
        for (int i = 0; i < this.count; i++) {
            if (this.keys[i] != null && this.keys[i].equals(key)) {
                return i;
            }
        }
        return -1;
    }

    public boolean containsKey(String key) {
        return this.indexOf(key) >= 0;
    }

    public void put(String key, V value) {
        int idx = this.indexOf(key);
        if (idx >= 0) {
            this.values[idx] = value;
            return;
        }
        if (this.count >= this.keys.length) {
            int newCap = this.keys.length * 2;
            String[] nk = new String[newCap];
            V[] nv = new V[newCap];
            for (int i = 0; i < this.count; i++) {
                nk[i] = this.keys[i];
                nv[i] = this.values[i];
            }
            this.keys = nk;
            this.values = nv;
        }
        this.keys[this.count] = key;
        this.values[this.count] = value;
        this.count++;
    }

    public V get(String key) {
        int idx = this.indexOf(key);
        if (idx < 0) {
            throw new Exception("Key not found in StringMap: " + key);
        }
        return this.values[idx];
    }

    public V remove(String key) {
        int idx = this.indexOf(key);
        if (idx < 0) {
            throw new Exception("Key not found in StringMap: " + key);
        }
        V val = this.values[idx];
        int last = this.count - 1;
        this.keys[idx] = this.keys[last];
        this.values[idx] = this.values[last];
        V[] zv = new V[1];
        this.keys[last] = null;
        this.values[last] = zv[0];
        this.count--;
        return val;
    }
}
