{
  "name": "moka-lang",
  "displayName": "Moka Language Support",
  "description": "Syntax highlighting and language configuration for the Moka programming language (.moka).",
  "version": "0.1.0",
  "publisher": "moka-lang",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "moka",
        "aliases": [
          "Moka",
          "moka"
        ],
        "extensions": [
          ".moka"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "moka",
        "scopeName": "source.moka",
        "path": "./syntaxes/moka.tmLanguage.json"
      }
    ]
  }
}
