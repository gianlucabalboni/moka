import std/datastructures/ArrayList;

class Main {
    public static int main() {
        ArrayList<int> list = new ArrayList<>();
        int n = 1000000;
        for (int i = 0; i < n; i++) {
            list.add(i);
        }
        long sum = 0L;
        for (int i = 0; i < n; i++) {
            sum += list.get(i);
        }
        Console.println("sum=" + sum);
        return 0;
    }
}
